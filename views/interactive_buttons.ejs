                            <div id="editImagePreview" class="mb-2 d-flex flex-wrap gap-2" style="display:none;">
                            </div>
                            <input type="file" name="responseImageFile" class="form-control" accept="image/*,video/*" multiple>
                            <div class="form-text">يمكنك رفع صور أو فيديو (MP4) وسيتم ضغطه وتحسينه تلقائياً لسرعة الإرسال على الواتساب.</div>
                            <input type="hidden" name="responseImage" id="editImage">
                        </div>
                        <div class="row mb-4">
                            <!-- <div class="col-md-6 mb-3 mb-md-0">
                                <label class="form-label fw-bold text-dark">المنصة</label>
                                <select name="platform" id="editPlatform" class="form-select">
                                    <option value="both">📱 واتساب + ماسنجر</option>
