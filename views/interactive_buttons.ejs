<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>القوائم والأزرار التفاعلية</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="/style.css?v=<%= Date.now() %>" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<style>
    .main-content {
        margin-right: 110px;
        width: calc(100% - 110px);
        padding-top: 100px;
        padding-bottom: 50px;
        transition: all 0.5s ease;
    }
    .menu-card {
        background: var(--card-bg, #ffffff);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    }
    .menu-header {
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
        padding-bottom: 16px;
        margin-bottom: 16px;
    }
    .btn-card {
        background: rgba(0, 0, 0, 0.01);
        border: 1px solid rgba(0, 0, 0, 0.06);
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 12px;
        transition: all 0.3s ease;
        position: relative;
    }
    .btn-card:hover {
        border-color: var(--primary-color);
        background: rgba(212, 175, 55, 0.03);
        transform: translateY(-2px);
    }
    .btn-card.inactive {
        opacity: 0.5;
    }
    .btn-order-badge {
        background: rgba(212, 175, 55, 0.1);
        color: var(--primary-hover);
        border: 1px solid rgba(212, 175, 55, 0.2);
        padding: 2px 8px;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 700;
    }
    .btn-label {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-color);
    }
    .btn-response-preview {
        color: var(--text-secondary);
        font-size: 13px;
        line-height: 1.5;
        max-height: 75px;
        overflow: hidden;
        white-space: pre-wrap;
        word-break: break-word;
    }
    .btn-meta {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin-top: 10px;
    }
    .btn-meta-tag {
        font-size: 11px;
        padding: 3px 10px;
        border-radius: 20px;
        font-weight: 500;
    }
    .tag-platform-both { background: rgba(22, 163, 74, 0.1); color: #16a34a; border: 1px solid rgba(22, 163, 74, 0.2); }
    .tag-platform-whatsapp { background: #25D36622; color: #25D366; border: 1px solid #25D36644; }
    .tag-platform-messenger { background: #006AFF22; color: #4F9AFF; border: 1px solid #006AFF44; }
    .tag-ai-yes { background: rgba(245, 158, 11, 0.1); color: #d97706; border: 1px solid rgba(245, 158, 11, 0.2); }
    .tag-ai-no { background: rgba(99, 102, 241, 0.1); color: #4f46e5; border: 1px solid rgba(99, 102, 241, 0.2); }
    
    .trigger-words-box {
        background: rgba(0, 0, 0, 0.02);
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 13px;
        color: var(--text-color);
        margin-top: 8px;
        border: 1px solid rgba(0, 0, 0, 0.04);
        word-break: break-word;
    }
    .trigger-badge {
        background: rgba(212, 175, 55, 0.1);
        color: var(--primary-hover);
        padding: 2px 8px;
        border-radius: 12px;
        margin-left: 4px;
        margin-bottom: 4px;
        display: inline-block;
        font-size: 11.5px;
    }

    @media (max-width: 992px) {
        .main-content {
            margin-right: 0 !important;
            width: 100% !important;
            padding-top: 76px !important;
            padding-bottom: 30px !important;
            padding-left: 10px !important;
            padding-right: 10px !important;
            overflow-x: hidden;
        }
        .glass-card {
            padding: 16px 12px !important;
            border-radius: 14px !important;
        }
        .menu-card {
            padding: 16px 12px !important;
            border-radius: 14px !important;
            margin-bottom: 16px !important;
        }
        .btn-card {
            padding: 14px 12px !important;
            margin-bottom: 10px !important;
        }
        .btn-label {
            font-size: 14px !important;
        }
        .btn-response-preview {
            font-size: 12.5px !important;
        }
    }
</style>
</head>

<body>
    <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

    <div class="container-fluid main-content px-2 px-md-4 px-lg-5">
        <div class="glass-card p-3 p-md-5 animate-fade-in">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
                <h2 class="m-0 fw-bold d-flex align-items-center gap-2 text-dark fs-4 fs-md-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="var(--primary-color)" viewBox="0 0 16 16">
                        <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2zm2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H4z"/>
                        <path d="M5 4h6a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5H5a.5.5 0 0 1-.5-.5v-1A.5.5 0 0 1 5 4zm0 3h6a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5H5a.5.5 0 0 1-.5-.5v-1A.5.5 0 0 1 5 7zm0 3h6a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5H5a.5.5 0 0 1-.5-.5v-1A.5.5 0 0 1 5 10z"/>
                    </svg>
                    القوائم والأزرار
                </h2>
                <button class="btn btn-primary px-3 px-md-4 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#addMenuModal">
                    <i class="bi bi-folder-plus me-1"></i>
                    إنشاء قائمة جديدة
                </button>
            </div>

            <!-- 🤖 Bot Mode Selector -->
            <div class="mb-4 p-3 p-md-4 rounded-4" style="background: rgba(0, 0, 0, 0.01); border: 1px solid rgba(0, 0, 0, 0.05);">
                <h5 class="text-dark fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-robot text-primary"></i> وضع تشغيل البوت
                </h5>
                
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="bot-mode-card <%= botMode === 'hybrid' ? 'active' : '' %>" onclick="setBotMode('hybrid')" id="mode-hybrid" style="cursor: pointer; padding: 15px; border-radius: 12px; border: 2px solid <%= botMode === 'hybrid' ? '#6366f1' : 'rgba(0,0,0,0.06)' %>; background: <%= botMode === 'hybrid' ? 'rgba(99, 102, 241, 0.05)' : 'transparent' %>; transition: all 0.3s ease; height: 100%;">
                            <div class="d-flex justify-content-between mb-2">
                                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-shuffle text-primary me-1"></i> الوضع المتكامل</h6>
                                <% if (botMode === 'hybrid') { %><i class="bi bi-check-circle-fill text-primary"></i><% } %>
                            </div>
                            <p class="text-secondary small mb-0">أزرار + ذكاء اصطناعي. (موصى به) البوت يبدأ بالقوائم، وإذا كتب العميل رسالة حرة يرد الذكاء الاصطناعي.</p>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="bot-mode-card <%= botMode === 'menu_only' ? 'active' : '' %>" onclick="setBotMode('menu_only')" id="mode-menu_only" style="cursor: pointer; padding: 15px; border-radius: 12px; border: 2px solid <%= botMode === 'menu_only' ? '#22c55e' : 'rgba(0,0,0,0.06)' %>; background: <%= botMode === 'menu_only' ? 'rgba(34, 197, 94, 0.05)' : 'transparent' %>; transition: all 0.3s ease; height: 100%;">
                            <div class="d-flex justify-content-between mb-2">
                                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-list-ul text-success me-1"></i> قوائم فقط</h6>
                                <% if (botMode === 'menu_only') { %><i class="bi bi-check-circle-fill text-success"></i><% } %>
                            </div>
                            <p class="text-secondary small mb-0">أزرار فقط. لا يوجد ذكاء اصطناعي. إذا كتب العميل رسالة حرة يُطلب منه اختيار رقم من القائمة.</p>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="bot-mode-card <%= botMode === 'ai_only' ? 'active' : '' %>" onclick="setBotMode('ai_only')" id="mode-ai_only" style="cursor: pointer; padding: 15px; border-radius: 12px; border: 2px solid <%= botMode === 'ai_only' ? '#f59e0b' : 'rgba(0,0,0,0.06)' %>; background: <%= botMode === 'ai_only' ? 'rgba(245, 158, 11, 0.05)' : 'transparent' %>; transition: all 0.3s ease; height: 100%;">
                            <div class="d-flex justify-content-between mb-2">
                                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-cpu text-warning me-1"></i> الوضع المفتوح</h6>
                                <% if (botMode === 'ai_only') { %><i class="bi bi-check-circle-fill text-warning"></i><% } %>
                            </div>
                            <p class="text-secondary small mb-0">ذكاء اصطناعي فقط. لا يتم إرسال أزرار. البوت يتعامل كمندوب مبيعات مفتوح بناءً على التعليمات.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 🚫 Disable Buttons Option -->
            <div class="mb-4 p-4 rounded-4" style="background: rgba(0, 0, 0, 0.01); border: 1px solid rgba(0, 0, 0, 0.05);">
                <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap flex-md-nowrap">
                    <div>
                        <h5 class="text-dark fw-bold mb-1">
                            <i class="bi bi-toggle-off text-danger me-1"></i> تعطيل ردود الأزرار بالكامل
                        </h5>
                        <p class="text-secondary small mb-0">عند تفعيل هذا الخيار، لن يقوم البوت بالرد على العملاء بأي قوائم أو أزرار تفاعلية نهائياً، وسيعمل بالردود النصية المعتادة.</p>
                    </div>
                    <div class="form-check form-switch m-0 flex-shrink-0" dir="ltr" style="padding: 0;">
                        <input class="form-check-input m-0" type="checkbox" role="switch" id="disable-buttons-toggle" onchange="toggleDisableAllButtons(this.checked)" <%= buttonsDisabled ? 'checked' : '' %> style="cursor: pointer; width: 3em; height: 1.5em; float: none;">
                    </div>
                </div>
            </div>

            <div class="mb-4 p-3 rounded-3" style="background: rgba(212, 175, 55, 0.06); border: 1px solid rgba(212, 175, 55, 0.15);">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-info-circle-fill text-primary mt-1"></i>
                    <div class="text-secondary small">
                        يمكنك الآن إنشاء <strong>قوائم متعددة</strong>، كل قائمة تعمل بكلمات مفتاحية مختلفة.<br>
                        العميل بمجرد أن يكتب أي كلمة من "كلمات التشغيل"، سيقوم البوت بإرسال الأزرار التابعة لهذه القائمة فقط.
                    </div>
                </div>
            </div>

            <div class="row justify-content-center">
                <div class="col-lg-10 col-xl-9">
                    <% if (!menus || menus.length === 0) { %>
                        <div class="text-center py-5" style="background: rgba(255,255,255,0.02); border-radius: 16px; border: 1px dashed rgba(255,255,255,0.1);">
                            <div class="mb-3">
                                <i class="bi bi-ui-radios-grid text-primary opacity-50" style="font-size: 48px;"></i>
                            </div>
                            <h4 class="text-secondary fw-bold">لا توجد قوائم حالياً</h4>
                            <p class="text-secondary mb-3">قم بإنشاء أول قائمة وحدد كلمات التشغيل الخاصة بها.</p>
                            <button class="btn btn-outline-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addMenuModal">
                                <i class="bi bi-folder-plus me-1"></i> إنشاء قائمة
                            </button>
                        </div>
                    <% } else { %>
                        <% menus.forEach((menu) => { %>
                            <div class="menu-card">
                                <!-- Menu Header -->
                                <div class="menu-header">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                                        <h5 class="text-dark fw-bold m-0 d-flex align-items-center gap-2 flex-wrap">
                                            <span><i class="bi bi-menu-button-wide text-primary me-1"></i> <%= menu.menuName %></span>
                                            <% if (menu.isDefault) { %>
                                                <span class="badge bg-warning text-dark" style="font-size: 11px;"><i class="bi bi-star-fill me-1"></i> القائمة الرئيسية</span>
                                            <% } %>
                                        </h5>
                                        <div class="d-flex gap-1 align-items-center">
                                            <% if (!menu.isDefault) { %>
                                                <form action="/dashboard/menus/set-default" method="POST" class="m-0">
                                                    <input type="hidden" name="id" value="<%= menu.id %>">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning rounded px-2 py-1" title="تعيين كقائمة رئيسية">
                                                        <i class="bi bi-star"></i>
                                                    </button>
                                                </form>
                                            <% } %>
                                            <button class="btn btn-sm btn-outline-info rounded px-2 py-1"
                                                onclick="editMenu('<%= menu.id %>', '<%= encodeURIComponent(menu.menuName) %>', '<%= encodeURIComponent(menu.triggerWords) %>', '<%= encodeURIComponent(menu.welcomeMessage || '') %>')" title="تعديل القائمة">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form action="/dashboard/menus/delete" method="POST" class="m-0" onsubmit="return confirm('حذف القائمة سيؤدي لحذف كل الأزرار بداخلها! متأكد؟')">
                                                <input type="hidden" name="id" value="<%= menu.id %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded px-2 py-1" title="حذف القائمة">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                    <div class="trigger-words-box">
                                        <strong>كلمات التشغيل:</strong>
                                        <% menu.triggerWords.split(',').forEach(w => { %>
                                            <span class="trigger-badge"><%= w.trim() %></span>
                                        <% }) %>
                                    </div>
                                </div>

                                <!-- Add Button to this menu -->
                                <div class="mb-3">
                                    <button class="btn btn-sm btn-outline-success rounded-pill px-3" onclick="openAddButtonModal('<%= menu.id %>')">
                                        <i class="bi bi-plus-circle me-1"></i> إضافة زرار لهذه القائمة
                                    </button>
                                </div>

                                <!-- Buttons List -->
                                <div class="row g-3">
                                    <% if(menu.InteractiveButtons && menu.InteractiveButtons.length > 0) { %>
                                        <% menu.InteractiveButtons.forEach((btn, idx) => { %>
                                            <div class="col-12 col-md-6">
                                                <div class="btn-card <%= btn.isActive ? '' : 'inactive' %>">
                                                    <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
                                                        <div class="d-flex align-items-center gap-2 min-w-0 flex-grow-1">
                                                            <span class="btn-order-badge flex-shrink-0">#<%= idx + 1 %></span>
                                                            <span class="btn-label m-0 text-truncate"><%= btn.label %></span>
                                                        </div>
                                                        <div class="d-flex align-items-center gap-1.5 flex-shrink-0">
                                                            <form action="/dashboard/buttons/toggle/<%= btn.id %>" method="POST" class="m-0 d-flex align-items-center">
                                                                <div class="form-check form-switch m-0" style="padding-left: 0;">
                                                                    <input class="form-check-input m-0" type="checkbox" onchange="this.form.submit()" <%= btn.isActive ? 'checked' : '' %> style="cursor: pointer; width: 2em; height: 1em;" title="تفعيل / تعطيل">
                                                                </div>
                                                            </form>
                                                            <button class="btn btn-sm btn-outline-info rounded p-1 px-2"
                                                                onclick="editButton(this)"
                                                                data-id="<%= btn.id %>"
                                                                data-label="<%= encodeURIComponent(btn.label || '') %>"
                                                                data-response="<%= encodeURIComponent(btn.responseText || '') %>"
                                                                data-image="<%= encodeURIComponent(btn.responseImage || '') %>"
                                                                data-platform="<%= btn.platform %>"
                                                                data-continue="<%= btn.continueToAI %>"
                                                                data-nextmenu="<%= btn.NextMenuId || '' %>"
                                                                data-product="<%= btn.ProductId || '' %>"
                                                                data-order="<%= btn.order %>"
                                                                title="تعديل">
                                                                <i class="bi bi-pencil-square"></i>
                                                            </button>
                                                            <form action="/dashboard/buttons/delete" method="POST" class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذا الزرار؟')">
                                                                <input type="hidden" name="id" value="<%= btn.id %>">
                                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded p-1 px-2" title="حذف">
                                                                    <i class="bi bi-trash3"></i>
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                    
                                                    <div class="btn-response-preview mb-2"><%= btn.responseText %></div>
                                                    
                                                    <div class="btn-meta">
                                                        <span class="btn-meta-tag tag-platform-<%= btn.platform %> d-none">
                                                            <% if (btn.platform === 'both') { %>📱 واتساب + ماسنجر
                                                            <% } else if (btn.platform === 'whatsapp') { %>📱 واتساب فقط
                                                            <% } else { %>💬 ماسنجر فقط<% } %>
                                                        </span>
                                                        <% if (btn.NextMenuId) { %>
                                                            <span class="btn-meta-tag tag-ai-no">🔀 يفتح قائمة أخرى</span>
                                                        <% } else if (btn.continueToAI) { %>
                                                            <span class="btn-meta-tag tag-ai-yes">🤖 يكمل مع الذكاء الاصطناعي / المبيعات</span>
                                                        <% } else { %>
                                                            <span class="btn-meta-tag tag-ai-no">🔄 يرجع لنفس القائمة</span>
                                                        <% } %>
                                                        <% if (btn.responseImage) { %>
                                                            <% if (btn.responseImage.match(/\.(mp4|mov|webm|mkv|avi|3gp)/i)) { %>
                                                                <span class="btn-meta-tag tag-platform-whatsapp">🎥 فيديو</span>
                                                            <% } else { %>
                                                                <span class="btn-meta-tag tag-platform-whatsapp">📷 صور</span>
                                                            <% } %>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <div class="col-12 text-center text-muted small py-3">لا توجد أزرار في هذه القائمة بعد.</div>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Menu Modal -->
    <div class="modal fade" id="addMenuModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card">
                <div class="modal-header">
                    <h5 class="modal-title text-dark fw-bold">📁 إنشاء قائمة جديدة</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/dashboard/menus/add" method="POST">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">اسم القائمة</label>
                            <input type="text" name="menuName" class="form-control" required placeholder="مثال: قائمة المبيعات">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">كلمات التشغيل</label>
                            <input type="text" name="triggerWords" class="form-control" required placeholder="اسعار, عروض, بكام">
                            <div class="form-text">افصل بين الكلمات بفاصلة (,)</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">رسالة الترحيب</label>
                            <textarea name="welcomeMessage" id="addMenuWelcomeMessage" class="form-control" placeholder="أهلاً بيك! اختار من الاختيارات دي:" style="resize: none; overflow-y: hidden; min-height: 38px;"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary">حفظ القائمة</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Menu Modal -->
    <div class="modal fade" id="editMenuModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card">
                <div class="modal-header">
                    <h5 class="modal-title text-dark fw-bold">✏️ تعديل القائمة</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/dashboard/menus/edit" method="POST">
                    <input type="hidden" name="id" id="editMenuId">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">اسم القائمة</label>
                            <input type="text" name="menuName" id="editMenuName" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">كلمات التشغيل</label>
                            <input type="text" name="triggerWords" id="editMenuTriggerWords" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">رسالة الترحيب</label>
                            <textarea name="welcomeMessage" id="editMenuWelcomeMessage" class="form-control" style="resize: none; overflow-y: hidden; min-height: 38px;"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary">حفظ التعديلات</button>
