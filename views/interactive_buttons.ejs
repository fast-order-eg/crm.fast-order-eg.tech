    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function autoResizeTextarea(textarea) {
            if (!textarea) return;
            textarea.style.height = 'auto';
            textarea.style.height = textarea.scrollHeight + 'px';
        }

        function editMenu(id, name, triggerWords, welcomeMessage) {
            document.getElementById('editMenuId').value = id;
            document.getElementById('editMenuName').value = decodeURIComponent(name);
            document.getElementById('editMenuTriggerWords').value = decodeURIComponent(triggerWords);
            
            const editWelcome = document.getElementById('editMenuWelcomeMessage');
            editWelcome.value = decodeURIComponent(welcomeMessage);
            
            new bootstrap.Modal(document.getElementById('editMenuModal')).show();
        }

        function openAddButtonModal(menuId) {
            document.getElementById('addBtnMenuId').value = menuId;
            new bootstrap.Modal(document.getElementById('addBtnModal')).show();
        }

        function editButton(el) {
            document.getElementById('editBtnId').value = el.dataset.id;
            document.getElementById('editLabel').value = decodeURIComponent(el.dataset.label);
            document.getElementById('editResponse').value = decodeURIComponent(el.dataset.response);
            
            const imagePath = decodeURIComponent(el.dataset.image);
            document.getElementById('editImage').value = imagePath;
            const previewContainer = document.getElementById('editImagePreview');
            previewContainer.innerHTML = '';
            
            if (imagePath && imagePath !== 'null' && imagePath !== '') {
                previewContainer.style.display = 'flex';
                let images = [];
                try {
                    let parsed = JSON.parse(imagePath);
                    if (Array.isArray(parsed)) {
                        images = parsed;
                    } else if (typeof parsed === 'string') {
                        images = parsed.split(',').filter(i => i.trim() !== '');
                    } else {
                        images = [parsed];
                    }
                } catch (e) {
                    images = imagePath.split(',').filter(i => i.trim() !== '');
                }
                
                images.forEach((imgSrc, index) => {
                    if (!imgSrc) return;
                    // Escape single quotes for the onclick handler
                    const safeSrc = imgSrc.replace(/'/g, "\\'");
                    let finalSrc = imgSrc;
                    if (!imgSrc.startsWith('http')) {
                        const filename = imgSrc.split('/').pop();
                        if (filename.startsWith('instruction_')) {
                            finalSrc = '/uploads/instructions/' + filename;
                        } else if (filename.startsWith('vid_')) {
                            finalSrc = '/uploads/videos/' + filename;
                        } else {
                            finalSrc = '/uploads/' + filename;
                        }
                    }
                    const isVid = imgSrc.match(/\.(mp4|mov|webm|mkv|avi|3gp)$/i);
                    const div = document.createElement('div');
                    div.className = 'position-relative';
                    div.innerHTML = `
                        ${isVid ? `<video src="${finalSrc}" class="img-thumbnail rounded" style="width: 100px; height: 100px; object-fit: cover;" muted autoplay loop playsinline></video>` : `<img src="${finalSrc}" class="img-thumbnail rounded" style="width: 100px; height: 100px; object-fit: cover;">`}
                        <button type="button" class="btn btn-danger btn-sm position-absolute top-0 start-0 translate-middle rounded-circle" style="width: 24px; height: 24px; padding: 0; line-height: 1;" onclick="removeEditImage(this, '${safeSrc}')">
                            <i class="bi bi-x"></i>
                        </button>
                    `;
                    previewContainer.appendChild(div);
                });
            } else {
                previewContainer.style.display = 'none';
            }

            // document.getElementById('editPlatform').value = el.dataset.platform;
            document.getElementById('editPlatform').value = 'whatsapp';
            document.getElementById('editProductId').value = el.dataset.product || '';
            
            const continueToAI = el.dataset.continue === 'true';
            const nextMenuId = el.dataset.nextmenu;
            
            if (nextMenuId) {
                document.getElementById('editBtnAction').value = 'next';
                document.getElementById('editNextMenuId').value = nextMenuId;
                document.getElementById('editContinueToAI').value = 'false';
                document.getElementById('editNextMenuDiv').style.display = 'block';
            } else if (continueToAI) {
                document.getElementById('editBtnAction').value = 'ai';
                document.getElementById('editContinueToAI').value = 'true';
                document.getElementById('editNextMenuDiv').style.display = 'none';
                document.getElementById('editNextMenuId').value = '';
            } else {
                document.getElementById('editBtnAction').value = 'same';
                document.getElementById('editContinueToAI').value = 'false';
                document.getElementById('editNextMenuDiv').style.display = 'none';
                document.getElementById('editNextMenuId').value = '';
            }

            document.getElementById('editOrder').value = el.dataset.order;
            new bootstrap.Modal(document.getElementById('editBtnModal')).show();
        }

        function toggleAddNextMenu() {
            const action = document.getElementById('addBtnAction').value;
            if (action === 'next') {
                document.getElementById('addNextMenuDiv').style.display = 'block';
                document.getElementById('addContinueToAI').value = 'false';
                document.getElementById('addNextMenuId').required = true;
            } else {
                document.getElementById('addNextMenuDiv').style.display = 'none';
                document.getElementById('addNextMenuId').required = false;
                document.getElementById('addNextMenuId').value = '';
                document.getElementById('addContinueToAI').value = action === 'ai' ? 'true' : 'false';
            }
        }

        function toggleEditNextMenu() {
            const action = document.getElementById('editBtnAction').value;
            if (action === 'next') {
                document.getElementById('editNextMenuDiv').style.display = 'block';
                document.getElementById('editContinueToAI').value = 'false';
                document.getElementById('editNextMenuId').required = true;
            } else {
                document.getElementById('editNextMenuDiv').style.display = 'none';
                document.getElementById('editNextMenuId').required = false;
                document.getElementById('editNextMenuId').value = '';
                document.getElementById('editContinueToAI').value = action === 'ai' ? 'true' : 'false';
            }
        }

        function removeEditImage(btn, src) {
            const container = btn.closest('div');
            container.remove();
            
            const hiddenInput = document.getElementById('editImage');
            let currentImages = [];
            let isJson = false;
            try {
                let parsed = JSON.parse(hiddenInput.value);
                isJson = true;
                if (Array.isArray(parsed)) {
                    currentImages = parsed;
                } else if (typeof parsed === 'string') {
                    currentImages = parsed.split(',').filter(i => i.trim() !== '');
                    isJson = false;
                } else {
                    currentImages = [parsed];
                }
            } catch (e) {
                currentImages = hiddenInput.value.split(',').filter(i => i.trim() !== '');
            }
            
            currentImages = currentImages.filter(img => img !== src);
            
            if (isJson) {
                hiddenInput.value = JSON.stringify(currentImages);
            } else {
                hiddenInput.value = currentImages.join(',');
            }
            
            if (currentImages.length === 0) {
                document.getElementById('editImagePreview').style.display = 'none';
            }
        }

        // Initialize Add Form on open to sync hidden inputs
        document.getElementById('addBtnModal').addEventListener('show.bs.modal', toggleAddNextMenu);

        // 🤖 Set Bot Mode
        async function setBotMode(mode) {
            try {
                // visual feedback immediately
                document.querySelectorAll('.bot-mode-card').forEach(c => {
                    c.style.borderColor = 'rgba(255,255,255,0.1)';
                    c.style.background = 'transparent';
                    const icon = c.querySelector('.bi-check-circle-fill');
                    if (icon) icon.remove();
                });
                
                const response = await fetch('/dashboard/set-bot-mode', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mode })
                });
                const data = await response.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    alert('حدث خطأ أثناء تغيير الوضع');
                    window.location.reload();
                }
            } catch (err) {
                console.error('Set bot mode error:', err);
                alert('حدث خطأ أثناء تغيير الوضع');
                window.location.reload();
            }
        }

        // 🚫 Toggle Disable All Buttons
        async function toggleDisableAllButtons(disabled) {
            try {
                const response = await fetch('/dashboard/buttons/toggle-disable-all', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ disabled })
                });
                const data = await response.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    alert('حدث خطأ أثناء حفظ الإعدادات');
                    window.location.reload();
                }
            } catch (err) {
                console.error('Toggle disable buttons error:', err);
                alert('حدث خطأ في الاتصال بالسيرفر');
                window.location.reload();
            }
        }

        // Auto-resize for welcome message textareas on input and modal show
        document.addEventListener('DOMContentLoaded', function() {
            // Preview new selected images
            document.querySelectorAll('input[name="responseImageFile"]').forEach(input => {
                input.addEventListener('change', function(e) {
                    const isEdit = this.closest('form').getAttribute('action').includes('edit');
                    let previewContainer;
                    if (isEdit) {
                        previewContainer = document.getElementById('editImagePreview');
                    } else {
                        previewContainer = document.getElementById('addImagePreview');
                        if (!previewContainer) {
                            previewContainer = document.createElement('div');
                            previewContainer.id = 'addImagePreview';
                            previewContainer.className = 'mb-2 d-flex flex-wrap gap-2';
                            this.parentNode.insertBefore(previewContainer, this);
                        }
                    }
                    
                    // Clear existing new previews
                    Array.from(previewContainer.children).forEach(child => {
                        if (child.classList.contains('new-preview')) {
                            child.remove();
                        }
                    });

                    if (this.files && this.files.length > 0) {
                        previewContainer.style.display = 'flex';
                        Array.from(this.files).forEach((file) => {
                            const reader = new FileReader();
                            reader.onload = function(e) {
                                const div = document.createElement('div');
                                div.className = 'position-relative new-preview';
                                if (file.type.startsWith('video/') || file.name.match(/\.(mp4|mov|webm|mkv|avi|3gp)$/i)) {
                                    div.innerHTML = '<video src="' + e.target.result + '" class="img-thumbnail rounded" style="width: 100px; height: 100px; object-fit: cover;" muted autoplay loop playsinline></video>';
                                } else {
                                    div.innerHTML = '<img src="' + e.target.result + '" class="img-thumbnail rounded" style="width: 100px; height: 100px; object-fit: cover;">';
                                }
                                previewContainer.appendChild(div);
                            }
                            reader.readAsDataURL(file);
                        });
                    } else if (previewContainer.children.length === 0) {
                        previewContainer.style.display = 'none';
                    }
                });
            });

            const addWelcome = document.getElementById('addMenuWelcomeMessage');
            const editWelcome = document.getElementById('editMenuWelcomeMessage');
            
            if (addWelcome) {
                addWelcome.addEventListener('input', function() {
                    autoResizeTextarea(this);
                });
            }
            if (editWelcome) {
                editWelcome.addEventListener('input', function() {
                    autoResizeTextarea(this);
                });
            }
            
            const addModalEl = document.getElementById('addMenuModal');
            if (addModalEl) {
                addModalEl.addEventListener('shown.bs.modal', function () {
                    autoResizeTextarea(addWelcome);
                });
            }
            
            const editModalEl = document.getElementById('editMenuModal');
            if (editModalEl) {
                editModalEl.addEventListener('shown.bs.modal', function () {
                    autoResizeTextarea(editWelcome);
                });
            }

            // Handle button form submission loading states
            const addForm = document.querySelector('form[action="/dashboard/buttons/add"]');
            if (addForm) {
                addForm.addEventListener('submit', function() {
                    const submitBtn = document.getElementById('addBtnSubmit');
                    const notice = document.getElementById('addLoadingNotice');
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> جاري الحفظ والرفع...';
                    }
                    if (notice) notice.style.display = 'block';
                });
            }

            const editForm = document.querySelector('form[action="/dashboard/buttons/edit"]');
            if (editForm) {
                editForm.addEventListener('submit', function() {
                    const submitBtn = document.getElementById('editBtnSubmit');
                    const notice = document.getElementById('editLoadingNotice');
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> جاري الحفظ والرفع...';
                    }
                    if (notice) notice.style.display = 'block';
                });
            }
        });
    </script>
</body>
