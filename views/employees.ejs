                                    <td>
                                        <div class="fw-bold text-dark"><%= emp.fullName || '—' %></div>
                                    </td>
                                    <td>
                                        <code class="text-primary"><%= emp.username %></code>
                                    </td>
                                    <td>
                                        <span class="text-secondary"><%= emp.phone || '—' %></span>
                                    </td>
                                    <td>
                                        <% if (emp.role === 'super_admin') { %>
                                            <span class="badge bg-danger rounded-pill">Super Admin</span>
                                        <% } else if (emp.role === 'admin') { %>
                                            <span class="badge bg-warning text-dark rounded-pill">Admin</span>
                                        <% } else { %>
                                            <span class="badge bg-info text-white rounded-pill">Sales</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (emp.substituteUser) { %>
                                            <span class="text-dark fw-semibold small"><%= emp.substituteUser.fullName %></span>
                                        <% } else { %>
                                            <span class="text-muted small">—</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border border-secondary border-opacity-10 px-3 py-1 rounded">
                                            <%= emp.customerCount || 0 %>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <form action="/dashboard/employees/toggle-leave/<%= emp.id %>" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm <%= emp.isOnLeave ? 'btn-danger' : 'btn-success' %> rounded-pill px-3 py-1 fw-bold text-white d-inline-flex align-items-center gap-1" style="font-size: 12px;">
                                                <i class="bi <%= emp.isOnLeave ? 'bi-moon-fill' : 'bi-sun-fill' %>"></i>
                                                <%= emp.isOnLeave ? 'إجازة' : 'نشط' %>
                                            </button>
                                        </form>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center align-items-center gap-2">
                                            <button class="btn btn-sm btn-outline-primary rounded px-2" 
                                                    onclick="editEmployee(this)"
                                                    data-id="<%= emp.id %>"
                                                    data-fullname="<%= emp.fullName || '' %>"
                                                    data-username="<%= emp.username %>"
                                                    data-phone="<%= emp.phone || '' %>"
                                                    data-role="<%= emp.role %>"
                                                    data-substitute="<%= emp.substituteUserId || '' %>"
                                                    data-max="<%= emp.maxCustomers %>"
                                                    title="تعديل">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            
                                            <% if (emp.role !== 'super_admin') { %>
                                                <form action="/dashboard/employees/delete" method="POST" class="m-0 d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا الموظف؟ سيتم نقل عملائه للموظف البديل أو تصنيفهم كغير مخصصين.')">
                                                    <input type="hidden" name="id" value="<%= emp.id %>">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded px-2" title="حذف">
                                                        <i class="bi bi-trash3"></i>
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div class="d-block d-lg-none">
                    <% employees.forEach(emp => { 
                        const initial = (emp.fullName && emp.fullName.trim()) ? emp.fullName.trim()[0] : (emp.username ? emp.username[0].toUpperCase() : '؟');
                        let avatarBg = '#e0e7ff';
                        let avatarColor = '#3730a3';
                        let roleTitle = 'موظف مبيعات (Sales)';
                        let roleBadgeClass = 'emp-badge-sales';

                        if (emp.role === 'super_admin') {
                            avatarBg = '#fee2e2';
                            avatarColor = '#991b1b';
                            roleTitle = 'مدير عام (Super Admin)';
                            roleBadgeClass = 'emp-badge-superadmin';
                        } else if (emp.role === 'admin') {
                            avatarBg = '#fef3c7';
                            avatarColor = '#92400e';
                            roleTitle = 'مشرف (Admin)';
                            roleBadgeClass = 'emp-badge-admin';
                        }
                    %>
                        <div class="employee-card-mobile shadow-sm">
                            <!-- Card Header: Avatar, Name, Username & Role -->
