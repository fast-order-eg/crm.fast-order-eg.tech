                                <div class="d-flex align-items-center gap-2 min-w-0">
                                    <div class="emp-avatar-wrapper flex-shrink-0">
                                        <div class="emp-avatar shadow-xs" style="background-color: <%= avatarBg %>; color: <%= avatarColor %>;">
                                            <%= initial %>
                                        </div>
                                        <span class="emp-status-dot <%= emp.isOnLeave ? 'leave' : 'active' %>" title="<%= emp.isOnLeave ? 'في إجازة' : 'نشط' %>"></span>
                                    </div>
                                    <div class="min-w-0">
                                        <h5 class="fw-bold text-dark mb-0 text-truncate" style="font-size: 15px;"><%= emp.fullName || '—' %></h5>
                                        <div class="d-flex align-items-center gap-1.5 flex-wrap mt-0.5">
                                            <span class="badge bg-light text-secondary border px-2 py-0.5 font-monospace" style="font-size: 10.5px; font-weight: 500;">
                                                <i class="bi bi-person-fill text-muted me-0.5"></i>@<%= emp.username %>
                                            </span>
                                            <% if (emp.isOnLeave) { %>
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-1.5 py-0.5" style="font-size: 9.5px;">إجازة</span>
                                            <% } else { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-1.5 py-0.5" style="font-size: 9.5px;">نشط</span>
                                            <% } %>
