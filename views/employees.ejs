<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة الموظفين - Bird-CRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="/style.css?v=<%= Date.now() %>" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        .employee-badge {
            font-size: 11px;
            padding: 4px 8px;
            border-radius: 50px;
            font-weight: 600;
        }
        .day-badge {
            font-size: 10.5px;
            padding: 2px 7px;
            background: #f1f5f9;
            color: #334155;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            display: inline-block;
            margin: 2px;
            font-weight: 500;
        }
        
        /* Modern Mobile Card Styles */
        .employee-card-mobile {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 1.15rem;
            margin-bottom: 1rem;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
            transition: all 0.25s ease;
            position: relative;
        }
        .employee-card-mobile:hover {
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
            border-color: #cbd5e1;
        }
        
        .emp-avatar-wrapper {
            position: relative;
            width: 46px;
            height: 46px;
            min-width: 46px;
        }
        .emp-avatar {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            font-weight: 700;
        }
        .emp-status-dot {
            position: absolute;
            bottom: 0;
            right: 0;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            border: 2px solid #ffffff;
        }
        .emp-status-dot.active {
            background-color: #10b981;
        }
        .emp-status-dot.leave {
            background-color: #ef4444;
        }

        /* Role Badges */
        .emp-badge-sales {
            background: #eef2ff;
            color: #4338ca !important;
            border: 1px solid #c7d2fe;
            font-size: 11px;
            padding: 3px 10px;
            border-radius: 50px;
            font-weight: 600;
        }
        .emp-badge-admin {
            background: #fffbeb;
            color: #b45309 !important;
            border: 1px solid #fde68a;
            font-size: 11px;
            padding: 3px 10px;
            border-radius: 50px;
            font-weight: 600;
        }
        .emp-badge-superadmin {
            background: #fef2f2;
            color: #b91c1c !important;
            border: 1px solid #fecaca;
            font-size: 11px;
            padding: 3px 10px;
            border-radius: 50px;
            font-weight: 600;
        }

        /* Info Tiles */
        .emp-info-tile {
            background: #f8fafc;
            border: 1px solid #edf2f7;
            border-radius: 10px;
            padding: 8px 10px;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* Modern Mobile Action Buttons */
        .btn-status-active {
            background-color: #ecfdf5;
            color: #047857 !important;
            border: 1px solid #a7f3d0;
            font-size: 12px;
            height: 38px;
            transition: all 0.2s;
        }
        .btn-status-active:hover, .btn-status-active:active {
            background-color: #10b981;
            color: #ffffff !important;
            border-color: #10b981;
        }

        .btn-status-leave {
            background-color: #fef2f2;
            color: #b91c1c !important;
            border: 1px solid #fecaca;
            font-size: 12px;
            height: 38px;
            transition: all 0.2s;
        }
        .btn-status-leave:hover, .btn-status-leave:active {
            background-color: #ef4444;
            color: #ffffff !important;
            border-color: #ef4444;
        }

        .btn-edit-emp {
            background-color: #eff6ff;
            color: #1d4ed8 !important;
            border: 1px solid #bfdbfe;
            font-size: 12px;
            height: 38px;
            transition: all 0.2s;
        }
        .btn-edit-emp:hover, .btn-edit-emp:active {
            background-color: #2563eb;
            color: #ffffff !important;
            border-color: #2563eb;
        }

        .btn-delete-emp {
            background-color: #ffffff;
            color: #dc2626 !important;
            border: 1px solid #fca5a5;
            height: 38px;
            width: 38px;
            min-width: 38px;
            padding: 0;
            font-size: 14px;
            border-radius: 10px;
            transition: all 0.2s;
        }
        .btn-delete-emp:hover, .btn-delete-emp:active {
            background-color: #dc2626;
            color: #ffffff !important;
            border-color: #dc2626;
        }

        /* Day Check Pills in Modals */
        .day-select-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            background: #ffffff;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            user-select: none;
            transition: all 0.15s ease-in-out;
        }
        .day-select-pill:hover {
            background: #f8fafc;
            border-color: #94a3b8;
        }
        .day-select-pill:has(input:checked) {
            background: #eff6ff;
            border-color: #3b82f6;
            color: #1d4ed8;
            font-weight: 600;
        }

        .table-responsive::-webkit-scrollbar {
            height: 6px;
        }
        .table-responsive::-webkit-scrollbar-thumb {
            background: rgba(212, 175, 55, 0.3);
            border-radius: 4px;
        }

        @media (max-width: 576px) {
            .glass-card {
                border-radius: 16px !important;
            }
            .emp-avatar-wrapper {
                width: 42px;
                height: 42px;
                min-width: 42px;
            }
            .emp-avatar {
                width: 42px;
                height: 42px;
                font-size: 15px;
            }
        }
    </style>
</head>

<body>
    <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

<%
function formatTimeAMPM(timeStr) {
    if (!timeStr) return '—';
    const parts = timeStr.split(':');
    if (parts.length < 2) return timeStr;
    let hours = parseInt(parts[0], 10);
    const m = parts[1];
    const ampm = hours >= 12 ? 'PM' : 'AM';
    hours = hours % 12;
    hours = hours ? hours : 12;
    return `${hours}:${m} ${ampm}`;
}
%>

    <div class="container-fluid main-content px-2 px-sm-3 px-lg-5 py-2 py-md-4">
        
        <!-- Alerts -->
        <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-3 mb-md-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> <%= success_msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-3 mb-md-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error_msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div class="glass-card p-3 p-sm-4 p-md-5 animate-fade-in">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
                <div>
                    <h2 class="m-0 fw-bold d-flex align-items-center gap-2 fs-4 fs-md-2 text-dark">
                        <i class="bi bi-people-fill text-primary"></i>
                        إدارة الموظفين
                    </h2>
                    <div class="text-muted small mt-1 d-flex flex-wrap align-items-center gap-2">
                        <span>إجمالي الموظفين: <strong class="text-dark"><%= employees.length %></strong></span>
                        <span class="text-secondary opacity-50">•</span>
                        <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i><%= employees.filter(e => !e.isOnLeave).length %> نشط</span>
                        <% if (employees.some(e => e.isOnLeave)) { %>
                            <span class="text-secondary opacity-50">•</span>
                            <span class="text-danger"><i class="bi bi-moon-fill me-1"></i><%= employees.filter(e => e.isOnLeave).length %> في إجازة</span>
                        <% } %>
                    </div>
                </div>
                <button class="btn btn-primary w-100 w-sm-auto px-4 py-2.5 rounded-pill shadow-sm d-flex align-items-center justify-content-center gap-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#addEmployeeModal">
                    <i class="bi bi-person-plus-fill fs-5"></i>
                    <span>إضافة موظف جديد</span>
                </button>
            </div>

            <!-- Empty Slots Analysis (Collapsible Card) -->
            <div class="card mb-4 border-warning border-opacity-50 shadow-sm" id="emptySlotsContainer" style="display:none; background: #fffdf5; border-radius: 14px;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2" role="button" data-bs-toggle="collapse" data-bs-target="#emptySlotsCollapse" aria-expanded="false" style="cursor: pointer;">
                        <div class="d-flex align-items-center gap-2.5">
                            <div class="rounded-circle bg-warning bg-opacity-25 p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; min-width: 38px;">
                                <i class="bi bi-clock-history text-warning-emphasis fs-5"></i>
                            </div>
                            <div>
                                <div style="font-size: 13.5px;" class="fw-bold text-dark">تغطية مواعيد المبيعات والأوقات غير المغطاة</div>
                                <div class="text-muted" style="font-size: 11px;">اضغط هنا لعرض تفاصيل ساعات العمل والفترات الفارغة أسبوعياً</div>
                            </div>
                        </div>
                        <button class="btn btn-sm btn-outline-warning rounded-pill px-3 py-1 fw-semibold d-flex align-items-center gap-1" style="font-size: 11.5px;" type="button">
                            <span>عرض التفاصيل</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    </div>
                    <div class="collapse mt-3 pt-3 border-top border-warning border-opacity-25" id="emptySlotsCollapse">
                        <div class="empty-slots-info-content"></div>
                    </div>
                </div>
            </div>

            <!-- Lead Routing Rules Settings (For Admins only) -->
            <% if (user.role === 'admin' || user.role === 'super_admin') { 
                const rule = {
                    enabled: shiftSplitRule?.enabled !== false,
                    shifts: (shiftSplitRule?.shifts && shiftSplitRule.shifts.length > 0) ? shiftSplitRule.shifts : [],
                    defaultEmployeeId: shiftSplitRule?.defaultEmployeeId || null
                };
                const salesList = employees.filter(e => e.role === 'sales');
            %>
            <div class="card mb-4 border-primary border-opacity-25 shadow-sm rounded-4" style="background: #f8fafc;">
                <div class="card-header bg-white border-bottom pt-3 pb-3 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 rounded-top-4">
                    <div>
                        <h5 class="fw-bold m-0 text-primary d-flex align-items-center gap-2 fs-6 fs-md-5">
                            <i class="bi bi-diagram-3-fill"></i> 🎯 قواعد توزيع العملاء والشيفتات المرنة (Multi-Shift Lead Routing)
                        </h5>
                        <div class="text-muted small mt-1">تحديد الموظفين وتوزيع العملاء بدقة حسب أوقات اليوم وأيام الأسبوع</div>
                    </div>
                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 w-100 w-sm-auto" type="button" data-bs-toggle="collapse" data-bs-target="#shiftSplitConfig" aria-expanded="<%= rule.enabled ? 'true' : 'false' %>">
                        <i class="bi bi-sliders me-1"></i> إعداد الشيفتات
                    </button>
                </div>
                <div class="collapse <%= rule.enabled ? 'show' : '' %>" id="shiftSplitConfig">
                    <div class="card-body p-3 p-md-4">
                        <form id="leadRoutingForm" action="/dashboard/employees/shift-split" method="POST" onsubmit="return submitShiftSplitForm()">
                            <input type="hidden" name="shiftsData" id="shiftsDataInput">
                            
                            <!-- Master Switch -->
                            <div class="p-3 bg-white border rounded-3 mb-3 d-flex align-items-center justify-content-between gap-3 shadow-xs">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">تفعيل نظام الشيفتات المرنة وتوزيع العملاء التلقائي</h6>
                                    <p class="text-muted small mb-0">عند التفعيل، سيتم فحص الشيفت النشط وتوزيع العملاء على موظفيه بالتساوي أو تحويلهم للموظف المحدد في كل فترة.</p>
                                </div>
                                <div class="form-check form-switch fs-3 m-0">
                                    <input class="form-check-input ms-0" type="checkbox" role="switch" id="shiftEnabled" name="enabled" <%= rule.enabled ? 'checked' : '' %>>
                                </div>
                            </div>

                            <!-- Shifts List Container -->
                            <div class="d-flex justify-content-between align-items-center mb-2.5 flex-wrap gap-2">
                                <h6 class="fw-bold text-dark m-0 d-flex align-items-center gap-1.5">
                                    <i class="bi bi-clock-history text-primary"></i>
                                    <span>قائمة الشيفتات والفترات المحددة:</span>
                                </h6>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-semibold d-flex align-items-center gap-1.5 shadow-xs" onclick="addNewShift()">
                                    <i class="bi bi-plus-circle-fill"></i>
                                    <span>إضافة فترة / شيفت جديد</span>
                                </button>
                            </div>

                            <div id="shiftsContainer" class="d-flex flex-column gap-3 mb-3">
                                <!-- Shifts rendered via EJS -->
                                <% rule.shifts.forEach((s, sIdx) => { %>
                                    <div class="card border rounded-3 bg-white shadow-xs shift-card" data-shift-id="<%= s.id || ('shift_' + (sIdx+1)) %>">
                                        <div class="card-header bg-light bg-opacity-50 py-2.5 px-3 d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
                                                <span class="badge bg-primary rounded-pill px-2.5 py-1 fw-bold shift-num-badge">شيفت <%= sIdx + 1 %></span>
                                                <input type="text" class="form-control form-control-sm fw-bold border-0 bg-transparent shift-name-input" value="<%= s.name || ('فترة ' + (sIdx+1)) %>" placeholder="اسم الشيفت (مثال: الفترة الصباحية)" style="max-width: 280px;">
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-1 d-flex align-items-center justify-content-center" onclick="deleteShift(this)" title="حذف هذا الشيفت" style="width: 32px; height: 32px;">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        </div>
                                        <div class="card-body p-3">
                                            <div class="row g-2.5">
                                                <!-- Times -->
                                                <div class="col-6 col-md-3">
                                                    <label class="form-label fw-bold small text-secondary mb-1">من الساعة</label>
                                                    <input type="time" class="form-control form-control-sm shift-start-time" value="<%= s.startTime %>" required>
                                                </div>
                                                <div class="col-6 col-md-3">
                                                    <label class="form-label fw-bold small text-secondary mb-1">إلى الساعة</label>
                                                    <input type="time" class="form-control form-control-sm shift-end-time" value="<%= s.endTime %>" required>
                                                </div>

                                                <!-- Days -->
                                                <div class="col-12 col-md-6">
                                                    <label class="form-label fw-bold small text-secondary mb-1 d-block">أيام العمل في هذا الشيفت</label>
                                                    <div class="d-flex flex-wrap gap-1.5">
                                                        <% ['السبت', 'الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة'].forEach((day, dIdx) => { 
                                                            const isChecked = s.days ? s.days.includes(day) : false;
                                                        %>
                                                            <label class="day-select-pill" style="padding: 3px 8px; font-size: 11px;">
                                                                <input class="form-check-input m-0 shift-day-check" type="checkbox" value="<%= day %>" <%= isChecked ? 'checked' : '' %>>
                                                                <span><%= day %></span>
                                                            </label>
                                                        <% }) %>
                                                    </div>
                                                </div>

                                                <!-- Employees -->
                                                <div class="col-12">
                                                    <label class="form-label fw-bold small text-secondary mb-1 d-block">
                                                        الموظفون المشمولون بالشيفت 
                                                        <small class="text-muted fw-normal">(اختيار موظف واحد = 100% له، أكثر من موظف = تناوب متساوي بينهم):</small>
                                                    </label>
                                                    <div class="d-flex flex-wrap gap-1.5 p-2 rounded-3 bg-light border">
                                                        <% salesList.forEach(emp => { 
                                                            const isEmpSelected = s.employees ? s.employees.includes(emp.id) : false;
                                                        %>
                                                            <label class="day-select-pill" style="padding: 4px 10px; font-size: 11.5px;">
                                                                <input class="form-check-input m-0 shift-emp-check" type="checkbox" value="<%= emp.id %>" <%= isEmpSelected ? 'checked' : '' %>>
                                                                <span class="fw-semibold text-dark">👤 <%= emp.fullName || emp.username %></span>
                                                            </label>
                                                        <% }) %>
                                                        <% if (salesList.length === 0) { %>
                                                            <span class="text-muted small">لا يوجد موظفي مبيعات حالياً</span>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>

                            <!-- Fallback / Default Rep -->
                            <div class="p-3 border rounded-3 bg-white mb-3 shadow-xs">
                                <h6 class="fw-bold text-indigo mb-1" style="color: #6366f1;">
                                    <i class="bi bi-shield-check me-1"></i> الموظف الافتراضي الاحتياطي (Fallback Rep)
                                </h6>
                                <p class="text-muted small mb-2">أي عميل يصل في وقت أو يوم غير مغطى بأي شيفت من الشيفتات أعلاه، سيتم تحويله تلقائياً بنسبة 100% إلى:</p>
                                <div class="row g-2 align-items-center">
                                    <div class="col-12 col-md-7">
                                        <select class="form-select form-select-sm" name="defaultEmployeeId">
                                            <option value="">-- اختر الموظف الافتراضي (مثال: رحمة سيلز) --</option>
                                            <% salesList.forEach(emp => { %>
                                                <option value="<%= emp.id %>" <%= (rule.defaultEmployeeId == emp.id) ? 'selected' : '' %>>
                                                    👤 <%= emp.fullName || emp.username %>
                                                </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-5">
                                        <button type="submit" class="btn btn-primary btn-sm w-100 px-4 py-2 fw-bold shadow-sm">
                                            <i class="bi bi-check-circle-fill me-1"></i> حفظ جميع الشيفتات والقواعد
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- New Shift Template (Hidden) -->
            <template id="newShiftTemplate">
                <div class="card border rounded-3 bg-white shadow-xs shift-card">
                    <div class="card-header bg-light bg-opacity-50 py-2.5 px-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
                            <span class="badge bg-primary rounded-pill px-2.5 py-1 fw-bold shift-num-badge">شيفت جديد</span>
                            <input type="text" class="form-control form-control-sm fw-bold border-0 bg-transparent shift-name-input" value="فترة جديدة" placeholder="اسم الشيفت" style="max-width: 280px;">
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-1 d-flex align-items-center justify-content-center" onclick="deleteShift(this)" title="حذف هذا الشيفت" style="width: 32px; height: 32px;">
                            <i class="bi bi-trash3-fill"></i>
                        </button>
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-2.5">
                            <div class="col-6 col-md-3">
                                <label class="form-label fw-bold small text-secondary mb-1">من الساعة</label>
                                <input type="time" class="form-control form-control-sm shift-start-time" value="09:00" required>
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label fw-bold small text-secondary mb-1">إلى الساعة</label>
                                <input type="time" class="form-control form-control-sm shift-end-time" value="17:00" required>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-bold small text-secondary mb-1 d-block">أيام العمل في هذا الشيفت</label>
                                <div class="d-flex flex-wrap gap-1.5">
                                    <% ['السبت', 'الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة'].forEach(day => { %>
                                        <label class="day-select-pill" style="padding: 3px 8px; font-size: 11px;">
                                            <input class="form-check-input m-0 shift-day-check" type="checkbox" value="<%= day %>" checked>
                                            <span><%= day %></span>
                                        </label>
                                    <% }) %>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small text-secondary mb-1 d-block">الموظفون المشمولون بالشيفت:</label>
                                <div class="d-flex flex-wrap gap-1.5 p-2 rounded-3 bg-light border">
                                    <% salesList.forEach(emp => { %>
                                        <label class="day-select-pill" style="padding: 4px 10px; font-size: 11.5px;">
                                            <input class="form-check-input m-0 shift-emp-check" type="checkbox" value="<%= emp.id %>">
                                            <span class="fw-semibold text-dark">👤 <%= emp.fullName || emp.username %></span>
                                        </label>
                                    <% }) %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </template>
            <% } %>

            <!-- Empty State -->
            <% if (employees.length === 0) { %>
                <div class="text-center py-5 glass-card mb-4" style="background: rgba(0, 0, 0, 0.02);">
                    <i class="bi bi-people text-secondary opacity-50" style="font-size: 4rem;"></i>
                    <h4 class="text-muted mt-3">لا يوجد موظفون مضافون حالياً</h4>
                    <p class="text-secondary small">قم بإضافة موظف مبيعات (Sales) أو مدير (Admin) للبدء في توزيع العملاء.</p>
                    <button class="btn btn-outline-primary rounded-pill mt-2 px-4" data-bs-toggle="modal" data-bs-target="#addEmployeeModal">أضف موظف الآن</button>
                </div>
            <% } else { %>
                
                <!-- Desktop Table View -->
                <div class="d-none d-lg-block table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>الاسم الكامل</th>
                                <th>اسم المستخدم</th>
                                <th>الهاتف</th>
                                <th>الدور</th>
                                <th>مواعيد العمل</th>
                                <th>أيام العمل</th>
                                <th>الموظف البديل</th>
                                <th class="text-center">العملاء الحاليين</th>
                                <th class="text-center">الحالة</th>
                                <th class="text-center">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% employees.forEach(emp => { %>
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark"><%= emp.fullName || '—' %></div>
                                    </td>
                                    <td>
                                        <code class="text-primary"><%= emp.username %></code>
                                    </td>
                                    <td>
                                        <span class="text-secondary"><%= emp.phone || '—' %></span>
                                    </td>
                                    <td>
                                        <% if (emp.role === 'super_admin') { %>
                                            <span class="badge bg-danger rounded-pill">Super Admin</span>
                                        <% } else if (emp.role === 'admin') { %>
                                            <span class="badge bg-warning text-dark rounded-pill">Admin</span>
                                        <% } else { %>
                                            <span class="badge bg-info text-white rounded-pill">Sales</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (emp.workStartTime && emp.workEndTime) { %>
                                            <span class="small text-secondary fw-semibold">
                                                من: <%= formatTimeAMPM(emp.workStartTime) %><br>
                                                إلى: <%= formatTimeAMPM(emp.workEndTime) %>
                                            </span>
                                        <% } else { %>
                                            <span class="text-muted small">—</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (emp.workDays) { %>
                                            <div class="d-flex flex-wrap gap-1" style="max-width: 180px;">
                                                <% emp.workDays.split(',').forEach(day => { %>
                                                    <span class="day-badge"><%= day.trim() %></span>
                                                <% }) %>
                                            </div>
                                        <% } else { %>
                                            <span class="text-muted small">—</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (emp.substituteUser) { %>
                                            <span class="text-dark fw-semibold small"><%= emp.substituteUser.fullName %></span>
                                        <% } else { %>
                                            <span class="text-muted small">—</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border border-secondary border-opacity-10 px-3 py-1 rounded">
                                            <%= emp.customerCount || 0 %>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <form action="/dashboard/employees/toggle-leave/<%= emp.id %>" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm <%= emp.isOnLeave ? 'btn-danger' : 'btn-success' %> rounded-pill px-3 py-1 fw-bold text-white d-inline-flex align-items-center gap-1" style="font-size: 12px;">
                                                <i class="bi <%= emp.isOnLeave ? 'bi-moon-fill' : 'bi-sun-fill' %>"></i>
                                                <%= emp.isOnLeave ? 'إجازة' : 'نشط' %>
                                            </button>
                                        </form>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center align-items-center gap-2">
                                            <button class="btn btn-sm btn-outline-primary rounded px-2" 
                                                    onclick="editEmployee(this)"
                                                    data-id="<%= emp.id %>"
                                                    data-fullname="<%= emp.fullName || '' %>"
                                                    data-username="<%= emp.username %>"
                                                    data-phone="<%= emp.phone || '' %>"
                                                    data-role="<%= emp.role %>"
                                                    data-start="<%= emp.workStartTime || '09:00' %>"
                                                    data-end="<%= emp.workEndTime || '17:00' %>"
                                                    data-days="<%= emp.workDays || '' %>"
                                                    data-substitute="<%= emp.substituteUserId || '' %>"
                                                    data-max="<%= emp.maxCustomers %>"
                                                    title="تعديل">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            
                                            <% if (emp.role !== 'super_admin') { %>
                                                <form action="/dashboard/employees/delete" method="POST" class="m-0 d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا الموظف؟ سيتم نقل عملائه للموظف البديل أو تصنيفهم كغير مخصصين.')">
                                                    <input type="hidden" name="id" value="<%= emp.id %>">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded px-2" title="حذف">
                                                        <i class="bi bi-trash3"></i>
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div class="d-block d-lg-none">
                    <% employees.forEach(emp => { 
                        const initial = (emp.fullName && emp.fullName.trim()) ? emp.fullName.trim()[0] : (emp.username ? emp.username[0].toUpperCase() : '؟');
                        let avatarBg = '#e0e7ff';
                        let avatarColor = '#3730a3';
                        let roleTitle = 'موظف مبيعات (Sales)';
                        let roleBadgeClass = 'emp-badge-sales';

                        if (emp.role === 'super_admin') {
                            avatarBg = '#fee2e2';
                            avatarColor = '#991b1b';
                            roleTitle = 'مدير عام (Super Admin)';
                            roleBadgeClass = 'emp-badge-superadmin';
                        } else if (emp.role === 'admin') {
                            avatarBg = '#fef3c7';
                            avatarColor = '#92400e';
                            roleTitle = 'مشرف (Admin)';
                            roleBadgeClass = 'emp-badge-admin';
                        }
                    %>
                        <div class="employee-card-mobile shadow-sm">
                            <!-- Card Header: Avatar, Name, Username & Role -->
                            <div class="d-flex align-items-center justify-content-between pb-3 border-bottom gap-2">
                                <div class="d-flex align-items-center gap-2 min-w-0">
                                    <div class="emp-avatar-wrapper flex-shrink-0">
                                        <div class="emp-avatar shadow-xs" style="background-color: <%= avatarBg %>; color: <%= avatarColor %>;">
                                            <%= initial %>
                                        </div>
                                        <span class="emp-status-dot <%= emp.isOnLeave ? 'leave' : 'active' %>" title="<%= emp.isOnLeave ? 'في إجازة' : 'نشط' %>"></span>
                                    </div>
                                    <div class="min-w-0">
                                        <h5 class="fw-bold text-dark mb-0 text-truncate" style="font-size: 15px;"><%= emp.fullName || '—' %></h5>
                                        <div class="d-flex align-items-center gap-1.5 flex-wrap mt-0.5">
                                            <span class="badge bg-light text-secondary border px-2 py-0.5 font-monospace" style="font-size: 10.5px; font-weight: 500;">
                                                <i class="bi bi-person-fill text-muted me-0.5"></i>@<%= emp.username %>
                                            </span>
                                            <% if (emp.isOnLeave) { %>
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-1.5 py-0.5" style="font-size: 9.5px;">إجازة</span>
                                            <% } else { %>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-1.5 py-0.5" style="font-size: 9.5px;">نشط</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex-shrink-0">
                                    <span class="badge <%= roleBadgeClass %> shadow-xs">
                                        <%= emp.role === 'super_admin' ? 'Super Admin' : (emp.role === 'admin' ? 'Admin' : 'Sales') %>
                                    </span>
                                </div>
                            </div>

                            <!-- Card Body: 2x2 Info Grid -->
                            <div class="row g-2 my-2">
                                <!-- Phone -->
                                <div class="col-6">
                                    <div class="emp-info-tile">
                                        <span class="text-muted small d-flex align-items-center gap-1" style="font-size: 10.5px;">
                                            <i class="bi bi-telephone-fill text-primary"></i>
                                            <span>الهاتف</span>
                                        </span>
                                        <% if (emp.phone) { %>
                                            <a href="tel:<%= emp.phone %>" class="text-decoration-none fw-semibold text-dark text-truncate mt-0.5" style="font-size: 12px; direction: ltr; text-align: right;">
                                                <%= emp.phone %>
                                            </a>
                                        <% } else { %>
                                            <span class="text-muted small mt-0.5" style="font-size: 12px;">—</span>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Current Customers -->
                                <div class="col-6">
                                    <div class="emp-info-tile">
                                        <span class="text-muted small d-flex align-items-center gap-1" style="font-size: 10.5px;">
                                            <i class="bi bi-people-fill text-primary"></i>
                                            <span>العملاء الحاليين</span>
                                        </span>
                                        <span class="fw-bold text-primary mt-0.5" style="font-size: 13px;">
                                            <%= emp.customerCount || 0 %> <small class="fw-normal text-muted" style="font-size: 11px;">عميل</small>
                                        </span>
                                    </div>
                                </div>

                                <!-- Work Hours -->
                                <div class="col-6">
                                    <div class="emp-info-tile">
                                        <span class="text-muted small d-flex align-items-center gap-1" style="font-size: 10.5px;">
                                            <i class="bi bi-clock-fill text-warning"></i>
                                            <span>مواعيد العمل</span>
                                        </span>
                                        <span class="fw-semibold text-dark mt-0.5" style="font-size: 11px; line-height: 1.3;">
                                            <% if (emp.workStartTime && emp.workEndTime) { %>
                                                <%= formatTimeAMPM(emp.workStartTime) %><br><span class="text-muted">إلى</span> <%= formatTimeAMPM(emp.workEndTime) %>
                                            <% } else { %>
                                                <span class="text-muted">—</span>
                                            <% } %>
                                        </span>
                                    </div>
                                </div>

                                <!-- Substitute -->
                                <div class="col-6">
                                    <div class="emp-info-tile">
                                        <span class="text-muted small d-flex align-items-center gap-1" style="font-size: 10.5px;">
                                            <i class="bi bi-arrow-repeat text-info"></i>
                                            <span>الموظف البديل</span>
                                        </span>
                                        <span class="fw-semibold text-dark text-truncate mt-0.5" style="font-size: 11.5px;" title="<%= emp.substituteUser ? emp.substituteUser.fullName : 'لا يوجد' %>">
                                            <%= emp.substituteUser ? emp.substituteUser.fullName : 'لا يوجد بديل' %>
                                        </span>
                                    </div>
                                </div>

                                <!-- Work Days -->
                                <div class="col-12">
                                    <div class="p-2 rounded-3 bg-light border border-light-subtle">
                                        <span class="d-block text-muted mb-1" style="font-size: 10.5px;">
                                            <i class="bi bi-calendar-week-fill me-1 text-secondary"></i>أيام العمل:
                                        </span>
                                        <% if (emp.workDays) { %>
                                            <div class="d-flex flex-wrap gap-1">
                                                <% emp.workDays.split(',').forEach(day => { %>
                                                    <span class="day-badge"><%= day.trim() %></span>
                                                <% }) %>
                                            </div>
                                        <% } else { %>
                                            <span class="text-muted" style="font-size: 11px;">غير محددة</span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>

                            <!-- Card Footer: Mobile Touch-Friendly Action Buttons -->
                            <div class="pt-2 mt-2 border-top">
                                <div class="d-flex align-items-center gap-2">
                                    <!-- Toggle Leave Form & Button -->
                                    <form action="/dashboard/employees/toggle-leave/<%= emp.id %>" method="POST" class="m-0 flex-grow-1">
                                        <button type="submit" class="btn btn-sm w-100 <%= emp.isOnLeave ? 'btn-status-leave' : 'btn-status-active' %> rounded-pill py-2 px-2 fw-bold d-flex align-items-center justify-content-center gap-1.5 shadow-xs" title="<%= emp.isOnLeave ? 'تفعيل الموظف (إلغاء الإجازة)' : 'وضع الموظف في إجازة' %>">
                                            <i class="bi <%= emp.isOnLeave ? 'bi-moon-fill' : 'bi-sun-fill' %>"></i>
                                            <span><%= emp.isOnLeave ? 'في إجازة' : 'نشط (متاح)' %></span>
                                        </button>
                                    </form>

                                    <!-- Edit Button -->
                                    <button type="button" class="btn btn-sm btn-edit-emp rounded-pill py-2 px-3 fw-semibold d-flex align-items-center justify-content-center gap-1.5 flex-grow-1 shadow-xs"
                                            onclick="editEmployee(this)"
                                            data-id="<%= emp.id %>"
                                            data-fullname="<%= emp.fullName || '' %>"
                                            data-username="<%= emp.username %>"
                                            data-phone="<%= emp.phone || '' %>"
                                            data-role="<%= emp.role %>"
                                            data-start="<%= emp.workStartTime || '09:00' %>"
                                            data-end="<%= emp.workEndTime || '17:00' %>"
                                            data-days="<%= emp.workDays || '' %>"
                                            data-substitute="<%= emp.substituteUserId || '' %>"
                                            data-max="<%= emp.maxCustomers %>">
                                        <i class="bi bi-pencil-square"></i>
                                        <span>تعديل</span>
                                    </button>

                                    <!-- Delete Button (Only for non-super_admin) -->
                                    <% if (emp.role !== 'super_admin') { %>
                                        <form action="/dashboard/employees/delete" method="POST" class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذا الموظف؟')">
                                            <input type="hidden" name="id" value="<%= emp.id %>">
                                            <button type="submit" class="btn btn-sm btn-delete-emp d-flex align-items-center justify-content-center shadow-xs" title="حذف الموظف">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

            <% } %>
        </div>
    </div>

    <!-- Add Employee Modal -->
    <div class="modal fade" id="addEmployeeModal" tabindex="-1" aria-labelledby="addEmployeeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="addEmployeeModalLabel">إضافة موظف جديد</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="alert alert-warning m-3 mb-0 empty-slots-info" style="display:none; font-size: 14px;"></div>
                <form action="/dashboard/employees/add" method="POST" onsubmit="return submitAddForm()">
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">الاسم الكامل للموظف</label>
                                <input type="text" name="fullName" class="form-control" placeholder="الاسم ثلاثي أو ثنائي" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">رقم الهاتف</label>
                                <input type="text" name="phone" class="form-control" placeholder="01xxxxxxxxx" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">اسم المستخدم (لتسجيل الدخول)</label>
                                <input type="text" name="username" class="form-control" placeholder="مثال: ahmed_sales" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">كلمة المرور</label>
                                <input type="password" name="password" class="form-control" placeholder="أدخل كلمة مرور قوية" required minlength="6">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">دور الموظف (Role)</label>
                                <select name="role" id="addRole" class="form-select" required onchange="toggleScheduleFields('add')">
                                    <option value="sales" selected>مبيعات (Sales)</option>
                                    <option value="admin">مدير (Admin)</option>
                                </select>
                            </div>
                            <input type="hidden" name="maxCustomers" value="999999">
                            <div class="col-12 add-schedule-fields">
                                <div class="row g-3">
                                    <div class="col-6">
                                        <label class="form-label fw-bold">بداية وقت العمل</label>
                                        <input type="time" name="workStartTime" class="form-control" value="09:00">
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label fw-bold">نهاية وقت العمل</label>
                                        <input type="time" name="workEndTime" class="form-control" value="17:00">
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-bold d-block">أيام العمل</label>
                                        <div class="d-flex flex-wrap gap-2 mt-1">
                                            <% ['السبت', 'الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة'].forEach((day, index) => { %>
                                                <label class="day-select-pill" for="addDay<%= index %>">
                                                    <input class="form-check-input add-day-check m-0" type="checkbox" value="<%= day %>" id="addDay<%= index %>" <%= index < 5 ? 'checked' : '' %>>
                                                    <span><%= day %></span>
                                                </label>
                                            <% }) %>
                                        </div>
                                        <input type="hidden" name="workDays" id="addWorkDaysInput" value="السبت,الأحد,الإثنين,الثلاثاء,الأربعاء">
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">الموظف البديل (في حالة الإجازة أو خارج أوقات العمل)</label>
                                <select name="substituteUserId" class="form-select">
                                    <option value="">-- لا يوجد موظف بديل --</option>
                                    <% employees.forEach(emp => { %>
                                        <option value="<%= emp.id %>"><%= emp.fullName %> (<%= emp.role %>)</option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-top d-flex flex-column-reverse flex-sm-row gap-2">
                        <button type="button" class="btn btn-secondary rounded-pill px-4 w-100 w-sm-auto" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold w-100 w-sm-auto">إضافة الموظف</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Employee Modal -->
    <div class="modal fade" id="editEmployeeModal" tabindex="-1" aria-labelledby="editEmployeeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="editEmployeeModalLabel">تعديل بيانات الموظف</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="alert alert-warning m-3 mb-0 empty-slots-info" style="display:none; font-size: 14px;"></div>
                <form action="/dashboard/employees/edit" method="POST" onsubmit="return submitEditForm()">
                    <input type="hidden" name="id" id="editId">
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">الاسم الكامل للموظف</label>
                                <input type="text" name="fullName" id="editFullName" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">رقم الهاتف</label>
                                <input type="text" name="phone" id="editPhone" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">اسم المستخدم (لتسجيل الدخول)</label>
                                <input type="text" name="username" id="editUsername" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">كلمة المرور (اتركها فارغة لعدم التغيير)</label>
                                <input type="password" name="password" id="editPassword" class="form-control" placeholder="أدخل كلمة مرور جديدة أو اتركها فارغة" minlength="6">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">دور الموظف (Role)</label>
                                <select name="role" id="editRole" class="form-select" required onchange="toggleScheduleFields('edit')">
                                    <option value="sales">مبيعات (Sales)</option>
                                    <option value="admin">مدير (Admin)</option>
                                </select>
                            </div>
                            <input type="hidden" name="maxCustomers" id="editMaxCustomers">
                            <div class="col-12 edit-schedule-fields">
                                <div class="row g-3">
                                    <div class="col-6">
                                        <label class="form-label fw-bold">بداية وقت العمل</label>
                                        <input type="time" name="workStartTime" id="editWorkStartTime" class="form-control">
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label fw-bold">نهاية وقت العمل</label>
                                        <input type="time" name="workEndTime" id="editWorkEndTime" class="form-control">
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-bold d-block">أيام العمل</label>
                                        <div class="d-flex flex-wrap gap-2 mt-1">
                                            <% ['السبت', 'الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة'].forEach((day, index) => { %>
                                                <label class="day-select-pill" for="editDay<%= index %>">
                                                    <input class="form-check-input edit-day-check m-0" type="checkbox" value="<%= day %>" id="editDay<%= index %>">
                                                    <span><%= day %></span>
                                                </label>
                                            <% }) %>
                                        </div>
                                        <input type="hidden" name="workDays" id="editWorkDaysInput">
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">الموظف البديل (في حالة الإجازة أو خارج أوقات العمل)</label>
                                <select name="substituteUserId" id="editSubstituteUserId" class="form-select">
                                    <option value="">-- لا يوجد موظف بديل --</option>
                                    <% employees.forEach(emp => { %>
                                        <option value="<%= emp.id %>" id="subOpt<%= emp.id %>"><%= emp.fullName %> (<%= emp.role %>)</option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-top d-flex flex-column-reverse flex-sm-row gap-2">
                        <button type="button" class="btn btn-secondary rounded-pill px-4 w-100 w-sm-auto" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold w-100 w-sm-auto">حفظ التغييرات</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // دالة تجميع أيام العمل للنموذج الأول
        function submitAddForm() {
            const checkedDays = Array.from(document.querySelectorAll('.add-day-check:checked')).map(el => el.value);
            document.getElementById('addWorkDaysInput').value = checkedDays.join(',');
            return true;
        }

        // دالة تجميع أيام العمل للنموذج الثاني
        function submitEditForm() {
            const checkedDays = Array.from(document.querySelectorAll('.edit-day-check:checked')).map(el => el.value);
            document.getElementById('editWorkDaysInput').value = checkedDays.join(',');
            return true;
        }

        // دالة فتح مودال التعديل وتعبئة البيانات
        function editEmployee(btn) {
            const id = btn.getAttribute('data-id');
            const fullName = btn.getAttribute('data-fullname');
            const username = btn.getAttribute('data-username');
            const phone = btn.getAttribute('data-phone');
            const role = btn.getAttribute('data-role');
            const start = btn.getAttribute('data-start');
            const end = btn.getAttribute('data-end');
            const days = btn.getAttribute('data-days');
            const substitute = btn.getAttribute('data-substitute');
            const max = btn.getAttribute('data-max');

            document.getElementById('editId').value = id;
            document.getElementById('editFullName').value = fullName;
            document.getElementById('editUsername').value = username;
            document.getElementById('editPhone').value = phone;
            document.getElementById('editRole').value = role;
            document.getElementById('editWorkStartTime').value = start;
            document.getElementById('editWorkEndTime').value = end;
            document.getElementById('editMaxCustomers').value = max;
            document.getElementById('editPassword').value = ''; // إفراغ كلمة المرور
            document.getElementById('editWorkDaysInput').value = days;

            // إخفاء الموظف نفسه من قائمة البدلاء لمنع الاختيار الخاطئ
            const subDropdown = document.getElementById('editSubstituteUserId');
            subDropdown.value = substitute;
            
            // تحديث خيارات البدلاء لإخفاء الموظف الحالي
            const options = subDropdown.querySelectorAll('option');
            options.forEach(opt => {
                if (opt.value === id) {
                    opt.style.display = 'none';
                } else {
                    opt.style.display = 'block';
                }
            });

            // تعبئة مربعات الاختيار للأيام
            const dayList = days.split(',').map(d => d.trim());
            const checkboxes = document.querySelectorAll('.edit-day-check');
            checkboxes.forEach(chk => {
                chk.checked = dayList.includes(chk.value);
            });

            const editModal = new bootstrap.Modal(document.getElementById('editEmployeeModal'));
            editModal.show();
        }

        const allSalesEmployees = <%- JSON.stringify(employees.filter(e => e.role === 'sales' && e.is_active !== false)) %>;

        function calculateEmptySlots() {
            const days = ['السبت', 'الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة'];
            let hasEmpty = false;
            let cardsHtml = '<div class="row g-2">';
            
            days.forEach(day => {
                let intervals = [];
                allSalesEmployees.forEach(emp => {
                    if (emp.workDays && emp.workDays.includes(day) && emp.workStartTime && emp.workEndTime) {
                        const toMins = t => { const [h,m] = t.split(':'); return parseInt(h)*60 + parseInt(m); };
                        let start = toMins(emp.workStartTime);
                        let end = toMins(emp.workEndTime);
                        if (start <= end) {
                            intervals.push({start, end});
                        } else {
                            intervals.push({start, end: 1440});
                            intervals.push({start: 0, end});
                        }
                    }
                });
                
                intervals.sort((a,b) => a.start - b.start);
                let merged = [];
                if (intervals.length > 0) {
                    let current = intervals[0];
                    for (let i = 1; i < intervals.length; i++) {
                        if (intervals[i].start <= current.end) {
                            current.end = Math.max(current.end, intervals[i].end);
                        } else {
                            merged.push(current);
                            current = intervals[i];
                        }
                    }
                    merged.push(current);
                }
                
                let gaps = [];
                let curTime = 0;
                merged.forEach(inter => {
                    if (inter.start > curTime) {
                        gaps.push({start: curTime, end: inter.start});
                    }
                    curTime = Math.max(curTime, inter.end);
                });
                if (curTime < 1440) {
                    gaps.push({start: curTime, end: 1440});
                }
                
                const formatTime = mins => {
                    let h = Math.floor(mins / 60);
                    const m = (mins % 60).toString().padStart(2, '0');
                    const period = h >= 12 ? 'م' : 'ص';
                    let h12 = h % 12;
                    if (h12 === 0) h12 = 12;
                    return `${h12.toString().padStart(2, '0')}:${m} ${period}`;
                };
                
                if (gaps.length > 0) {
                    hasEmpty = true;
                    let gapBadges = gaps.map(g => `<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1"><i class="bi bi-clock me-1"></i>${formatTime(g.start)} إلى ${formatTime(g.end)}</span>`).join(' ');
                    cardsHtml += `
                        <div class="col-12 col-md-6">
                            <div class="p-2 rounded-3 bg-white border d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-1.5 shadow-xs">
                                <span class="fw-bold text-dark small" style="min-width: 65px;">${day}</span>
                                <div class="d-flex flex-wrap gap-1">${gapBadges}</div>
                            </div>
                        </div>`;
                } else {
                    cardsHtml += `
                        <div class="col-12 col-md-6">
                            <div class="p-2 rounded-3 bg-white border d-flex justify-content-between align-items-center shadow-xs">
                                <span class="fw-bold text-dark small">${day}</span>
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>مغطى بالكامل (24 ساعة)</span>
                            </div>
                        </div>`;
                }
            });
            cardsHtml += '</div>';

            return { hasEmpty, html: cardsHtml };
        }

        // ================= Multi-Shift Lead Routing UI Handlers =================
        function addNewShift() {
            const template = document.getElementById('newShiftTemplate');
            if (!template) return;
            const clone = template.content.cloneNode(true);
            const card = clone.querySelector('.shift-card');
            card.setAttribute('data-shift-id', 'shift_' + Date.now());
            document.getElementById('shiftsContainer').appendChild(clone);
            updateShiftBadges();
        }

        function deleteShift(btn) {
            const cards = document.querySelectorAll('.shift-card');
            if (cards.length <= 1) {
                alert('يجب الإبقاء على شيفت واحد على الأقل في النظام.');
                return;
            }
            if (confirm('هل تريد بالتأكيد حذف هذا الشيفت؟')) {
                const card = btn.closest('.shift-card');
                if (card) {
                    card.remove();
                    updateShiftBadges();
                }
            }
        }

        function updateShiftBadges() {
            const cards = document.querySelectorAll('.shift-card');
            cards.forEach((card, idx) => {
                const badge = card.querySelector('.shift-num-badge');
                if (badge) badge.textContent = `شيفت ${idx + 1}`;
            });
        }

        function submitShiftSplitForm() {
            const cards = document.querySelectorAll('.shift-card');
            const shifts = [];
            cards.forEach((card, idx) => {
                const id = card.getAttribute('data-shift-id') || `shift_${idx + 1}`;
                const nameInput = card.querySelector('.shift-name-input');
                const startInput = card.querySelector('.shift-start-time');
                const endInput = card.querySelector('.shift-end-time');
                const dayChecks = card.querySelectorAll('.shift-day-check:checked');
                const empChecks = card.querySelectorAll('.shift-emp-check:checked');

                const days = Array.from(dayChecks).map(c => c.value);
                const employees = Array.from(empChecks).map(c => Number(c.value));

                shifts.push({
                    id,
                    name: (nameInput && nameInput.value.trim()) ? nameInput.value.trim() : `فترة ${idx + 1}`,
                    startTime: startInput ? startInput.value : '09:00',
                    endTime: endInput ? endInput.value : '17:00',
                    days,
                    employees
                });
            });

            document.getElementById('shiftsDataInput').value = JSON.stringify(shifts);
            return true;
        }

        function toggleScheduleFields(modalType) {
            const role = document.getElementById(modalType + 'Role').value;
            const scheduleDivs = document.querySelectorAll('.' + modalType + '-schedule-field');
            if (role === 'admin') {
                document.querySelector('.' + modalType + '-schedule-fields').style.display = 'none';
            } else {
                document.querySelector('.' + modalType + '-schedule-fields').style.display = 'block';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const emptyData = calculateEmptySlots();
            const container = document.getElementById('emptySlotsContainer');
            const contentEl = document.querySelector('.empty-slots-info-content');
            if (container && contentEl) {
                contentEl.innerHTML = emptyData.html;
                container.style.display = 'block';
            }
            document.querySelectorAll('.empty-slots-info').forEach(el => {
                el.innerHTML = '<strong class="d-block mb-2"><i class="bi bi-clock-history me-1"></i>الأوقات الفارغة غير المغطاة حالياً:</strong>' + emptyData.html;
                el.style.display = emptyData.hasEmpty ? 'block' : 'none';
            });
            toggleScheduleFields('add');
        });
    </script>
</body>

</html>
