                                            data-fullname="<%= emp.fullName || '' %>"
                                            data-username="<%= emp.username %>"
                                            data-phone="<%= emp.phone || '' %>"
                                            data-role="<%= emp.role %>"
                                            data-substitute="<%= emp.substituteUserId || '' %>"
                                            data-max="<%= emp.maxCustomers %>">
