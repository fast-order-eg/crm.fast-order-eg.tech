    <!-- Edit Employee Modal -->
    <div class="modal fade" id="editEmployeeModal" tabindex="-1" aria-labelledby="editEmployeeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="editEmployeeModalLabel">تعديل بيانات الموظف</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/dashboard/employees/edit" method="POST">
                    <input type="hidden" name="id" id="editId">
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">الاسم الكامل للموظف</label>
                                <input type="text" name="fullName" id="editFullName" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">رقم الهاتف</label>
                                <input type="text" name="phone" id="editPhone" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">اسم المستخدم (لتسجيل الدخول)</label>
                                <input type="text" name="username" id="editUsername" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">كلمة المرور (اتركها فارغة لعدم التغيير)</label>
                                <input type="password" name="password" id="editPassword" class="form-control" placeholder="أدخل كلمة مرور جديدة أو اتركها فارغة" minlength="6">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">دور الموظف (Role)</label>
                                <select name="role" id="editRole" class="form-select" required>
                                    <option value="sales">مبيعات (Sales)</option>
                                    <option value="admin">مدير (Admin)</option>
                                </select>
                            </div>
                            <input type="hidden" name="maxCustomers" id="editMaxCustomers">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">الموظف البديل (في حالة الإجازة)</label>
                                <select name="substituteUserId" id="editSubstituteUserId" class="form-select">
                                    <option value="">-- لا يوجد موظف بديل --</option>
                                    <% employees.forEach(emp => { %>
                                        <option value="<%= emp.id %>" id="subOpt<%= emp.id %>"><%= emp.fullName %> (<%= emp.role %>)</option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-top d-flex flex-column-reverse flex-sm-row gap-2">
                        <button type="button" class="btn btn-secondary rounded-pill px-4 w-100 w-sm-auto" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold w-100 w-sm-auto">حفظ التغييرات</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // دالة فتح مودال التعديل وتعبئة البيانات
        function editEmployee(btn) {
            const id = btn.getAttribute('data-id');
            const fullName = btn.getAttribute('data-fullname');
            const username = btn.getAttribute('data-username');
            const phone = btn.getAttribute('data-phone');
            const role = btn.getAttribute('data-role');
            const substitute = btn.getAttribute('data-substitute');
            const max = btn.getAttribute('data-max');

            document.getElementById('editId').value = id;
            document.getElementById('editFullName').value = fullName;
            document.getElementById('editUsername').value = username;
            document.getElementById('editPhone').value = phone;
            document.getElementById('editRole').value = role;
            document.getElementById('editMaxCustomers').value = max;
            document.getElementById('editPassword').value = ''; // إفراغ كلمة المرور

            // إخفاء الموظف نفسه من قائمة البدلاء لمنع الاختيار الخاطئ
            const subDropdown = document.getElementById('editSubstituteUserId');
            subDropdown.value = substitute;
            
            // تحديث خيارات البدلاء لإخفاء الموظف الحالي
            const options = subDropdown.querySelectorAll('option');
            options.forEach(opt => {
                if (opt.value === id) {
                    opt.style.display = 'none';
                } else {
                    opt.style.display = 'block';
                }
            });

            const editModal = new bootstrap.Modal(document.getElementById('editEmployeeModal'));
            editModal.show();
        }

        // ================= Multi-Shift Coverage & Lead Routing Handlers =================
        function calculateEmptySlots() {
            const days = ['السبت', 'الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة'];
            const masterSwitch = document.getElementById('shiftEnabled');
            const isShiftsEnabled = masterSwitch ? masterSwitch.checked : true;

            const cards = document.querySelectorAll('.shift-card');
            const activeShifts = [];
            cards.forEach(card => {
                const startInput = card.querySelector('.shift-start-time');
                const endInput = card.querySelector('.shift-end-time');
                const dayChecks = card.querySelectorAll('.shift-day-check:checked');
                const empChecks = card.querySelectorAll('.shift-emp-check:checked');

                const startTime = startInput ? startInput.value : '';
                const endTime = endInput ? endInput.value : '';
                const shiftDays = Array.from(dayChecks).map(c => c.value);
                const shiftEmployees = Array.from(empChecks).map(c => c.value);

                if (startTime && endTime && shiftDays.length > 0 && shiftEmployees.length > 0) {
                    activeShifts.push({
                        startTime,
                        endTime,
                        days: shiftDays,
                        employees: shiftEmployees
                    });
                }
            });

            if (!isShiftsEnabled) {
                return {
                    hasEmpty: true,
                    html: `
                        <div class="alert alert-warning mb-0 py-2 px-3 small rounded-3 d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            <div>نظام الشيفتات معطل حالياً. يتم التوزيع التلقائي العادي على موظفي المبيعات المتاحين.</div>
                        </div>
                    `
                };
            }

            if (activeShifts.length === 0) {
                return {
                    hasEmpty: true,
                    html: `
                        <div class="alert alert-danger mb-0 py-2 px-3 small rounded-3 d-flex align-items-center gap-2">
                            <i class="bi bi-x-octagon-fill fs-5"></i>
                            <div>لم يتم تحديد أي شيفتات نشطة تحتوي على موظفين. جميع الأوقات غير مغطاة حالياً!</div>
                        </div>
                    `
                };
            }

            let hasEmpty = false;
            let cardsHtml = '<div class="row g-2">';

            const toMins = t => {
                const [h, m] = t.split(':').map(Number);
                return (h * 60) + m;
            };

            const formatTime = mins => {
                let h = Math.floor(mins / 60);
                const m = (mins % 60).toString().padStart(2, '0');
                const period = h >= 12 ? 'م' : 'ص';
                let h12 = h % 12;
                if (h12 === 0) h12 = 12;
                return `${h12.toString().padStart(2, '0')}:${m} ${period}`;
            };

            days.forEach(day => {
                let intervals = [];

                activeShifts.forEach(shift => {
                    if (shift.days.includes(day)) {
                        let start = toMins(shift.startTime);
                        let end = toMins(shift.endTime);

                        if (start < end) {
                            intervals.push({ start, end });
                        } else if (start > end) {
                            // شيفت عابر لمنتصف الليل Cross-Midnight
                            intervals.push({ start, end: 1440 });
                            intervals.push({ start: 0, end });
                        } else {
                            intervals.push({ start: 0, end: 1440 });
                        }
                    }
                });

                intervals.sort((a, b) => a.start - b.start);
                let merged = [];
                if (intervals.length > 0) {
                    let current = { ...intervals[0] };
                    for (let i = 1; i < intervals.length; i++) {
                        if (intervals[i].start <= current.end) {
                            current.end = Math.max(current.end, intervals[i].end);
                        } else {
                            merged.push(current);
                            current = { ...intervals[i] };
                        }
                    }
                    merged.push(current);
                }

                let gaps = [];
                let curTime = 0;
                merged.forEach(inter => {
                    if (inter.start > curTime) {
                        gaps.push({ start: curTime, end: inter.start });
                    }
                    curTime = Math.max(curTime, inter.end);
                });
                if (curTime < 1440) {
                    gaps.push({ start: curTime, end: 1440 });
                }

                if (gaps.length > 0) {
                    hasEmpty = true;
                    const isAllDayEmpty = (gaps.length === 1 && gaps[0].start === 0 && gaps[0].end === 1440);
                    let gapBadges = '';
                    if (isAllDayEmpty) {
                        gapBadges = `<span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1"><i class="bi bi-x-circle me-1"></i>غير مغطى طوال اليوم (24 ساعة)</span>`;
                    } else {
                        gapBadges = gaps.map(g => `<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1"><i class="bi bi-clock me-1"></i>غير مغطى: ${formatTime(g.start)} إلى ${formatTime(g.end)}</span>`).join(' ');
                    }

                    cardsHtml += `
                        <div class="col-12 col-md-6">
                            <div class="p-2.5 rounded-3 bg-white border border-warning-subtle d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-1.5 shadow-xs">
                                <span class="fw-bold text-dark small d-flex align-items-center gap-1.5" style="min-width: 75px;">
                                    <span class="badge bg-secondary-subtle text-dark border px-2 py-1">${day}</span>
                                </span>
                                <div class="d-flex flex-wrap gap-1">${gapBadges}</div>
                            </div>
                        </div>`;
                } else {
                    cardsHtml += `
                        <div class="col-12 col-md-6">
                            <div class="p-2.5 rounded-3 bg-white border border-success-subtle d-flex justify-content-between align-items-center shadow-xs">
                                <span class="fw-bold text-dark small d-flex align-items-center gap-1.5" style="min-width: 75px;">
                                    <span class="badge bg-secondary-subtle text-dark border px-2 py-1">${day}</span>
                                </span>
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>مغطى بالكامل (24 ساعة)</span>
                            </div>
                        </div>`;
                }
            });
            cardsHtml += '</div>';

            return { hasEmpty, html: cardsHtml };
        }

        function refreshEmptySlots() {
            const emptyData = calculateEmptySlots();
            const container = document.getElementById('emptySlotsContainer');
            const contentEl = document.querySelector('.empty-slots-info-content');
            if (container && contentEl) {
                contentEl.innerHTML = emptyData.html;
                container.style.display = 'block';
            }
        }

        function addNewShift() {
            const template = document.getElementById('newShiftTemplate');
            if (!template) return;
            const clone = template.content.cloneNode(true);
            const card = clone.querySelector('.shift-card');
            card.setAttribute('data-shift-id', 'shift_' + Date.now());
            document.getElementById('shiftsContainer').appendChild(clone);
            updateShiftBadges();
            refreshEmptySlots();
        }

        function deleteShift(btn) {
            const cards = document.querySelectorAll('.shift-card');
            if (cards.length <= 1) {
                alert('يجب الإبقاء على شيفت واحد على الأقل في النظام.');
                return;
            }
            if (confirm('هل تريد بالتأكيد حذف هذا الشيفت؟')) {
                const card = btn.closest('.shift-card');
                if (card) {
                    card.remove();
                    updateShiftBadges();
                    refreshEmptySlots();
                }
            }
        }

        function updateShiftBadges() {
            const cards = document.querySelectorAll('.shift-card');
            cards.forEach((card, idx) => {
                const badge = card.querySelector('.shift-num-badge');
                if (badge) badge.textContent = `شيفت ${idx + 1}`;
            });
        }

        function submitShiftSplitForm() {
            const cards = document.querySelectorAll('.shift-card');
            const shifts = [];
            cards.forEach((card, idx) => {
                const id = card.getAttribute('data-shift-id') || `shift_${idx + 1}`;
                const nameInput = card.querySelector('.shift-name-input');
                const startInput = card.querySelector('.shift-start-time');
                const endInput = card.querySelector('.shift-end-time');
                const dayChecks = card.querySelectorAll('.shift-day-check:checked');
                const empChecks = card.querySelectorAll('.shift-emp-check:checked');

                const days = Array.from(dayChecks).map(c => c.value);
                const employees = Array.from(empChecks).map(c => Number(c.value));

                shifts.push({
                    id,
                    name: (nameInput && nameInput.value.trim()) ? nameInput.value.trim() : `فترة ${idx + 1}`,
                    startTime: startInput ? startInput.value : '09:00',
                    endTime: endInput ? endInput.value : '17:00',
                    days,
                    employees
                });
            });

            document.getElementById('shiftsDataInput').value = JSON.stringify(shifts);
            return true;
        }

        document.addEventListener('DOMContentLoaded', () => {
            refreshEmptySlots();

            const shiftsContainer = document.getElementById('shiftsContainer');
            if (shiftsContainer) {
                shiftsContainer.addEventListener('input', refreshEmptySlots);
                shiftsContainer.addEventListener('change', refreshEmptySlots);
            }
            const shiftSwitch = document.getElementById('shiftEnabled');
            if (shiftSwitch) {
                shiftSwitch.addEventListener('change', refreshEmptySlots);
            }
        });
    </script>
</body>

</html>
