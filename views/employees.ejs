<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة الموظفين - Bird-CRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="/style.css?v=<%= Date.now() %>" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        .employee-badge {
            font-size: 11px;
            padding: 4px 8px;
            border-radius: 50px;
            font-weight: 600;
        }
        .day-badge {
            font-size: 10.5px;
            padding: 2px 7px;
            background: #f1f5f9;
            color: #334155;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            display: inline-block;
            margin: 2px;
            font-weight: 500;
        }
        
        /* Modern Mobile Card Styles */
        .employee-card-mobile {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 1.15rem;
            margin-bottom: 1rem;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
            transition: all 0.25s ease;
            position: relative;
        }
        .employee-card-mobile:hover {
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
            border-color: #cbd5e1;
        }
        
        .emp-avatar-wrapper {
            position: relative;
            width: 46px;
            height: 46px;
            min-width: 46px;
        }
        .emp-avatar {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            font-weight: 700;
        }
        .emp-status-dot {
            position: absolute;
            bottom: 0;
            right: 0;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            border: 2px solid #ffffff;
        }
        .emp-status-dot.active {
            background-color: #10b981;
        }
        .emp-status-dot.leave {
            background-color: #ef4444;
        }

        /* Role Badges */
        .emp-badge-sales {
            background: #eef2ff;
            color: #4338ca !important;
            border: 1px solid #c7d2fe;
            font-size: 11px;
            padding: 3px 10px;
            border-radius: 50px;
            font-weight: 600;
        }
        .emp-badge-admin {
            background: #fffbeb;
            color: #b45309 !important;
            border: 1px solid #fde68a;
            font-size: 11px;
            padding: 3px 10px;
            border-radius: 50px;
            font-weight: 600;
        }
        .emp-badge-superadmin {
            background: #fef2f2;
            color: #b91c1c !important;
            border: 1px solid #fecaca;
            font-size: 11px;
            padding: 3px 10px;
            border-radius: 50px;
            font-weight: 600;
        }

        /* Info Tiles */
        .emp-info-tile {
            background: #f8fafc;
            border: 1px solid #edf2f7;
            border-radius: 10px;
            padding: 8px 10px;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* Modern Mobile Action Buttons */
        .btn-status-active {
            background-color: #ecfdf5;
            color: #047857 !important;
            border: 1px solid #a7f3d0;
            font-size: 12px;
            height: 38px;
            transition: all 0.2s;
        }
        .btn-status-active:hover, .btn-status-active:active {
            background-color: #10b981;
            color: #ffffff !important;
            border-color: #10b981;
        }

        .btn-status-leave {
            background-color: #fef2f2;
            color: #b91c1c !important;
            border: 1px solid #fecaca;
            font-size: 12px;
            height: 38px;
            transition: all 0.2s;
        }
        .btn-status-leave:hover, .btn-status-leave:active {
            background-color: #ef4444;
            color: #ffffff !important;
            border-color: #ef4444;
        }

        .btn-edit-emp {
            background-color: #eff6ff;
            color: #1d4ed8 !important;
            border: 1px solid #bfdbfe;
            font-size: 12px;
            height: 38px;
            transition: all 0.2s;
        }
        .btn-edit-emp:hover, .btn-edit-emp:active {
            background-color: #2563eb;
            color: #ffffff !important;
            border-color: #2563eb;
        }

        .btn-delete-emp {
            background-color: #ffffff;
            color: #dc2626 !important;
            border: 1px solid #fca5a5;
            height: 38px;
            width: 38px;
            min-width: 38px;
            padding: 0;
            font-size: 14px;
            border-radius: 10px;
            transition: all 0.2s;
        }
        .btn-delete-emp:hover, .btn-delete-emp:active {
            background-color: #dc2626;
            color: #ffffff !important;
            border-color: #dc2626;
        }

        /* Day Check Pills in Modals */
        .day-select-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            background: #ffffff;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            user-select: none;
            transition: all 0.15s ease-in-out;
        }
        .day-select-pill:hover {
            background: #f8fafc;
            border-color: #94a3b8;
        }
        .day-select-pill:has(input:checked) {
            background: #eff6ff;
            border-color: #3b82f6;
            color: #1d4ed8;
            font-weight: 600;
        }

        .table-responsive::-webkit-scrollbar {
            height: 6px;
        }
        .table-responsive::-webkit-scrollbar-thumb {
            background: rgba(212, 175, 55, 0.3);
            border-radius: 4px;
        }

        @media (max-width: 576px) {
            .glass-card {
                border-radius: 16px !important;
            }
            .emp-avatar-wrapper {
                width: 42px;
                height: 42px;
                min-width: 42px;
            }
            .emp-avatar {
                width: 42px;
                height: 42px;
                font-size: 15px;
            }
        }
    </style>
</head>

<body>
    <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

    <div class="container-fluid main-content px-2 px-sm-3 px-lg-5 py-2 py-md-4">
        
        <!-- Alerts -->
        <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-3 mb-md-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> <%= success_msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-3 mb-md-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error_msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div class="glass-card p-3 p-sm-4 p-md-5 animate-fade-in">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
                <div>
                    <h2 class="m-0 fw-bold d-flex align-items-center gap-2 fs-4 fs-md-2 text-dark">
                        <i class="bi bi-people-fill text-primary"></i>
                        إدارة الموظفين
                    </h2>
                    <div class="text-muted small mt-1 d-flex flex-wrap align-items-center gap-2">
                        <span>إجمالي الموظفين: <strong class="text-dark"><%= employees.length %></strong></span>
                        <span class="text-secondary opacity-50">•</span>
                        <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i><%= employees.filter(e => !e.isOnLeave).length %> نشط</span>
                        <% if (employees.some(e => e.isOnLeave)) { %>
                            <span class="text-secondary opacity-50">•</span>
                            <span class="text-danger"><i class="bi bi-moon-fill me-1"></i><%= employees.filter(e => e.isOnLeave).length %> في إجازة</span>
                        <% } %>
                    </div>
                </div>
                <button class="btn btn-primary w-100 w-sm-auto px-4 py-2.5 rounded-pill shadow-sm d-flex align-items-center justify-content-center gap-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#addEmployeeModal">
                    <i class="bi bi-person-plus-fill fs-5"></i>
                    <span>إضافة موظف جديد</span>
                </button>
            </div>

            <!-- Empty Slots Analysis (Collapsible Card) -->
            <div class="card mb-3 border-warning border-opacity-50 shadow-sm" id="emptySlotsContainer" style="display:none; background: #fffdf5; border-radius: 14px;">
                <div class="card-body p-2.5 p-sm-3">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2" role="button" data-bs-toggle="collapse" data-bs-target="#emptySlotsCollapse" aria-expanded="false" style="cursor: pointer;">
                        <div class="d-flex align-items-center gap-2.5">
                            <div class="rounded-circle bg-warning bg-opacity-25 p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; min-width: 36px;">
                                <i class="bi bi-clock-history text-warning-emphasis fs-5"></i>
                            </div>
                            <div>
                                <div style="font-size: 13px;" class="fw-bold text-dark">تغطية الشيفتات والأوقات غير المغطاة</div>
                                <div class="text-muted" style="font-size: 10.5px;">فحص الأوقات المغطاة والفارغة أسبوعياً بناءً على تقسيمات الشيفتات</div>
                            </div>
                        </div>
                        <button class="btn btn-sm btn-outline-warning rounded-pill px-2.5 py-1 fw-semibold d-flex align-items-center gap-1" style="font-size: 11px;" type="button">
                            <span>عرض التغطية</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    </div>
                    <div class="collapse mt-2.5 pt-2.5 border-top border-warning border-opacity-25" id="emptySlotsCollapse">
                        <div class="empty-slots-info-content"></div>
                    </div>
                </div>
            </div>

            <!-- Lead Routing Rules Settings (For Admins only) -->
            <% if (user.role === 'admin' || user.role === 'super_admin') { 
                const rule = {
                    enabled: shiftSplitRule?.enabled !== false,
                    shifts: (shiftSplitRule?.shifts && shiftSplitRule.shifts.length > 0) ? shiftSplitRule.shifts : [],
                    defaultEmployeeId: shiftSplitRule?.defaultEmployeeId || null
                };
                const salesList = employees.filter(e => e.role === 'sales');
            %>
            <div class="card mb-3 border-primary border-opacity-25 shadow-sm rounded-3" style="background: #f8fafc;">
                <div class="card-header bg-white border-bottom py-2.5 px-3 d-flex flex-row justify-content-between align-items-center gap-2 rounded-top-3">
                    <div class="d-flex align-items-center gap-2 min-w-0">
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-1.5 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px;">
                            <i class="bi bi-diagram-3-fill fs-6"></i>
                        </div>
                        <div class="min-w-0">
                            <h6 class="fw-bold m-0 text-dark text-truncate" style="font-size: 13.5px;">توزيع العملاء والشيفتات</h6>
                            <div class="text-muted text-truncate" style="font-size: 10.5px;">توزيع تلقائي حسب الوقت والأيام</div>
                        </div>
                    </div>
                    <button class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1 flex-shrink-0 fw-semibold d-flex align-items-center gap-1" type="button" data-bs-toggle="collapse" data-bs-target="#shiftSplitConfig" aria-expanded="<%= rule.enabled ? 'true' : 'false' %>" style="font-size: 11.5px;">
                        <i class="bi bi-sliders"></i>
                        <span>إعداد الشيفتات</span>
                    </button>
                </div>
                <div class="collapse <%= rule.enabled ? 'show' : '' %>" id="shiftSplitConfig">
                    <div class="card-body p-2.5 p-sm-3">
                        <form id="leadRoutingForm" action="/dashboard/employees/shift-split" method="POST" onsubmit="return submitShiftSplitForm()">
                            <input type="hidden" name="shiftsData" id="shiftsDataInput">
                            
                            <!-- Master Switch (Clean Minimal Row) -->
                            <div class="p-2.5 px-3 bg-white border rounded-3 mb-2.5 d-flex align-items-center justify-content-between gap-2 shadow-xs">
                                <div class="min-w-0">
                                    <div class="fw-bold text-dark" style="font-size: 13px;">تفعيل نظام الشيفتات</div>
                                    <div class="text-muted text-truncate" style="font-size: 10.5px;">توزيع العملاء آلياً حسب مواعيد كل شيفت</div>
                                </div>
                                <div class="form-check form-switch m-0 p-0 flex-shrink-0 d-flex align-items-center">
                                    <input class="form-check-input m-0 cursor-pointer" type="checkbox" role="switch" id="shiftEnabled" name="enabled" <%= rule.enabled ? 'checked' : '' %> style="width: 2.4em; height: 1.25em;">
                                </div>
                            </div>

                            <!-- Shifts List Header -->
                            <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                                <span class="fw-bold text-dark" style="font-size: 12px;">
                                    <i class="bi bi-clock-history text-primary me-1"></i>الشيفتات المحددة:
                                </span>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 fw-semibold d-flex align-items-center gap-1 shadow-xs" onclick="addNewShift()" style="font-size: 11px;">
                                    <i class="bi bi-plus-lg"></i>
                                    <span>إضافة شيفت</span>
                                </button>
                            </div>

                            <div id="shiftsContainer" class="d-flex flex-column gap-2 mb-2.5">
                                <!-- Shifts rendered via EJS -->
                                <% rule.shifts.forEach((s, sIdx) => { %>
                                    <div class="card border rounded-3 bg-white shadow-xs shift-card" data-shift-id="<%= s.id || ('shift_' + (sIdx+1)) %>">
                                        <div class="card-header bg-light bg-opacity-75 py-1.5 px-2.5 d-flex justify-content-between align-items-center gap-2">
                                            <div class="d-flex align-items-center gap-1.5 flex-grow-1 min-w-0">
                                                <span class="badge bg-primary rounded-pill px-2 py-1 fw-bold shift-num-badge flex-shrink-0" style="font-size: 10.5px;">شيفت <%= sIdx + 1 %></span>
                                                <input type="text" class="form-control form-control-sm fw-bold border-0 bg-white rounded-2 px-2 py-0 shift-name-input shadow-xs flex-grow-1 min-w-0" value="<%= s.name || ('فترة ' + (sIdx+1)) %>" placeholder="اسم الشيفت" style="font-size: 11.5px; height: 26px;">
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-0 d-flex align-items-center justify-content-center flex-shrink-0" onclick="deleteShift(this)" title="حذف هذا الشيفت" style="width: 26px; height: 26px;">
                                                <i class="bi bi-trash3 text-danger" style="font-size: 12px;"></i>
                                            </button>
                                        </div>
                                        <div class="card-body p-2.5">
                                            <div class="row g-2">
                                                <!-- Times -->
                                                <div class="col-6">
                                                    <label class="form-label text-muted mb-0.5 d-block" style="font-size: 10.5px;">من الساعة</label>
                                                    <input type="time" class="form-control form-control-sm shift-start-time" value="<%= s.startTime %>" required style="font-size: 11.5px; height: 32px;">
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label text-muted mb-0.5 d-block" style="font-size: 10.5px;">إلى الساعة</label>
                                                    <input type="time" class="form-control form-control-sm shift-end-time" value="<%= s.endTime %>" required style="font-size: 11.5px; height: 32px;">
                                                </div>

                                                <!-- Days -->
                                                <div class="col-12">
                                                    <label class="form-label text-muted mb-1 d-block" style="font-size: 10.5px;">أيام العمل</label>
                                                    <div class="d-flex flex-wrap gap-1">
                                                        <% ['السبت', 'الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة'].forEach((day, dIdx) => { 
                                                            const isChecked = s.days ? s.days.includes(day) : false;
                                                        %>
                                                            <label class="day-select-pill" style="padding: 2px 7px; font-size: 10px;">
                                                                <input class="form-check-input m-0 shift-day-check" type="checkbox" value="<%= day %>" <%= isChecked ? 'checked' : '' %>>
                                                                <span><%= day %></span>
                                                            </label>
                                                        <% }) %>
                                                    </div>
                                                </div>

                                                <!-- Employees -->
                                                <div class="col-12">
                                                    <label class="form-label text-muted mb-1 d-block" style="font-size: 10.5px;">موظفو الشيفت</label>
                                                    <div class="d-flex flex-wrap gap-1 p-1.5 rounded-2 bg-light border">
                                                        <% salesList.forEach(emp => { 
                                                            const isEmpSelected = s.employees ? s.employees.includes(emp.id) : false;
                                                        %>
                                                            <label class="day-select-pill" style="padding: 3px 8px; font-size: 10.5px;">
                                                                <input class="form-check-input m-0 shift-emp-check" type="checkbox" value="<%= emp.id %>" <%= isEmpSelected ? 'checked' : '' %>>
                                                                <span class="fw-semibold text-dark">👤 <%= emp.fullName || emp.username %></span>
                                                            </label>
                                                        <% }) %>
                                                        <% if (salesList.length === 0) { %>
                                                            <span class="text-muted small">لا يوجد موظفو مبيعات</span>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>

                            <!-- Fallback / Default Rep -->
                            <div class="p-2.5 px-3 border rounded-3 bg-white mb-2 shadow-xs">
                                <div class="d-flex align-items-center gap-1.5 mb-1.5 text-primary fw-bold" style="font-size: 12px;">
                                    <i class="bi bi-shield-check"></i>
                                    <span>الموظف البديل (خارج الشيفتات)</span>
                                </div>
                                <div class="row g-2 align-items-center">
                                    <div class="col-12 col-md-7">
                                        <select class="form-select form-select-sm" name="defaultEmployeeId" style="font-size: 11.5px; height: 34px;">
                                            <option value="">-- اختر الموظف البديل --</option>
                                            <% salesList.forEach(emp => { %>
                                                <option value="<%= emp.id %>" <%= (rule.defaultEmployeeId == emp.id) ? 'selected' : '' %>>
                                                    👤 <%= emp.fullName || emp.username %>
                                                </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-5">
                                        <button type="submit" class="btn btn-primary btn-sm w-100 py-1.5 fw-bold shadow-xs d-flex align-items-center justify-content-center gap-1.5" style="font-size: 12px; height: 34px;">
                                            <i class="bi bi-check-circle-fill"></i>
                                            <span>حفظ التعديلات</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- New Shift Template (Hidden) -->
            <template id="newShiftTemplate">
                <div class="card border rounded-3 bg-white shadow-xs shift-card">
                    <div class="card-header bg-light bg-opacity-75 py-1.5 px-2.5 d-flex justify-content-between align-items-center gap-2">
                        <div class="d-flex align-items-center gap-1.5 flex-grow-1 min-w-0">
                            <span class="badge bg-primary rounded-pill px-2 py-1 fw-bold shift-num-badge flex-shrink-0" style="font-size: 10.5px;">شيفت جديد</span>
                            <input type="text" class="form-control form-control-sm fw-bold border-0 bg-white rounded-2 px-2 py-0 shift-name-input shadow-xs flex-grow-1 min-w-0" value="فترة جديدة" placeholder="اسم الشيفت" style="font-size: 11.5px; height: 26px;">
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger border-0 rounded-circle p-0 d-flex align-items-center justify-content-center flex-shrink-0" onclick="deleteShift(this)" title="حذف هذا الشيفت" style="width: 26px; height: 26px;">
                            <i class="bi bi-trash3 text-danger" style="font-size: 12px;"></i>
                        </button>
                    </div>
                    <div class="card-body p-2.5">
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label text-muted mb-0.5 d-block" style="font-size: 10.5px;">من الساعة</label>
                                <input type="time" class="form-control form-control-sm shift-start-time" value="09:00" required style="font-size: 11.5px; height: 32px;">
                            </div>
                            <div class="col-6">
                                <label class="form-label text-muted mb-0.5 d-block" style="font-size: 10.5px;">إلى الساعة</label>
                                <input type="time" class="form-control form-control-sm shift-end-time" value="17:00" required style="font-size: 11.5px; height: 32px;">
                            </div>
                            <div class="col-12">
                                <label class="form-label text-muted mb-1 d-block" style="font-size: 10.5px;">أيام العمل</label>
                                <div class="d-flex flex-wrap gap-1">
                                    <% ['السبت', 'الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة'].forEach(day => { %>
                                        <label class="day-select-pill" style="padding: 2px 7px; font-size: 10px;">
                                            <input class="form-check-input m-0 shift-day-check" type="checkbox" value="<%= day %>" checked>
                                            <span><%= day %></span>
                                        </label>
                                    <% }) %>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label text-muted mb-1 d-block" style="font-size: 10.5px;">موظفو الشيفت</label>
                                <div class="d-flex flex-wrap gap-1 p-1.5 rounded-2 bg-light border">
                                    <% salesList.forEach(emp => { %>
                                        <label class="day-select-pill" style="padding: 3px 8px; font-size: 10.5px;">
                                            <input class="form-check-input m-0 shift-emp-check" type="checkbox" value="<%= emp.id %>">
                                            <span class="fw-semibold text-dark">👤 <%= emp.fullName || emp.username %></span>
                                        </label>
                                    <% }) %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </template>
            <% } %>

            <!-- Empty State -->
            <% if (employees.length === 0) { %>
