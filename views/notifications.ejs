<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مركز الإشعارات والويب بوش - Bird-CRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="/style.css?v=<%= Date.now() %>" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        .main-content {
            margin-right: 90px;
            width: calc(100% - 90px);
            padding-top: 95px;
            padding-bottom: 50px;
            transition: all 0.3s ease;
        }

        @media (max-width: 992px) {
            .main-content {
                margin-right: 0 !important;
                width: 100% !important;
                padding-top: 85px !important;
                padding-left: 12px !important;
                padding-right: 12px !important;
            }
        }

        .push-status-card {
            background: #ffffff;
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
            position: relative;
        }

        .emp-mobile-card {
            background: #ffffff;
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 14px;
            padding: 1rem;
            margin-bottom: 0.75rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
            transition: all 0.2s ease;
        }

        .emp-mobile-card:hover {
            border-color: var(--primary-color, #d4af37);
        }

        .device-chip {
            background: #f1f5f9;
            color: #334155;
            border-radius: 6px;
            padding: 3px 8px;
            font-size: 0.75rem;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .notif-card {
            background: #ffffff;
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 14px;
            padding: 1rem;
            margin-bottom: 0.75rem;
            transition: all 0.2s;
        }

        .notif-card:hover {
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
            border-color: var(--primary-color, #d4af37);
        }

        .notif-unread {
            background-color: rgba(212, 175, 55, 0.04);
            border-right: 4px solid var(--primary-color, #d4af37);
        }

        .notif-icon-box {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .icon-customer_assigned {
            background-color: rgba(25, 135, 84, 0.12);
            color: #198754;
        }

        .icon-status_changed {
            background-color: rgba(255, 193, 7, 0.15);
            color: #b58105;
        }

        .icon-payment_received {
            background-color: rgba(13, 202, 240, 0.15);
            color: #087990;
        }

        .icon-follow_up_due {
            background-color: rgba(220, 53, 69, 0.12);
            color: #dc3545;
        }

        .icon-system {
            background-color: rgba(108, 117, 125, 0.12);
            color: #6c757d;
        }

        .icon-customer_note {
            background-color: rgba(13, 110, 253, 0.12);
            color: #0d6efd;
        }

        .pulse-active {
            width: 8px;
            height: 8px;
            background-color: #198754;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.7);
            animation: pulse-green 2s infinite;
        }

        @keyframes pulse-green {
            0% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.7);
            }
            70% {
                transform: scale(1);
                box-shadow: 0 0 0 6px rgba(25, 135, 84, 0);
            }
            100% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(25, 135, 84, 0);
            }
        }
    </style>
</head>

<body>
    <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

    <div class="container-fluid main-content px-2 px-sm-3 px-lg-4 pb-5">
        <!-- حاوية رسائل التنبيه العائمة Toasts -->
        <div id="alertContainer" style="position: fixed; top: 85px; left: 50%; transform: translateX(-50%); z-index: 1060; width: 92%; max-width: 420px;"></div>

        <!-- رأس الصفحة المتجاوب -->
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-3 gap-2">
            <div>
                <h3 class="fw-bold m-0 d-flex align-items-center gap-2 fs-5 fs-sm-4 text-dark">
                    <i class="bi bi-bell-fill text-primary"></i>
                    مركز الإشعارات الفورية
                </h3>
                <p class="text-muted small m-0 mt-1" style="font-size: 12px;">
                    استقبال تنبيهات العملاء الجدد في الخلفية حتى والمتصفح مغلق
                </p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-primary rounded-pill fw-semibold d-flex align-items-center gap-1 shadow-sm px-3" onclick="markAllReadOnPage()">
                    <i class="bi bi-check-all fs-6"></i>
                    <span class="small">تحديد الكل</span>
                </button>
                <button class="btn btn-sm btn-outline-secondary rounded-pill fw-semibold d-flex align-items-center gap-1 shadow-sm px-3" onclick="loadNotifications(1)">
                    <i class="bi bi-arrow-clockwise fs-6"></i>
                    <span class="small">تحديث</span>
                </button>
            </div>
        </div>

        <!-- 1. كارت فحص وتفعيل جهازك الحالي -->
        <div class="push-status-card p-3 p-sm-4 mb-3">
            <div class="row align-items-center gy-3">
                <div class="col-12 col-md-7">
                    <div class="d-flex align-items-center gap-3">
                        <div class="p-2.5 rounded-circle bg-primary bg-opacity-10 text-primary flex-shrink-0 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="bi bi-phone-vibrate fs-4"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <h6 class="fw-bold text-dark m-0">جهازك الحالي (<span id="currentDeviceType">جهازك</span>)</h6>
                                <span id="currentDeviceStatusBadge" class="badge bg-secondary-subtle text-secondary small py-1 px-2 rounded-pill">جاري الفحص...</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2 text-muted" style="font-size: 11px;">
                                <span><i class="bi bi-browser-chrome me-1"></i><span id="detectedBrowser">—</span></span>
                                <span>•</span>
                                <span><i class="bi bi-shield-check me-1"></i>الإذن: <strong id="detectedPermission" class="text-dark">—</strong></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-5 text-md-start">
                    <div class="d-grid d-sm-flex gap-2 justify-content-md-end">
                        <button id="btnEnablePush" class="btn btn-success btn-sm px-3 py-2 rounded-pill fw-bold shadow-sm d-none" onclick="enablePushOnThisDevice()">
                            <i class="bi bi-bell-fill me-1"></i> تفعيل الإشعارات الآن
                        </button>
                        <button id="btnTestPush" class="btn btn-primary btn-sm px-3 py-2 rounded-pill fw-semibold shadow-sm d-none" onclick="sendTestPushToMe()">
                            <i class="bi bi-send-fill me-1"></i> تجربة إشعار فوري
                        </button>
                        <button id="btnDisablePush" class="btn btn-outline-danger btn-sm px-3 py-2 rounded-pill fw-semibold d-none" onclick="disablePushOnThisDevice()">
                            <i class="bi bi-bell-slash me-1"></i> تعطيل الإشعار
                        </button>
                    </div>
                    <div id="permissionDeniedNotice" class="text-danger small mt-2 d-none" style="font-size: 11px;">
                        <i class="bi bi-exclamation-octagon-fill me-1"></i> تم حظر الإشعارات مسبقاً. اضغط على أيقونة القفل بجانب الرابط للسماح بالإشعارات.
                    </div>
                </div>
            </div>
        </div>

        <% if (user && (user.role === 'admin' || user.role === 'super_admin')) { %>
        <!-- 2. تحكم خاص بالإدارة: إشعارات ملاحظات العملاء -->
        <div class="push-status-card p-3 p-sm-4 mb-3 border-start border-4 border-warning shadow-sm">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2.5 rounded-circle bg-warning bg-opacity-10 text-warning flex-shrink-0 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="bi bi-pencil-square fs-4 text-warning"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h6 class="fw-bold text-dark m-0">إشعارات ملاحظات العملاء</h6>
                            <span class="badge bg-warning-subtle text-dark border border-warning border-opacity-25 small py-0.5 px-2 rounded-pill" style="font-size: 10px;">خاص بالإدارة</span>
                        </div>
                        <p class="text-muted small m-0" style="font-size: 12px; line-height: 1.4;">
                            استلام إشعار وتنبيه ويب بوش فوري على أجهزتك عند قيام أي موظف بإضافة أو تعديل ملاحظة على أي عميل.
                        </p>
                    </div>
                </div>
                <div class="form-check form-switch m-0 fs-5 d-flex align-items-center gap-2">
                    <input class="form-check-input cursor-pointer" type="checkbox" role="switch" id="toggleAdminNotesPush" 
                           <%= (typeof notifyAdminOnNotes !== 'undefined' && notifyAdminOnNotes) ? 'checked' : '' %> 
                           onchange="toggleAdminNotesPushSetting(this.checked)" style="width: 2.75rem; height: 1.5rem;">
                    <label class="form-check-label small fw-semibold text-dark fs-6" for="toggleAdminNotesPush" id="toggleAdminNotesLabel">
                        <%= (typeof notifyAdminOnNotes !== 'undefined' && notifyAdminOnNotes) ? 'مفعل' : 'معطل' %>
                    </label>
                </div>
            </div>
        </div>

        <!-- 3. متابعة إشعارات فريق المبيعات (خاص بالمدير والمشرفين) -->
        <div class="push-status-card p-3 p-sm-4 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-people-fill text-primary fs-5"></i>
                    <h6 class="fw-bold text-dark m-0">إشعارات فريق المبيعات</h6>
                </div>
                <span class="badge bg-light text-secondary border px-2.5 py-1 rounded-pill small" style="font-size: 11px;">
                    <%= employeesPushStatus ? employeesPushStatus.length : 0 %> موظف
                </span>
            </div>

            <!-- عرض الموبايل (كروت متناسقة لكل موظف) -->
            <div class="d-block d-md-none">
                <% if (employeesPushStatus && employeesPushStatus.length > 0) { %>
                    <% employeesPushStatus.forEach(emp => { %>
                        <div class="emp-mobile-card">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-light border p-1 text-center text-primary fw-bold small d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 12px;">
                                        <%= (emp.fullName || emp.username).charAt(0).toUpperCase() %>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark small"><%= emp.fullName %></div>
                                        <div class="text-muted" style="font-size: 10px;">@<%= emp.username %> • <%= emp.role === 'super_admin' ? 'مدير' : (emp.role === 'admin' ? 'مشرف' : 'سيلز') %></div>
                                    </div>
                                </div>
                                <div>
                                    <% if (emp.isPushActive) { %>
                                        <span class="badge bg-success-subtle text-success border border-success border-opacity-25 px-2 py-1 rounded-pill small d-inline-flex align-items-center gap-1" style="font-size: 10px;">
                                            <span class="pulse-active"></span> مفعل
                                        </span>
                                    <% } else { %>
                                        <span class="badge bg-danger-subtle text-danger border border-danger border-opacity-25 px-2 py-1 rounded-pill small" style="font-size: 10px;">
                                            غير مفعل
                                        </span>
                                    <% } %>
                                </div>
                            </div>

                            <!-- الأجهزة المسجلة -->
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <% if (emp.devices && emp.devices.length > 0) { %>
                                    <% emp.devices.forEach(dev => { %>
                                        <span class="device-chip">
                                            <i class="bi <%= dev.deviceType === 'mobile' ? 'bi-phone text-success' : 'bi-laptop text-primary' %>"></i>
                                            <%= dev.browser || 'متصفح' %> (<%= dev.os || 'نظام' %>)
                                        </span>
                                    <% }) %>
                                <% } else { %>
                                    <span class="text-muted small fst-italic" style="font-size: 11px;">لا توجد أجهزة مسجلة</span>
                                <% } %>
                            </div>

                            <!-- زر التجربة -->
                            <button class="btn btn-sm btn-outline-primary rounded-pill w-100 py-1 fw-semibold small" 
                                onclick="sendTestPushToEmployee(<%= emp.id %>, '<%= emp.fullName %>')"
                                <%= !emp.isPushActive ? 'disabled' : '' %>>
                                <i class="bi bi-send me-1"></i> إرسال إشعار تجريبي للموظف
                            </button>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="text-center text-muted py-3 small">لا يوجد موظفين مسجلين</div>
                <% } %>
            </div>

            <!-- عرض الكمبيوتر والتابلت (جدول أنيق) -->
            <div class="d-none d-md-block table-responsive">
                <table class="table table-hover align-middle border-top mb-0">
                    <thead class="table-light">
                        <tr class="small text-secondary" style="font-size: 12px;">
                            <th>الموظف</th>
                            <th>الدور</th>
                            <th>حالة الإشعارات</th>
                            <th>الأجهزة المسجلة</th>
                            <th class="text-center">إجراء تجربة</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (employeesPushStatus && employeesPushStatus.length > 0) { %>
                            <% employeesPushStatus.forEach(emp => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle bg-light border p-2 text-center text-primary fw-bold" style="width: 36px; height: 36px; line-height: 18px; font-size: 13px;">
                                                <%= (emp.fullName || emp.username).charAt(0).toUpperCase() %>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark small"><%= emp.fullName %></div>
                                                <div class="text-muted small" style="font-size: 11px;">@<%= emp.username %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border small">
                                            <%= emp.role === 'super_admin' ? 'مدير عام' : (emp.role === 'admin' ? 'مشرف' : 'موظف مبيعات') %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (emp.isPushActive) { %>
                                            <span class="badge bg-success-subtle text-success border border-success border-opacity-25 px-2.5 py-1 rounded-pill d-inline-flex align-items-center gap-1 small">
                                                <span class="pulse-active"></span> مفعل (<%= emp.deviceCount %>)
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-danger-subtle text-danger border border-danger border-opacity-25 px-2 py-1 rounded-pill small">
                                                غير مفعل
                                            </span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (emp.devices && emp.devices.length > 0) { %>
                                            <div class="d-flex flex-wrap gap-1">
                                                <% emp.devices.forEach(dev => { %>
                                                    <span class="device-chip">
                                                        <i class="bi <%= dev.deviceType === 'mobile' ? 'bi-phone text-success' : 'bi-laptop text-primary' %>"></i>
                                                        <%= dev.browser || 'متصفح' %> (<%= dev.os || 'نظام' %>)
                                                    </span>
                                                <% }) %>
                                            </div>
                                        <% } else { %>
                                            <span class="text-muted small fst-italic">لا توجد أجهزة</span>
                                        <% } %>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold small" 
                                            onclick="sendTestPushToEmployee(<%= emp.id %>, '<%= emp.fullName %>')"
                                            <%= !emp.isPushActive ? 'disabled' : '' %>>
                                            <i class="bi bi-send me-1"></i> إرسال Test
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-3 text-muted small">لا يوجد موظفين مسجلين حالياً</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
        <% } %>

        <!-- 3. سجل الإشعارات الواردة -->
        <div class="push-status-card p-3 p-sm-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-inbox-fill text-primary fs-5"></i>
                    <h6 class="fw-bold text-dark m-0">سجل الإشعارات الواردة</h6>
                </div>
                <span class="text-muted small" id="totalNotificationsCount" style="font-size: 11px;"></span>
            </div>

            <!-- Loader -->
            <div id="loader" class="text-center py-4">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">جاري التحميل...</span>
                </div>
                <p class="text-muted small mt-2">جاري جلب الإشعارات...</p>
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="text-center py-4 d-none">
                <i class="bi bi-bell-slash text-secondary opacity-25" style="font-size: 3rem;"></i>
                <h6 class="text-muted mt-2">صندوق الإشعارات فارغ</h6>
                <p class="text-secondary small mb-0">لا توجد إشعارات حالية في حسابك.</p>
            </div>

            <!-- Notifications Container -->
            <div id="notificationsContainer" class="d-none">
                <!-- Dynamic cards rendered here -->
            </div>

            <!-- Pagination Grid -->
            <div id="paginationContainer" class="d-flex justify-content-between align-items-center mt-3 border-top pt-3 d-none">
                <span class="text-secondary small" id="paginationInfo" style="font-size: 11px;"></span>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm m-0" id="paginationList">
                        <!-- Dynamic Pagination links -->
                    </ul>
                </nav>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const VAPID_PUBLIC_KEY = "<%= vapidPublicKey || '' %>";
        let currentPage = 1;
        const limit = 10;
        let swRegistration = null;
        let currentPushSubscription = null;

        document.addEventListener("DOMContentLoaded", async () => {
            loadNotifications();
            await checkDevicePushStatus();
        });

        function urlBase64ToUint8Array(base64String) {
            const padding = '='.repeat((4 - base64String.length % 4) % 4);
            const base64 = (base64String + padding)
                .replace(/\-/g, '+')
                .replace(/_/g, '/');
            const rawData = window.atob(base64);
            const outputArray = new Uint8Array(rawData.length);
            for (let i = 0; i < rawData.length; ++i) {
                outputArray[i] = rawData.charCodeAt(i);
            }
            return outputArray;
        }

        async function checkDevicePushStatus() {
            const statusBadge = document.getElementById('currentDeviceStatusBadge');
            const btnEnable = document.getElementById('btnEnablePush');
            const btnDisable = document.getElementById('btnDisablePush');
            const btnTest = document.getElementById('btnTestPush');
            const permSpan = document.getElementById('detectedPermission');
            const browserSpan = document.getElementById('detectedBrowser');
            const deniedNotice = document.getElementById('permissionDeniedNotice');
            const currentDeviceType = document.getElementById('currentDeviceType');

            const isMobile = /android|iphone|ipad|ipod|mobile/i.test(navigator.userAgent);
            currentDeviceType.textContent = isMobile ? 'موبايل' : 'كمبيوتر';

            let bName = 'Chrome';
            if (navigator.userAgent.includes('Edg/')) bName = 'Edge';
            else if (navigator.userAgent.includes('Firefox/')) bName = 'Firefox';
            else if (navigator.userAgent.includes('Safari/') && !navigator.userAgent.includes('Chrome')) bName = 'Safari';
            browserSpan.textContent = bName;

            if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
                statusBadge.className = 'badge bg-warning-subtle text-warning border border-warning';
                statusBadge.textContent = 'غير مدعوم على متصفحك';
                return;
            }

            permSpan.textContent = Notification.permission === 'granted' ? 'مسموح به ✅' : (Notification.permission === 'denied' ? 'محظور ❌' : 'في الانتظار ⏳');

            try {
                swRegistration = await navigator.serviceWorker.register('/sw.js');
                currentPushSubscription = await swRegistration.pushManager.getSubscription();

                if (currentPushSubscription && Notification.permission === 'granted') {
                    statusBadge.className = 'badge bg-success-subtle text-success border border-success border-opacity-25 px-2.5 py-1 rounded-pill small';
                    statusBadge.innerHTML = '<span class="pulse-active"></span> مفعل ومستعد';
                    btnEnable.classList.add('d-none');
                    btnDisable.classList.remove('d-none');
                    btnTest.classList.remove('d-none');
                    deniedNotice.classList.add('d-none');
                } else if (Notification.permission === 'denied') {
                    statusBadge.className = 'badge bg-danger-subtle text-danger border border-danger border-opacity-25 small';
                    statusBadge.textContent = 'الإشعار محظور';
                    btnEnable.classList.add('d-none');
                    btnDisable.classList.add('d-none');
                    btnTest.classList.add('d-none');
                    deniedNotice.classList.remove('d-none');
                } else {
                    statusBadge.className = 'badge bg-secondary-subtle text-secondary border small';
                    statusBadge.textContent = 'غير مفعل';
                    btnEnable.classList.remove('d-none');
                    btnDisable.classList.add('d-none');
                    btnTest.classList.add('d-none');
                    deniedNotice.classList.add('d-none');
                }
            } catch (err) {
                console.error('SW check error:', err);
                statusBadge.className = 'badge bg-danger small';
                statusBadge.textContent = 'خطأ بالفحص';
            }
        }

        async function enablePushOnThisDevice() {
            if (!VAPID_PUBLIC_KEY) {
                showAlert('مفتاح VAPID العام غير متوفر.', 'danger');
                return;
            }

            try {
                const permission = await Notification.requestPermission();
                if (permission !== 'granted') {
                    checkDevicePushStatus();
                    showAlert('تم رفض إذن الإشعارات من المتصفح.', 'warning');
                    return;
                }

                if (!swRegistration) {
                    swRegistration = await navigator.serviceWorker.register('/sw.js');
                }

                const applicationServerKey = urlBase64ToUint8Array(VAPID_PUBLIC_KEY);
                const subscription = await swRegistration.pushManager.subscribe({
                    userVisibleOnly: true,
                    applicationServerKey
                });

                const res = await fetch('/dashboard/push/subscribe', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ subscription })
                });

                const data = await res.json();
                if (data.success) {
                    showAlert('🎉 تم تفعيل إشعارات هذا الجهاز بنجاح!', 'success');
                    await checkDevicePushStatus();
                    setTimeout(() => sendTestPushToMe(), 500);
                } else {
                    showAlert('فشل التفعيل: ' + (data.error || 'خطأ غير معروف'), 'danger');
                }
            } catch (err) {
                console.error('Error enabling push:', err);
                showAlert('حدث خطأ أثناء التفعيل: ' + err.message, 'danger');
            }
        }

        async function disablePushOnThisDevice() {
            if (!confirm('هل أنت متأكد من تعطيل الإشعارات على هذا الجهاز؟')) return;

            try {
                if (currentPushSubscription) {
                    const endpoint = currentPushSubscription.endpoint;
                    await currentPushSubscription.unsubscribe();
                    
                    await fetch('/dashboard/push/unsubscribe', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ endpoint })
                    });
                }
                showAlert('تم تعطيل الإشعارات لهذا الجهاز.', 'info');
                await checkDevicePushStatus();
            } catch (err) {
                showAlert('حدث خطأ أثناء التعطيل: ' + err.message, 'danger');
            }
        }

        async function sendTestPushToMe() {
            try {
                showAlert('جاري إرسال الإشعار التجريبي...', 'info');
                const res = await fetch('/dashboard/push/test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({})
                });
                const data = await res.json();
                if (data.success) {
                    showAlert('✅ تم إرسال الإشعار بنجاح! راجع شاشة هاتفك الآن.', 'success');
                } else {
                    showAlert(data.message || 'فشل إرسال الإشعار التجريبي.', 'warning');
                }
            } catch (err) {
                showAlert('حدث خطأ: ' + err.message, 'danger');
            }
        }

        async function sendTestPushToEmployee(empId, empName) {
            try {
                showAlert(`جاري إرسال إشعار تجريبي للموظف ${empName}...`, 'info');
                const res = await fetch('/dashboard/push/test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ userId: empId })
                });
                const data = await res.json();
                if (data.success) {
                    showAlert(`✅ تم إرسال إشعار بنجاح إلى أجهزة ${empName}!`, 'success');
                } else {
                    showAlert(data.message || 'لم يتم الإرسال.', 'warning');
                }
            } catch (err) {
                showAlert('حدث خطأ: ' + err.message, 'danger');
            }
        }

        async function toggleAdminNotesPushSetting(enabled) {
            const label = document.getElementById('toggleAdminNotesLabel');
            if (label) label.textContent = enabled ? 'مفعل' : 'معطل';
            try {
                const res = await fetch('/dashboard/notifications/toggle-notes-push', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled })
                });
                const data = await res.json();
                if (data.success) {
                    showAlert(enabled ? '✅ تم تفعيل إشعارات ملاحظات الموظفين بنجاح.' : 'ℹ️ تم تعطيل إشعارات ملاحظات الموظفين.', 'success');
                } else {
                    showAlert('فشل حفظ الإعداد: ' + (data.error || 'خطأ غير معروف'), 'danger');
                }
            } catch (err) {
                showAlert('خطأ في الاتصال بالسيرفر: ' + err.message, 'danger');
            }
        }

        function loadNotifications(page = 1) {
            currentPage = page;

            document.getElementById('loader').classList.remove('d-none');
            document.getElementById('notificationsContainer').classList.add('d-none');
            document.getElementById('emptyState').classList.add('d-none');
            document.getElementById('paginationContainer').classList.add('d-none');

            const url = `/dashboard/notifications/data?page=${page}&limit=${limit}`;

            fetch(url)
                .then(res => res.json())
                .then(res => {
                    document.getElementById('loader').classList.add('d-none');
                    if (res.success && res.notifications && res.notifications.length > 0) {
                        renderNotificationsList(res.notifications);
                        renderPagination(res.page, res.totalPages, res.totalCount);
                        
                        const countSpan = document.getElementById('totalNotificationsCount');
                        if (countSpan) countSpan.textContent = `(إجمالي ${res.totalCount})`;

                        document.getElementById('notificationsContainer').classList.remove('d-none');
                        document.getElementById('paginationContainer').classList.remove('d-none');
                    } else {
                        document.getElementById('emptyState').classList.remove('d-none');
                    }
                })
                .catch(err => {
                    document.getElementById('loader').classList.add('d-none');
                    showAlert('حدث خطأ أثناء تحميل الإشعارات.', 'danger');
                });
        }

        function formatDateTime(date) {
            if (!date) return '—';
            const d = new Date(date);
            if (isNaN(d.getTime())) return '—';
            const day = String(d.getDate()).padStart(2, '0');
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const year = d.getFullYear();
            let hours = d.getHours();
            const minutes = String(d.getMinutes()).padStart(2, '0');
            const ampm = hours >= 12 ? 'م' : 'ص';
            hours = hours % 12;
            hours = hours ? hours : 12;
            const strHours = String(hours).padStart(2, '0');
            return `${day}/${month}/${year} ${strHours}:${minutes} ${ampm}`;
        }

        function renderNotificationsList(notifications) {
            const container = document.getElementById('notificationsContainer');
            container.innerHTML = '';

            notifications.forEach(notif => {
                const isUnreadClass = notif.isRead ? '' : 'notif-unread';
                const dateStr = notif.createdAt ? formatDateTime(notif.createdAt) : '—';
                
                let iconClass = 'icon-system';
                let iconSymbol = 'bi-bell-fill';
                if (notif.type === 'customer_assigned') {
                    iconClass = 'icon-customer_assigned';
                    iconSymbol = 'bi-person-plus-fill';
                } else if (notif.type === 'status_changed') {
                    iconClass = 'icon-status_changed';
                    iconSymbol = 'bi-arrow-left-right';
                } else if (notif.type === 'payment_received') {
                    iconClass = 'icon-payment_received';
                    iconSymbol = 'bi-credit-card-fill';
                } else if (notif.type === 'follow_up_due') {
                    iconClass = 'icon-follow_up_due';
                    iconSymbol = 'bi-calendar-event';
                } else if (notif.type === 'customer_note') {
                    iconClass = 'icon-customer_note';
                    iconSymbol = 'bi-pencil-square';
                }

                let customerLinkHtml = '';
                if (notif.customer) {
                    customerLinkHtml = `
                        <div class="mt-2 pt-2 border-top d-flex flex-wrap align-items-center justify-content-between gap-1">
                            <div>
                                <span class="small text-dark fw-bold">${notif.customer.customerName || 'عميل واتساب'}</span>
                                <code class="small text-secondary">(${notif.customer.phoneNumber})</code>
                            </div>
                            <div>
                                <a href="/dashboard/livechat?customerId=${notif.customer.id}" class="btn btn-sm btn-outline-success rounded-pill px-2.5 py-0.5 fw-semibold text-decoration-none" style="font-size: 11px;">
                                    <i class="bi bi-chat-dots-fill me-1"></i> فتح الشات
                                </a>
                            </div>
                        </div>
                    `;
                }

                const cardHtml = `
                    <div class="notif-card ${isUnreadClass}" id="notif-card-${notif.id}">
                        <div class="d-flex align-items-start gap-2.5">
                            <div class="notif-icon-box ${iconClass}">
                                <i class="bi ${iconSymbol} fs-6"></i>
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="m-0 fw-bold text-dark small text-truncate">${notif.title}</h6>
                                    <span class="text-muted" style="font-size: 10px;">${dateStr}</span>
                                </div>
                                <p class="text-secondary small mb-0" style="line-height: 1.35; font-size: 12px;">${notif.message}</p>
                                ${customerLinkHtml}
                            </div>
                            ${!notif.isRead ? `
                            <button class="btn btn-sm btn-outline-primary rounded-pill p-1 px-2 flex-shrink-0 align-self-start" style="font-size: 10px;" onclick="markSingleReadPage(${notif.id})">
                                مقروء
                            </button>
                            ` : ''}
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', cardHtml);
            });
        }

        function markSingleReadPage(id) {
            fetch('/dashboard/notifications/mark-read', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const card = document.getElementById(`notif-card-${id}`);
                    if (card) {
                        card.classList.remove('notif-unread');
                        const btn = card.querySelector('button');
                        if (btn) btn.remove();
                    }
                    if (typeof loadNotificationsData === 'function') {
                        loadNotificationsData();
                    }
                }
            })
            .catch(err => console.error(err));
        }

        function markAllReadOnPage() {
            fetch('/dashboard/notifications/mark-read', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ all: true })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showAlert('تم تحديد جميع الإشعارات كمقروءة.', 'success');
                    loadNotifications(currentPage);
                    if (typeof loadNotificationsData === 'function') {
                        loadNotificationsData();
                    }
                }
            })
            .catch(err => console.error(err));
        }

        function renderPagination(page, totalPages, totalCount) {
            const info = document.getElementById('paginationInfo');
            const list = document.getElementById('paginationList');

            info.textContent = `عرض ${(page - 1) * limit + 1} إلى ${Math.min(page * limit, totalCount)} من ${totalCount}`;
            list.innerHTML = '';

            const prevDisabled = page === 1 ? 'disabled' : '';
            list.insertAdjacentHTML('beforeend', `
                <li class="page-item ${prevDisabled}">
                    <button class="page-link" onclick="loadNotifications(${page - 1})">&laquo;</button>
                </li>
            `);

            let startPage = Math.max(1, page - 1);
            let endPage = Math.min(totalPages, page + 1);

            for (let i = startPage; i <= endPage; i++) {
                const active = i === page ? 'active' : '';
                list.insertAdjacentHTML('beforeend', `
                    <li class="page-item ${active}">
                        <button class="page-link" onclick="loadNotifications(${i})">${i}</button>
                    </li>
                `);
            }

            const nextDisabled = page === totalPages ? 'disabled' : '';
            list.insertAdjacentHTML('beforeend', `
                <li class="page-item ${nextDisabled}">
                    <button class="page-link" onclick="loadNotifications(${page + 1})">&raquo;</button>
                </li>
            `);
        }

        function showAlert(msg, type = 'success') {
            const container = document.getElementById('alertContainer');
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show rounded-3 shadow py-2 px-3 mb-2" role="alert" style="font-size: 13px;">
                    <i class="bi ${type === 'success' ? 'bi-check-circle-fill text-success' : 'bi-info-circle-fill text-primary'} me-1"></i> 
                    ${msg}
                    <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            container.innerHTML = alertHtml;
            setTimeout(() => {
                const alert = container.querySelector('.alert');
                if (alert) {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }
            }, 4000);
        }
    </script>
</body>

</html>
