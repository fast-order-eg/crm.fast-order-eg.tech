<nav class="navbar navbar-expand-lg navbar-light fixed-top">
    <div class="container-fluid px-3 px-lg-5 flex-nowrap">
        <div class="d-flex align-items-center gap-3">
            <!-- Mobile Toggle -->
            <button id="mobile-menu-btn" class="btn d-lg-none p-2 rounded-circle border d-flex align-items-center justify-content-center"
                style="background: rgba(212, 175, 55, 0.1); border-color: rgba(212, 175, 55, 0.3) !important; color: var(--primary-hover); width: 40px; height: 40px;"
                title="القائمة" aria-label="القائمة">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor"
                    class="bi bi-list" viewBox="0 0 16 16">
                    <path fill-rule="evenodd"
                        d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z" />
                </svg>
            </button>

            <a class="navbar-brand d-flex align-items-center gap-2" href="/dashboard">
                <img src="/bird_crm_logo.png" alt="Logo" class="rounded-circle"
                    style="width: 44px; height: 44px; object-fit: cover;">
                <div class="d-flex" dir="ltr">
                    <span class="fw-bold">Bird</span>&nbsp;<span
                        class="text-primary fw-bold">CRM</span>
                </div>
            </a>
        </div>

        <div class="d-flex align-items-center gap-3">
            <!-- حاوية التنبيهات الفورية Toasts -->
            <div id="navbarToastContainer" class="position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 1100;"></div>

            <div class="dropdown">
                <!-- Dropdown Toggle Fix: Added id and ensured data-bs-toggle is working -->
                <button class="btn btn-user-premium dropdown-toggle d-flex align-items-center gap-2 shadow-sm"
                    type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="user-avatar-small position-relative">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor"
                            class="bi bi-person-fill" viewBox="0 0 16 16">
                            <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6" />
                        </svg>
                        <!-- شارة الإشعارات على زر المستخدم -->
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" id="notificationBadge" style="z-index: 10; padding: 0.35em 0.5em; font-size: 0.65em;">
                            0
                        </span>
                    </div>
                    <span class="d-none d-md-inline fw-semibold text-secondary">مرحباً، <span class="text-dark">
                            <%= user.fullName || user.username %>
                        </span></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-start shadow border-primary border-opacity-25 mt-2 animate-slide-in text-end"
                    style="width: 320px; max-height: 480px; overflow-y: hidden;">
                    <!-- معلومات المستخدم -->
                    <li class="p-2.5 border-bottom bg-light d-flex align-items-center justify-content-between">
                        <span class="fw-bold small text-secondary">👤 <%= user.fullName || user.username %></span>
                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1" style="font-size: 10px; font-weight: 500;">
                            <%= user.role === 'super_admin' ? 'مدير النظام' : (user.role === 'admin' ? 'مشرف' : 'موظف مبيعات') %>
                        </span>
                    </li>
                    <!-- الإشعارات الأخيرة -->
                    <li class="p-2 border-bottom d-flex justify-content-between align-items-center bg-white">
                        <span class="fw-bold small">🔔 الإشعارات الأخيرة</span>
                        <button class="btn btn-sm btn-link text-primary p-0 text-decoration-none small fw-semibold" onclick="markAllNotificationsAsRead(event)">تحديد الكل كمقروء</button>
                    </li>
                    <!-- قائمة الإشعارات الفرعية -->
                    <li style="max-height: 250px; overflow-y: auto;">
                        <ul class="list-unstyled mb-0" id="notificationList">
                            <li class="text-center py-3 text-muted small" id="noNotificationsItem">لا توجد إشعارات جديدة</li>
                        </ul>
                    </li>
                    <!-- عرض كل الإشعارات -->
                    <li class="border-top border-bottom text-center bg-light">
                        <a href="/dashboard/notifications" class="d-block py-2 small text-primary text-decoration-none fw-semibold">عرض كل الإشعارات</a>
                    </li>
                    <!-- تسجيل الخروج -->
                    <li>
                        <a class="dropdown-item py-2.5 text-danger d-flex align-items-center justify-content-between fw-semibold" href="/logout">
                            <span>تسجيل خروج</span>
                            <i class="bi bi-box-arrow-right ms-2"></i>
                        </a>
                    </li>
                </ul>
            </div>

        </div>
</nav>

<script>
    window.showToast = function(msg, type = 'success') {
        const container = document.getElementById('navbarToastContainer');
        if (!container) return;
        const bgClass = type === 'success' ? 'bg-success' : 'bg-danger';
        const icon = type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';
        const toastHtml = `
            <div class="toast show align-items-center text-white ${bgClass} border-0 mb-2 shadow" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 12px; backdrop-filter: blur(10px); background: ${type === 'success' ? 'rgba(25, 135, 84, 0.95)' : 'rgba(220, 53, 69, 0.95)'} !important; min-width: 250px;">
                <div class="d-flex text-end">
                    <div class="toast-body p-3" style="flex: 1; direction: rtl;">
                        <i class="bi ${icon} me-2"></i>
                        ${msg}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        `;
        container.insertAdjacentHTML('beforeend', toastHtml);
        const toastElement = container.lastElementChild;
        setTimeout(() => {
            if (toastElement) {
                toastElement.classList.remove('show');
                toastElement.remove();
            }
        }, 4000);
    };

    document.addEventListener('DOMContentLoaded', () => {
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.getElementById('sidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        const closeBtn = document.getElementById('sidebarCloseBtn');

        function toggleSidebar(open) {
            if (!sidebar) return;
            const shouldOpen = open !== undefined ? open : !sidebar.classList.contains('mobile-active');
            if (shouldOpen) {
                sidebar.classList.add('mobile-active');
                if (backdrop) backdrop.classList.add('show');
                document.body.style.overflow = 'hidden';
            } else {
                sidebar.classList.remove('mobile-active');
                if (backdrop) backdrop.classList.remove('show');
                document.body.style.overflow = '';
            }
        }

        if (mobileBtn) {
            mobileBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                toggleSidebar();
            });
        }

        if (closeBtn) {
            closeBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                toggleSidebar(false);
            });
        }

        if (backdrop) {
            backdrop.addEventListener('click', () => {
                toggleSidebar(false);
            });
        }

        // Close sidebar when clicking outside on mobile
        document.addEventListener('click', (e) => {
            if (window.innerWidth < 992 && sidebar && sidebar.classList.contains('mobile-active')) {
                if (!sidebar.contains(e.target) && (!mobileBtn || !mobileBtn.contains(e.target))) {
                    toggleSidebar(false);
                }
            }
        });

        // --- منطق نظام الإشعارات الداخلية ---
        const currentUserId = '<%= user.id %>';

        // تحميل الإشعارات وعددها عند التحميل
        loadNotificationsData();

        function loadNotificationsData() {
            // جلب عدد الإشعارات غير المقروءة
            fetch('/dashboard/notifications/unread-count')
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        updateNotificationBadge(data.count);
                    }
                })
                .catch(err => console.error('Error fetching unread count:', err));

            // جلب آخر 5 إشعارات
            fetch('/dashboard/notifications/data?limit=5')
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.notifications) {
                        renderNavbarNotifications(data.notifications);
                    }
                })
                .catch(err => console.error('Error fetching notifications:', err));
        }

        function updateNotificationBadge(count) {
            const badge = document.getElementById('notificationBadge');
            if (badge) {
                if (count > 0) {
                    badge.textContent = count;
                    badge.classList.remove('d-none');
                } else {
                    badge.classList.add('d-none');
                }
            }
        }

        function renderNavbarNotifications(notifications) {
            const list = document.getElementById('notificationList');
            if (!list) return;

            if (notifications.length === 0) {
                list.innerHTML = '<li class="text-center py-3 text-muted small" id="noNotificationsItem">لا توجد إشعارات جديدة</li>';
                return;
            }

            list.innerHTML = '';
            notifications.forEach(notif => {
                const isUnreadClass = notif.isRead ? '' : 'bg-light fw-bold';
                const dateStr = notif.createdAt ? new Date(notif.createdAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true }) : '';
                
                let iconClass = 'bi-bell-fill text-primary';
                if (notif.type === 'customer_assigned') iconClass = 'bi-person-plus-fill text-success';
                else if (notif.type === 'status_changed') iconClass = 'bi-arrow-left-right text-warning';
                else if (notif.type === 'payment_received') iconClass = 'bi-credit-card-fill text-info';
                else if (notif.type === 'follow_up_due') iconClass = 'bi-calendar-event text-danger';

                const itemHtml = `
                    <li class="border-bottom p-2 ${isUnreadClass} notification-item-dropdown" style="cursor: pointer; transition: background 0.2s;" onclick="markNotificationSingleRead(${notif.id}, this)">
                        <div class="d-flex align-items-start gap-2">
                            <div class="p-1 rounded-circle bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                                <i class="bi ${iconClass}"></i>
                            </div>
                            <div style="flex: 1;">
                                <div class="small fw-semibold text-dark">${notif.title}</div>
                                <div class="text-secondary" style="font-size: 11px; line-height: 1.3;">${notif.message}</div>
                                <div class="text-muted text-start mt-1" style="font-size: 10px;">${dateStr}</div>
                            </div>
                        </div>
                    </li>
                `;
                list.insertAdjacentHTML('beforeend', itemHtml);
            });
        }

        window.markNotificationSingleRead = function(id, element) {
            fetch('/dashboard/notifications/mark-read', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (element) {
                        element.classList.remove('bg-light', 'fw-bold');
                    }
                    // تحديث العداد
                    const badge = document.getElementById('notificationBadge');
                    if (badge) {
                        const currentCount = parseInt(badge.textContent) || 0;
                        if (currentCount > 0) updateNotificationBadge(currentCount - 1);
                    }
                }
            })
            .catch(err => console.error('Error marking single notification read:', err));
        };

        window.markAllNotificationsAsRead = function(event) {
            if (event) event.stopPropagation();
            fetch('/dashboard/notifications/mark-read', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ all: true })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    updateNotificationBadge(0);
                    const items = document.querySelectorAll('.notification-item-dropdown');
                    items.forEach(item => item.classList.remove('bg-light', 'fw-bold'));
                }
            })
            .catch(err => console.error('Error marking all notifications read:', err));
        };

        function showNotificationToast(title, message) {
            const container = document.getElementById('navbarToastContainer');
            if (!container) return;
            const toastHtml = `
                <div class="toast show align-items-center text-white bg-primary border-0 mb-2 shadow" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 12px; backdrop-filter: blur(10px); background: rgba(13, 110, 253, 0.9) !important; min-width: 250px;">
                    <div class="d-flex">
                        <div class="toast-body text-end p-3" style="flex: 1;">
                            <strong class="d-block mb-1">🔔 ${title}</strong>
                            <span class="small">${message}</span>
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            `;
            container.insertAdjacentHTML('beforeend', toastHtml);
            const toastElement = container.lastElementChild;
            setTimeout(() => {
                if (toastElement) {
                    toastElement.classList.remove('show');
                    toastElement.remove();
                }
            }, 5000);
        }

        // إعداد اتصال Socket.IO الفوري ديناميكياً
        function initializeSocketAndNotifications() {
            if (typeof io !== 'undefined') {
                const socket = io();
                window.socket = socket; // Expose globally for other pages
                
                // الانضمام لغرفة المستخدم
                socket.emit('join_room', `user_${currentUserId}`);
                console.log(`🔌 Connected to notifications room: user_${currentUserId}`);

                // الاستماع للإشعارات الجديدة
                socket.on('notification', (data) => {
                    console.log('🔔 New notification received:', data);
                    
                    // تحديث العداد
                    const badge = document.getElementById('notificationBadge');
                    const currentCount = badge && !badge.classList.contains('d-none') ? parseInt(badge.textContent) || 0 : 0;
                    updateNotificationBadge(currentCount + 1);

                    // عرض التنبيه الفوري
                    showNotificationToast(data.title, data.message);

                    // إعادة تحميل قائمة الـ dropdown
                    loadNotificationsData();

                    // إذا كنا في صفحة الإشعارات الكاملة، نقوم بتحديث البيانات هناك أيضاً
                    if (typeof loadNotifications === 'function') {
                        loadNotifications();
                    }
                });
            }
        }

        // تحميل مكتبة Socket.IO ديناميكياً إذا لم تكن موجودة
        if (typeof io === 'undefined') {
            const script = document.createElement('script');
            script.src = '/socket.io/socket.io.js';
            script.onload = () => initializeSocketAndNotifications();
            document.head.appendChild(script);
        } else {
            initializeSocketAndNotifications();
        }
    });
</script>
