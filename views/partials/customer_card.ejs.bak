`
<div class="customer-card-mobile animate-fade-in" id="card-${cust.id}">
    <div class="d-flex justify-content-between align-items-start border-bottom pb-2 mb-2">
        <div>
            <h6 class="fw-bold text-dark mb-0">${cust.customerName || 'عميل واتساب'}</h6>
            <code class="text-secondary small">${cust.phoneNumber}</code>
        </div>
        <div>
            <a href="https://wa.me/${cust.phoneNumber}" target="_blank" class="btn btn-sm btn-outline-success px-2 py-1 rounded me-1" title="محادثة واتساب">
                <i class="bi bi-whatsapp"></i>
            </a>
            <button class="btn btn-sm btn-outline-info px-2 py-1 rounded" onclick="showCustomerDetails(${cust.id}, \${serialNum})" title="عرض التفاصيل">
                <i class="bi bi-person-lines-fill"></i>
            </button>
        </div>
    </div>
    <div class="row g-2 small mb-3">
        ${assigneeSelect}

        <div class="col-6 mb-2">
            <strong class="small text-secondary d-block">الحالة:</strong>
            <select class="status-select status-${cust.status} form-select-sm mt-1 w-100 border-0 shadow-sm" onchange="updateStatus(${cust.id}, this.value)">
                ${statusOptions}
            </select>
        </div>

        ${(() => {
                if (cust.scheduledFollowUpAt) {
                    const formatted = formatDateTime(cust.scheduledFollowUpAt);
                    if (cust.status === 'scheduled_follow_up') {
                        return `<div class="small text-muted mt-1" style="font-size: 11px;"><i class="bi bi-clock me-1 text-primary"></i> ${formatted}</div>`;
                    } else if (cust.status === 'first_follow_up') {
                        return `<div class="small text-muted mt-1" style="font-size: 11px;"><i class="bi bi-clock me-1 text-warning"></i> ${formatted}</div>`;
                    } else if (cust.status === 'final_follow_up') {
                        return `<div class="small text-muted mt-1" style="font-size: 11px;"><i class="bi bi-clock me-1 text-danger"></i> ${formatted}</div>`;
                    }
                }
                return '';
            })()}
        <div class="col-12">
            <strong class="small text-secondary d-block mb-1">حالة الدفع:</strong>
            <div class="d-flex align-items-center gap-2 mt-1">
                <span class="payment-badge payment-${cust.paymentStatus || 'pending'} m-0">
                    ${cust.paymentStatus === 'receipt_uploaded' ? 'تم رفع الإيصال' : 
                      cust.paymentStatus === 'confirmed' ? 'مؤكد' : 
                      cust.paymentStatus === 'rejected' ? 'مرفوض' : 'قيد الانتظار'}
                </span>
                ${cust.paymentReceiptUrl ? `
                    <a href="${cust.paymentReceiptUrl}" target="_blank" class="btn btn-sm btn-outline-info py-0 px-2" style="font-size: 11px;">
                        <i class="bi bi-image"></i> الإيصال
                    </a>
                ` : ''}
                ${(role === 'super_admin' || role === 'admin') && cust.paymentStatus === 'receipt_uploaded' ? `
                    <button class="btn btn-sm btn-success py-0 px-2 text-white" style="font-size: 11px;" onclick="updatePaymentStatus(${cust.id}, 'confirmed')">
                        <i class="bi bi-check-lg"></i>
                    </button>
                    <button class="btn btn-sm btn-danger py-0 px-2 text-white" style="font-size: 11px;" onclick="updatePaymentStatus(${cust.id}, 'rejected')">
                        <i class="bi bi-x-lg"></i>
                    </button>
                ` : ''}
            </div>
        </div>
    </div>
</div>
`
