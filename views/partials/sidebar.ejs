<div id="sidebar" class="fancy-sidebar">
    <div class="sidebar-header text-center d-none d-lg-block">
        <img src="/bird_crm_logo.png" alt="Bird CRM" class="sidebar-logo rounded-circle border border-primary border-2 shadow">
    </div>
    <% 
    const role = user ? user.role : 'sales';
    const isSuperAdmin = role === 'super_admin';
    const isAdmin = role === 'super_admin' || role === 'admin';
    const isSales = role === 'sales';
    %>
    <ul class="sidebar-menu">
        <!-- 1. الرئيسية (Dashboard) -->
        <li class="sidebar-item <%= page === 'home' ? 'active' : '' %>">
            <a href="/dashboard" class="sidebar-link">
                <div class="sidebar-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zm8 0A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm-8 8A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm8 0A1.5 1.5 0 0 1 10.5 9h3A1.5 1.5 0 0 1 15 10.5v3A1.5 1.5 0 0 1 13.5 15h-3A1.5 1.5 0 0 1 9 13.5v-3z" />
                    </svg>
                </div>
                <span class="sidebar-label">الرئيسية</span>
            </a>
        </li>

        <!-- 2. العملاء (Customers) -->
        <li class="sidebar-item <%= page === 'customers' ? 'active' : '' %>">
            <a href="/dashboard/customers" class="sidebar-link">
                <div class="sidebar-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1zm-7.978-3.07a.5.5 0 0 1 .402.646l-.5 2a.5.5 0 1 1-.97-.242l.5-2a.5.5 0 0 1 .568-.404zM3 14s-1 0-1-1 1-4 5-4a12.22 12.22 0 0 1 .979.041c-.482.44-.848 1.01-1.025 1.66A5.253 5.253 0 0 0 3 14zm3-11a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm4.5 0a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM8 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"/>
                    </svg>
                </div>
                <span class="sidebar-label">العملاء</span>
            </a>
        </li>

        <% if (isAdmin) { %>
        <!-- 3. الموظفين (Employees) -->
        <li class="sidebar-item <%= page === 'employees' ? 'active' : '' %>">
            <a href="/dashboard/employees" class="sidebar-link">
                <div class="sidebar-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1zm-7.978-3.07a.5.5 0 0 1 .402.646l-.5 2a.5.5 0 1 1-.97-.242l.5-2a.5.5 0 0 1 .568-.404zM3 14s-1 0-1-1 1-4 5-4a12.22 12.22 0 0 1 .979.041c-.482.44-.848 1.01-1.025 1.66A5.253 5.253 0 0 0 3 14zm3-11a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm4.5 0a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM8 8a2 2 0 1 1-4 0 2 2 0 0 1 4 0z"/>
                    </svg>
                </div>
                <span class="sidebar-label">الموظفين</span>
            </a>
        </li>

        <!-- 4. الأزرار التفاعلية (Buttons) -->
        <li class="sidebar-item <%= page === 'buttons' ? 'active' : '' %>">
            <a href="/dashboard/buttons" class="sidebar-link">
                <div class="sidebar-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2zm2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H4z"/>
                        <path d="M5 4h6a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5H5a.5.5 0 0 1-.5-.5v-1A.5.5 0 0 1 5 4zm0 3h6a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5H5a.5.5 0 0 1-.5-.5v-1A.5.5 0 0 1 5 7zm0 3h6a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5H5a.5.5 0 0 1-.5-.5v-1A.5.5 0 0 1 5 10z"/>
                    </svg>
