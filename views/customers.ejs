                        newModal.hide();
                    }
                    
                    // Reload data
                    loadData(1);
                } else {
                    showAlert(res.error || 'فشل إضافة العميل.', 'danger');
                }
            })
            .catch(err => {
                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
                console.error(err);
                showAlert('خطأ في الاتصال بالسيرفر. يرجى المحاولة لاحقاً.', 'danger');
            });
