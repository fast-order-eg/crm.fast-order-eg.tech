                    phoneNumber = '2' + cleaned;
                } else if (cleaned.length === 10 && (cleaned.startsWith('10') || cleaned.startsWith('11') || cleaned.startsWith('12') || cleaned.startsWith('15'))) {
                    phoneNumber = '20' + cleaned;
