            savingNotesMap[id] = true;

            const textareas = document.querySelectorAll(`#row-${id} .notes-textarea, #card-${id} .notes-textarea`);
            textareas.forEach(ta => { ta.disabled = true; ta.style.opacity = '0.5'; });

            fetch('/dashboard/customers/update-notes', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id, notes: newNotes })
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    showAlert('تم حفظ الملاحظات بنجاح.');
                    textareas.forEach(ta => ta.value = newNotes);
                } else {
                    showAlert(res.error || 'فشل تحديث الملاحظات.', 'danger');
                }
            })
            .catch(err => {
                console.error(err);
                showAlert('خطأ في الاتصال بالسيرفر.', 'danger');
