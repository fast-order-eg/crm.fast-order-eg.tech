<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة ومتابعة العملاء - Bird-CRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="/style.css?v=<%= Date.now() %>" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        .status-badge {
            font-size: 11px;
            padding: 5px 10px;
            border-radius: 50px;
            font-weight: 600;
            display: inline-block;
            text-align: center;
        }
        .status-select {
            font-size: 12px;
            padding: 4px 8px;
            border-radius: 8px;
            font-weight: 600;
            border: 1px solid rgba(0,0,0,0.1);
            cursor: pointer;
        }
        .status-new { background-color: rgba(13, 110, 253, 0.1) !important; color: #0d6efd !important; }
        .status-in_funnel { background-color: rgba(108, 117, 125, 0.1) !important; color: #6c757d !important; }
        .status-awaiting_payment { background-color: rgba(255, 193, 7, 0.15) !important; color: #b8860b !important; }
        .status-awaiting_sales { background-color: rgba(255, 159, 67, 0.15) !important; color: #ff9f43 !important; }
        .status-first_follow_up { background-color: rgba(0, 210, 188, 0.15) !important; color: #00b5ad !important; }
        .status-final_follow_up { background-color: rgba(235, 94, 40, 0.15) !important; color: #eb5e28 !important; }
        .status-scheduled_follow_up { background-color: rgba(111, 66, 193, 0.1) !important; color: #6f42c1 !important; }
        .status-successful { background-color: rgba(25, 135, 84, 0.1) !important; color: #198754 !important; }
        .status-not_interested { background-color: rgba(220, 53, 69, 0.1) !important; color: #dc3545 !important; }

        .payment-badge {
            font-size: 11px;
            padding: 4px 8px;
            border-radius: 8px;
            font-weight: 600;
            display: inline-block;
            text-align: center;
        }
        .payment-pending { background-color: rgba(108, 117, 125, 0.15) !important; color: #6c757d !important; }
        .payment-receipt_uploaded { background-color: rgba(13, 110, 253, 0.15) !important; color: #0d6efd !important; }
        .payment-confirmed { background-color: rgba(25, 135, 84, 0.15) !important; color: #198754 !important; }
        .payment-rejected { background-color: rgba(220, 53, 69, 0.15) !important; color: #dc3545 !important; }

        .btn-xs {
            padding: 1px 5px;
            font-size: 10px;
            border-radius: 3px;
        }

        .customer-card-mobile {
            background: #ffffff;
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 12px;
            padding: 1.25rem;
            margin-bottom: 1rem;
            transition: all 0.3s;
        }
        .customer-card-mobile:hover {
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            border-color: var(--primary-color);
        }

        .notes-textarea {
            width: 100%;
            border: 1px dashed rgba(212, 175, 55, 0.3);
            background: transparent;
            font-size: 13px;
            color: var(--text-color);
            border-radius: 4px;
            padding: 4px 8px;
            transition: all 0.3s;
            resize: none;
            height: 40px;
        }
        .notes-textarea:focus {
            outline: none;
            border: 1px solid var(--primary-color);
            background: #ffffff;
            box-shadow: 0 0 5px rgba(212, 175, 55, 0.2);
            height: 85px;
        }

        .summary-tooltip {
            max-width: 200px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            cursor: pointer;
            color: var(--text-secondary);
        }

        .table-responsive::-webkit-scrollbar {
            height: 6px;
        }
        .table-responsive::-webkit-scrollbar-thumb {
            background: rgba(212, 175, 55, 0.3);
            border-radius: 4px;
        }
        .copy-btn {
            padding: 2px 6px;
            font-size: 11px;
            cursor: pointer;
            border-radius: 4px;
            transition: all 0.2s;
        }
        .copy-btn:hover {
            background-color: var(--primary-color);
            color: white;
        }
    </style>
</head>

<body>
    <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

    <div class="container-fluid main-content px-4 px-lg-5">
        
        <!-- Alerts (Toasts / Top notifications via Javascript) -->
        <div id="alertContainer" style="position: fixed; top: 100px; left: 50%; transform: translateX(-50%); z-index: 1060; width: 90%; max-width: 400px;"></div>

        <div class="glass-card p-4 animate-fade-in">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
                <h2 class="m-0 fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-person-fill-gear text-primary"></i>
                    إدارة ومتابعة العملاء (CRM)
                </h2>
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <button class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm" data-bs-toggle="modal" data-bs-target="#addCustomerModal" title="إضافة عميل" style="width: 40px; height: 40px; padding: 0;">
                        <i class="bi bi-person-plus-fill fs-5"></i>
                    </button>
                    <button type="button" class="btn btn-outline-primary rounded-circle d-flex align-items-center justify-content-center" id="btnViewTable" onclick="setViewMode('table')" title="عرض الجدول" style="width: 40px; height: 40px; padding: 0;">
                        <i class="bi bi-table fs-5"></i>
                    </button>
                    <button type="button" class="btn btn-outline-primary rounded-circle d-flex align-items-center justify-content-center" id="btnViewCards" onclick="setViewMode('cards')" title="عرض كروت فردية" style="width: 40px; height: 40px; padding: 0;">
                        <i class="bi bi-grid fs-5"></i>
                    </button>
                    <button class="btn btn-outline-primary rounded-circle d-flex align-items-center justify-content-center" onclick="loadData()" title="تحديث" style="width: 40px; height: 40px; padding: 0;">
                        <i class="bi bi-arrow-clockwise fs-5"></i>
                    </button>
                    <button class="btn btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#filtersCollapse" aria-expanded="false" aria-controls="filtersCollapse" title="تصفية وفلترة" style="width: 40px; height: 40px; padding: 0;">
                        <i class="bi bi-funnel fs-5"></i>
                    </button>
                    <% if (user.role === 'super_admin' || user.role === 'admin') { %>
                        <button class="btn btn-success rounded-circle d-flex align-items-center justify-content-center text-white" onclick="exportExcel()" title="تصدير Excel" style="width: 40px; height: 40px; padding: 0;">
                            <i class="bi bi-file-earmark-spreadsheet fs-5"></i>
                        </button>
                    <% } %>
                </div>
            </div>

            <!-- FIlters Toolbar -->
            <div class="collapse d-lg-block mb-4" id="filtersCollapse">
                <div class="row g-3 p-3 rounded shadow-sm border border-secondary border-opacity-10 bg-light bg-opacity-50">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-secondary">البحث بالاسم أو الرقم</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" id="filterSearch" class="form-control form-control-sm" placeholder="ابحث هنا...">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-secondary">حالة العميل</label>
                        <select id="filterStatus" class="form-select form-select-sm" onchange="loadData(1)">
                            <option value="all">الكل</option>
                            <option value="awaiting_sales">مع المبيعات</option>
                            <option value="first_follow_up">المتابعة الأولى</option>
                            <option value="final_follow_up">المتابعة النهائية</option>
                            <option value="scheduled_follow_up">متابعة بتاريخ</option>
                            <option value="successful">العملاء الناجحين</option>
                            <option value="not_interested">غير المهتمين</option>
                        </select>
                    </div>

                    <% if (user.role === 'super_admin' || user.role === 'admin') { %>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-secondary">الموظف المسؤول</label>
                        <select id="filterEmployee" class="form-select form-select-sm">
                            <option value="all">الكل</option>
                            <option value="unassigned">غير مخصص</option>
                            <% employees.forEach(emp => { %>
                                <option value="<%= emp.id %>"><%= emp.fullName %></option>
                            <% }) %>
                        </select>
                    </div>
                    <% } else { %>
                        <input type="hidden" id="filterEmployee" value="<%= user.id %>">
                    <% } %>

                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-secondary">من تاريخ</label>
                        <input type="date" id="filterDateFrom" class="form-control form-control-sm">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-secondary">إلى تاريخ</label>
                        <input type="date" id="filterDateTo" class="form-control form-control-sm">
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <div class="form-check form-switch mb-1">
                            <input class="form-check-input" type="checkbox" role="switch" id="filterTodayFollowUps" onchange="loadData(1)">
                            <label class="form-check-label small fw-bold text-danger" for="filterTodayFollowUps">المتابعات المجدولة</label>
                        </div>
                    </div>
                    
                    <!-- Filter and Reset Buttons -->
                    <div class="col-12 d-flex justify-content-end gap-2 mt-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3 rounded-pill fw-bold" onclick="resetFilters()">
                            <i class="bi bi-arrow-counterclockwise"></i> إعادة ضبط
                        </button>
                        <button type="button" class="btn btn-primary btn-sm px-4 rounded-pill fw-bold text-white" onclick="loadData(1)">
                            <i class="bi bi-funnel-fill"></i> فلترة
                        </button>
                    </div>
                </div>
            </div>

            <!-- Loader -->
            <div id="loader" class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">جاري التحميل...</span>
                </div>
                <p class="text-muted mt-2">جاري تحميل بيانات العملاء...</p>
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="text-center py-5 d-none">
                <i class="bi bi-person-x text-secondary opacity-30" style="font-size: 4rem;"></i>
                <h4 class="text-muted mt-3">لم يتم العثور على عملاء</h4>
                <p class="text-secondary small">جرب تغيير خيارات التصفية أو البحث للحصول على نتائج.</p>
            </div>

            <!-- Desktop View Table -->
            <div id="tableView" class="d-none table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 8%">كود العميل</th>
                            <th style="width: 25%">العميل</th>
                            <th class="text-center" style="width: 20%">رقم الهاتف</th>
                            <% if (user.role === 'super_admin' || user.role === 'admin') { %>
                                <th style="width: 15%">المسؤول</th>
                            <% } %>
                            <th style="width: 10%">الحالة</th>
                            <th style="width: 20%">الملاحظات</th>
                            <th class="text-center" style="width: 15%">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody id="customerTableBody">
                        <!-- Dynamic Rows here -->
                    </tbody>
                </table>
            </div>

            <!-- Mobile View Cards -->
            <div id="cardsView" class="d-none">
                <!-- Dynamic Cards here -->
            </div>

            <!-- Pagination Grid -->
            <div id="paginationContainer" class="d-flex justify-content-between align-items-center mt-4 border-top pt-3 d-none">
                <span class="text-secondary small" id="paginationInfo"></span>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm m-0" id="paginationList">
                        <!-- Dynamic Pagination links -->
                    </ul>
                </nav>
            </div>

        </div>
    </div>

    <!-- AI Summary Modal -->
    <div class="modal fade" id="summaryModal" tabindex="-1" aria-labelledby="summaryModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="summaryModalLabel">📝 ملخص المحادثة بالذكاء الاصطناعي</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 fs-6 text-dark" id="summaryModalBody" style="white-space: pre-wrap; line-height:1.6;">
                    <!-- Content -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">إغلاق</button>
                </div>
            </div>
        </div>
    </div>

    
    <!-- Edit Notes Modal -->
    <div class="modal fade" id="editNotesModal" tabindex="-1" aria-labelledby="editNotesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header bg-light border-bottom-0 py-3">
                    <h5 class="modal-title fw-bold text-primary d-flex align-items-center gap-2" id="editNotesModalLabel">
                        <i class="bi bi-pencil-square text-primary"></i>
                        تعديل ملاحظات العميل
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="editNotesForm" onsubmit="submitEditNotes(event)">
                    <input type="hidden" id="editNotesCustomerId">
                    <div class="modal-body px-4 py-3">
                        <div class="mb-3">
                            <label for="editNotesContent" class="form-label fw-bold small text-secondary mb-2">الملاحظات (يمكن التعديل والحفظ مباشرة):</label>
                            <textarea id="editNotesContent" name="notes" class="form-control rounded-3 font-monospace" rows="8" placeholder="أدخل الملاحظات هنا..." style="font-size: 13px; line-height: 1.6;"></textarea>
                            
                            <!-- 🕒 Last Modified Timestamp Display -->
                            <div class="d-flex justify-content-between align-items-center mt-2 px-1 text-muted" style="font-size: 11.5px;">
                                <div>
                                    <i class="bi bi-clock-history text-secondary me-1"></i>
                                    <span>آخر تعديل: <span id="custPageNotesLastModifiedText" class="fw-bold text-dark">-</span></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top-0 py-2">
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold">حفظ الملاحظات</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Follow Up Date Modal -->
    <div class="modal fade" id="followUpModal" tabindex="-1" aria-labelledby="followUpModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="followUpModalLabel">⏰ جدولة موعد المتابعة</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="followUpForm" onsubmit="submitFollowUp(event)">
                    <input type="hidden" id="followUpCustomerId">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">اختر تاريخ ووقت المتابعة:</label>
                            <input type="datetime-local" id="followUpDateTime" class="form-control" required>
                            <div class="form-text">سيتم نقل حالة العميل تلقائياً إلى "متابعة بتاريخ مجدول".</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold">حفظ الموعد</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Add Customer Modal -->
    <div class="modal fade" id="addCustomerModal" tabindex="-1" aria-labelledby="addCustomerModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header bg-light border-bottom-0 py-3">
                    <h5 class="modal-title fw-bold text-primary d-flex align-items-center gap-2" id="addCustomerModalLabel">
                        <i class="bi bi-person-plus-fill text-primary"></i>
                        إضافة عميل جديد
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="addCustomerForm" onsubmit="submitAddCustomer(event)">
                    <div class="modal-body px-4 py-3">
                        <div class="mb-3">
                            <label for="addCustomerName" class="form-label fw-bold small text-secondary">اسم العميل <span class="text-danger">*</span></label>
                            <input type="text" id="addCustomerName" name="customerName" class="form-control rounded-3" placeholder="أدخل اسم العميل" required>
                        </div>
                        <div class="mb-3">
                            <label for="addCustomerPhone" class="form-label fw-bold small text-secondary">رقم الهاتف (واتساب) <span class="text-danger">*</span></label>
                            <input type="tel" id="addCustomerPhone" name="phoneNumber" class="form-control rounded-3" placeholder="مثال: 201012345678" required>
                            <div class="form-text small text-muted">يرجى إدخال الرقم بالصيغة الدولية بدون رمز الزائد (+).</div>
                        </div>
                        <input type="hidden" id="addCustomerStatus" name="status" value="new">
                        <div class="mb-3">
                            <label for="addCustomerNotes" class="form-label fw-bold small text-secondary">ملاحظات</label>
                            <textarea id="addCustomerNotes" name="notes" class="form-control rounded-3" rows="3" placeholder="أي ملاحظات إضافية عن العميل..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-top-0 py-3">
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold text-white" id="btnAddCustomerSubmit">حفظ العميل</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Customer Details Modal (الطولي المتناسب مع الموبايل) -->
    <div class="modal fade" id="customerDetailsModal" tabindex="-1" aria-labelledby="customerDetailsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 480px;">
            <div class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header bg-light border-bottom-0 py-3">
                    <h5 class="modal-title fw-bold text-primary d-flex align-items-center gap-2" id="customerDetailsModalLabel">
                        <i class="bi bi-person-badge-fill text-warning"></i>
                        تفاصيل العميل كاملة
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body px-4 py-3">
                    <!-- Loader -->
                    <div id="detailsLoader" class="text-center py-5">
                        <div class="spinner-border text-warning" role="status">
                            <span class="visually-hidden">جاري التحميل...</span>
                        </div>
                        <p class="text-muted mt-2 small">جاري جلب بيانات العميل...</p>
                    </div>

                    <!-- Details Content -->
                    <div id="detailsContent" class="d-none">
                        <input type="hidden" id="detailsCustomerId">
                        
                        <!-- Customer Info -->
                        <div class="card border-0 bg-light rounded-3 p-3 mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold text-dark mb-0" id="detailsCustName">—</h6>
                                <span class="badge bg-secondary fs-6" id="detailsCustIdTag">#</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-telephone text-secondary small"></i>
                                <code class="text-dark fw-bold" id="detailsCustPhone">—</code>
                                <button class="btn btn-sm btn-light py-0 px-2 border" onclick="copyText(document.getElementById('detailsCustPhone').textContent)" style="font-size: 11px;">
                                    <i class="bi bi-copy"></i> نسخ
                                </button>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-0 d-none" id="detailsEmailContainer">
                                <i class="bi bi-envelope text-secondary small"></i>
                                <span class="small text-muted" id="detailsCustEmail">—</span>
                            </div>
                        </div>

                        <!-- System Dates -->
                        <div class="row g-2 mb-3">
                            <div class="col-12">
                                <div class="p-2 border rounded bg-white small">
                                    <div class="text-muted mb-1"><i class="bi bi-calendar-plus me-1 text-warning"></i> بداية التواصل:</div>
                                    <span class="fw-bold text-dark" id="detailsFirstContact">—</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 border rounded bg-white small">
                                    <div class="text-muted mb-1"><i class="bi bi-reply me-1 text-success"></i> آخر رد من العميل:</div>
                                    <span class="fw-semibold text-dark" id="detailsLastReply">—</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 border rounded bg-white small">
                                    <div class="text-muted mb-1"><i class="bi bi-robot me-1 text-info"></i> آخر رسالة للبوت:</div>
                                    <span class="fw-semibold text-dark" id="detailsLastBot">—</span>
                                </div>
                            </div>
                        </div>

                        <!-- Actions (Status) -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">حالة العميل</label>
                            <select id="detailsStatusSelect" class="form-select form-select-sm" onchange="detailsUpdateStatus()">
                                <option value="new">عميل جديد</option>
                                <option value="awaiting_payment">بانتظار الدفع</option>
                                <option value="awaiting_sales">متابعة مبيعات</option>
                                <option value="first_follow_up">متابعة أولى</option>
                                <option value="final_follow_up">متابعة نهائية</option>
                                <option value="scheduled_follow_up">متابعة بموعد</option>
