        async function cancelFollowUp(customerId, event) {
            if (event) event.stopPropagation();
            if (!confirm('هل أنت متأكد من إلغاء المتابعة؟')) return;
            try {
                const response = await fetch('/customers/cancel-followup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ customerId })
                });
                const result = await response.json();
                if (result.success) {
                    showAlert('تم إلغاء المتابعة المجدولة');
                    loadData();
                } else {
                    showAlert(result.error || 'حدث خطأ', 'danger');
                }
            } catch (err) {
                console.error(err);
                showAlert('حدث خطأ في الاتصال بالسيرفر', 'danger');
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const openNoteId = urlParams.get('openNote');
            if (openNoteId) {
                setTimeout(() => {
                    showCustomerDetails(openNoteId);
                    setTimeout(() => {
                        const notesEl = document.getElementById('detailsNotes');
                        if(notesEl) {
                            notesEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            notesEl.focus();
                        }
                    }, 1000);
                }, 500);
            }
        });
    </script>
</body>

</html>
