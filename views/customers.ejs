    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function deleteCustomerFromDetails() {
        const customerId = window.currentDetailCustomerId;
        if (!customerId) {
            alert('❌ عذراً، لم يتم تحديد العميل الحالي.');
            return;
        }
        if (!confirm('⚠️ هل أنت متأكد تماماً من حذف هذا العميل؟\nسيتم حذف العميل وكافة محادثاته ورسائله وسجلاته نهائياً من السيستم لجميع المستخدمين والموظفين!')) {
            return;
        }
        fetch(`/dashboard/customers/${customerId}/delete`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                alert('✅ تم حذف العميل وكافة محادثاته ورسائله بنجاح!');
                const modalEl = document.getElementById('customerDetailsModal');
                if (modalEl) {
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                }
                if (typeof fetchCustomersData === 'function') {
                    fetchCustomersData(typeof currentPage !== 'undefined' ? currentPage : 1);
                } else {
                    location.reload();
                }
            } else {
                alert('❌ خطأ: ' + (data.error || 'فشل حذف العميل'));
            }
        })
        .catch(err => {
            console.error(err);
            alert('❌ حدث خطأ أثناء حذف العميل.');
        });
    }
</script>
    <script>
        let currentPage = 1;
        const limit = 10;
        let debounceTimer;
        let viewMode = window.innerWidth >= 992 ? 'table' : 'cards';

        const role = "<%= user.role %>";
        const employeesList = <%- JSON.stringify(employees) %>;

        function setViewMode(mode) {
            viewMode = mode;
            applyViewMode();
        }

        function applyViewMode() {
            const tableView = document.getElementById('tableView');
            const cardsView = document.getElementById('cardsView');
            const btnTable = document.getElementById('btnViewTable');
            const btnCards = document.getElementById('btnViewCards');

            if (viewMode === 'table') {
                btnTable.classList.remove('btn-outline-primary');
                btnTable.classList.add('btn-primary', 'text-white');
                btnCards.classList.remove('btn-primary', 'text-white');
                btnCards.classList.add('btn-outline-primary');
                
                tableView.classList.remove('d-none');
                cardsView.classList.add('d-none');
            } else {
                btnCards.classList.remove('btn-outline-primary');
                btnCards.classList.add('btn-primary', 'text-white');
                btnTable.classList.remove('btn-primary', 'text-white');
                btnTable.classList.add('btn-outline-primary');
                
                cardsView.classList.remove('d-none');
                tableView.classList.add('d-none');
            }
        }

        function formatDateTime(date) {
            if (!date) return '—';
            const d = new Date(date);
            if (isNaN(d.getTime())) return '—';
            return d.toLocaleString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: true });
        }

        // Initialize view on load
        document.addEventListener("DOMContentLoaded", () => {
            const urlParams = new URLSearchParams(window.location.search);
            const statusParam = urlParams.get('status');
            const employeeIdParam = urlParams.get('employeeId');

            if (statusParam && document.getElementById('filterStatus')) {
                document.getElementById('filterStatus').value = statusParam;
            }
            if (employeeIdParam && document.getElementById('filterEmployee')) {
                document.getElementById('filterEmployee').value = employeeIdParam;
            }

            applyViewMode();
            loadData();
        });

        // Debounce search function
        function debounceLoad() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                currentPage = 1;
                loadData();
            }, 500);
        }

        // Reset Filters function
        function resetFilters() {
            document.getElementById('filterSearch').value = '';
            document.getElementById('filterStatus').value = 'all';
            const filterEmp = document.getElementById('filterEmployee'); if (filterEmp && filterEmp.tagName === 'SELECT') {
                document.getElementById('filterEmployee').value = 'all';
            }
            document.getElementById('filterDateFrom').value = '';
            document.getElementById('filterDateTo').value = '';
            document.getElementById('filterTodayFollowUps').checked = false;
            loadData(1);
        }

        // Export to Excel function
        function exportExcel() {
            const search = document.getElementById('filterSearch').value;
            const status = document.getElementById('filterStatus').value;
            const employeeId = document.getElementById('filterEmployee').value;
            const dateFrom = document.getElementById('filterDateFrom').value;
            const dateTo = document.getElementById('filterDateTo').value;
            const todayFollowUps = document.getElementById('filterTodayFollowUps').checked;

            const url = `/dashboard/customers/export?search=${encodeURIComponent(search)}&status=${status}&employeeId=${employeeId}&dateFrom=${dateFrom}&dateTo=${dateTo}&todayFollowUps=${todayFollowUps}`;
            window.location.href = url;
        }

        // Fetch data via AJAX
        function loadData(page = 1) {
            currentPage = page;
            const search = document.getElementById('filterSearch').value;
            const status = document.getElementById('filterStatus').value;
            const employeeId = document.getElementById('filterEmployee').value;
            const dateFrom = document.getElementById('filterDateFrom').value;
            const dateTo = document.getElementById('filterDateTo').value;
            const todayFollowUps = document.getElementById('filterTodayFollowUps').checked;

            document.getElementById('loader').classList.remove('d-none');
            document.getElementById('tableView').classList.add('d-none');
            document.getElementById('cardsView').classList.add('d-none');
            document.getElementById('emptyState').classList.add('d-none');
            document.getElementById('paginationContainer').classList.add('d-none');

            const url = `/dashboard/customers/data?page=${page}&limit=${limit}&search=${encodeURIComponent(search)}&status=${status}&employeeId=${employeeId}&dateFrom=${dateFrom}&dateTo=${dateTo}&todayFollowUps=${todayFollowUps}`;

            fetch(url)
                .then(res => res.json())
                .then(res => {
                    document.getElementById('loader').classList.add('d-none');
                    if (res.success && res.customers && res.customers.length > 0) {
                        window.currentLoadedCustomers = res.customers;
                        renderTable(res.customers, res.totalCount);
                        renderCards(res.customers, res.totalCount);
                        renderPagination(res.page, res.totalPages, res.totalCount);
                        
                        applyViewMode();
                        document.getElementById('paginationContainer').classList.remove('d-none');
                    } else {
                        document.getElementById('emptyState').classList.remove('d-none');
                    }
                })
                .catch(err => {
                    console.error(err);
                    document.getElementById('loader').classList.add('d-none');
                    showAlert('حدث خطأ أثناء تحميل البيانات. يرجى المحاولة مرة أخرى.', 'danger');
                });
        }

        // Alert helper
        function showAlert(msg, type = 'success') {
            const container = document.getElementById('alertContainer');
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
                    <i class="bi ${type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill'} me-2"></i> 
                    ${msg}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            container.innerHTML = alertHtml;
            setTimeout(() => {
                const alert = container.querySelector('.alert');
                if (alert) {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }
            }, 4000);
        }

        // Copy Text Helper
        function copyText(text) {
            navigator.clipboard.writeText(text)
                .then(() => {
                    if (window.showToast) window.showToast('تم نسخ الرقم بنجاح!');
                    else showAlert('تم نسخ الرقم بنجاح!');
                })
                .catch(err => {
                    if (window.showToast) window.showToast('فشل نسخ الرقم.', 'danger');
                    else showAlert('فشل نسخ الرقم.', 'danger');
                });
        }

        // Show AI Summary Modal
        function showSummary(summaryText) {
            document.getElementById('summaryModalBody').textContent = summaryText || "لا يوجد ملخص متاح حالياً لهذه المحادثة.";
            const modal = new bootstrap.Modal(document.getElementById('summaryModal'));
            modal.show();
        }

        function renderTable(customers, totalCount) {
            const tbody = document.getElementById('customerTableBody');
            tbody.innerHTML = '';

            customers.forEach((cust, index) => {
                const dateStart = cust.firstContactAt ? formatDateTime(cust.firstContactAt) : '—';
                const summaryText = cust.aiSummary || '';
                const shortSummary = summaryText.length > 50 ? summaryText.substring(0, 50) + '...' : (summaryText || '—');
                const serialNum = cust.customerNumber || cust.id;
                
                // Status Select Options
                let statusOptions = `
                    <option value="new" ${cust.status === 'new' ? 'selected' : ''}>عميل جديد</option>
                    <option value="awaiting_payment" ${cust.status === 'awaiting_payment' ? 'selected' : ''}>بانتظار الدفع</option>
                    <option value="awaiting_sales" ${cust.status === 'awaiting_sales' ? 'selected' : ''}>متابعة مبيعات</option>
                    <option value="first_follow_up" ${cust.status === 'first_follow_up' ? 'selected' : ''}>متابعة أولى</option>
                    <option value="final_follow_up" ${cust.status === 'final_follow_up' ? 'selected' : ''}>متابعة نهائية</option>
                    <option value="scheduled_follow_up" ${cust.status === 'scheduled_follow_up' ? 'selected' : ''}>متابعة بموعد</option>
                    <option value="successful" ${cust.status === 'successful' ? 'selected' : ''}>تم البيع</option>
                    <option value="not_interested" ${cust.status === 'not_interested' ? 'selected' : ''}>غير مهتم/ملغي</option>
                `;

                // Assignee options
                let assigneeCol = '';
                if (role === 'super_admin' || role === 'admin') {
                    let employeeOptions = `<option value="">غير مخصص</option>`;
                    employeesList.forEach(emp => {
                        employeeOptions += `<option value="${emp.id}" ${cust.assignedToUserId === emp.id ? 'selected' : ''}>${emp.fullName}</option>`;
                    });
                    assigneeCol = `
                        <td>
                            <select class="form-select form-select-sm" onchange="updateAssignee(${cust.id}, this.value)">
                                ${employeeOptions}
                            </select>
                        </td>
                    `;
                }

                let followUpTimeStr = '';
                if (cust.scheduledFollowUpAt) {
                    const formatted = formatDateTime(cust.scheduledFollowUpAt);
                    const cancelBtn = `<i class="fas fa-times text-danger ms-2" style="cursor:pointer;" onclick="cancelFollowUp(${cust.id}, event)" title="إلغاء المتابعة"></i>`;
                    if (cust.status === 'scheduled_follow_up') {
                        followUpTimeStr = `<div class="small text-muted mt-1" style="font-size: 11px;"><i class="bi bi-clock me-1 text-primary"></i> ${formatted} ${cancelBtn}</div>`;
                    } else if (cust.status === 'first_follow_up') {
                        followUpTimeStr = `<div class="small text-muted mt-1" style="font-size: 11px;"><i class="bi bi-clock me-1 text-warning"></i> ${formatted} ${cancelBtn}</div>`;
                    } else if (cust.status === 'final_follow_up') {
                        followUpTimeStr = `<div class="small text-muted mt-1" style="font-size: 11px;"><i class="bi bi-clock me-1 text-danger"></i> ${formatted} ${cancelBtn}</div>`;
                    }
                }

                const row = `
                    <tr id="row-${cust.id}">
                        <td class="small text-secondary fw-semibold">${serialNum}</td>
                        <td>
                            <div class="fw-bold text-dark">${cust.customerName || 'عميل واتساب'}</div>
                            ${cust.email ? `<div class="small text-muted">${cust.email}</div>` : ''}
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center align-items-center gap-1" dir="ltr">
                                <code class="text-secondary">${cust.phoneNumber}</code>
                                <button class="btn btn-light copy-btn" onclick="copyText('${cust.phoneNumber}')" title="نسخ"><i class="bi bi-copy"></i></button>
                            </div>
                        </td>

                        ${assigneeCol}

                        <td>
                            <select class="status-select status-${cust.status} form-select-sm border-0 shadow-sm" onchange="updateStatus(${cust.id}, this.value)">
                                ${statusOptions}
                            </select>
                            ${followUpTimeStr}
                        </td>

                                                <td>
                            <div class="note-snippet p-1 rounded bg-light border cursor-pointer" 
                                 style="max-width: 180px;"
                                 onclick="openEditNoteModal(${cust.id})"
                                 title="اضغط للتعديل أو العرض الكامل">
                                <div class="small text-dark text-truncate">
                                    <i class="bi bi-pencil-square text-primary me-1"></i>
                                    <span>${cust.notes ? (cust.notes.length > 22 ? cust.notes.substring(0, 22) + '...' : cust.notes) : '<em class="text-muted">إضافة ملاحظة...</em>'}</span>
                                </div>
                            </div>
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a href="/dashboard/livechat?jid=${encodeURIComponent(cust.remoteJid || '')}&phone=${encodeURIComponent(cust.phoneNumber || '')}&name=${encodeURIComponent(cust.customerName || '')}" class="btn btn-sm btn-outline-primary px-2 py-1 rounded" title="فتح المحادثة في اللايف شات">
                                    <i class="bi bi-chat-text-fill"></i>
                                </a>
                                <a href="https://wa.me/${cust.phoneNumber}" target="_blank" class="btn btn-sm btn-outline-success px-2 py-1 rounded" title="محادثة واتساب">
                                    <i class="bi bi-whatsapp"></i>
                                </a>

                                <button class="btn btn-sm btn-outline-info px-2 py-1 rounded" onclick="showCustomerDetails(${cust.id}, ${serialNum})" title="عرض التفاصيل">
                                    <i class="bi bi-person-lines-fill"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
                tbody.insertAdjacentHTML('beforeend', row);
            });
        }

        // Render Mobile Cards
        function renderCards(customers, totalCount) {
            const container = document.getElementById('cardsView');
            container.innerHTML = '';

            customers.forEach((cust, index) => {
                const dateStart = cust.firstContactAt ? formatDateTime(cust.firstContactAt) : '—';
                const assigneeName = cust.assignedTo ? cust.assignedTo.fullName : 'غير مخصص';
                const serialNum = cust.customerNumber || cust.id;

                // Dropdowns inside card
                let statusOptions = `
                    <option value="new" ${cust.status === 'new' ? 'selected' : ''}>عميل جديد</option>
                    <option value="awaiting_payment" ${cust.status === 'awaiting_payment' ? 'selected' : ''}>بانتظار الدفع</option>
                    <option value="awaiting_sales" ${cust.status === 'awaiting_sales' ? 'selected' : ''}>متابعة مبيعات</option>
                    <option value="first_follow_up" ${cust.status === 'first_follow_up' ? 'selected' : ''}>متابعة أولى</option>
                    <option value="final_follow_up" ${cust.status === 'final_follow_up' ? 'selected' : ''}>متابعة نهائية</option>
                    <option value="scheduled_follow_up" ${cust.status === 'scheduled_follow_up' ? 'selected' : ''}>متابعة بموعد</option>
                    <option value="successful" ${cust.status === 'successful' ? 'selected' : ''}>تم البيع</option>
                    <option value="not_interested" ${cust.status === 'not_interested' ? 'selected' : ''}>غير مهتم/ملغي</option>
                `;

                let assigneeSelect = '';
                if (role === 'super_admin' || role === 'admin') {
                    let employeeOptions = `<option value="">غير مخصص</option>`;
                    employeesList.forEach(emp => {
                        employeeOptions += `<option value="${emp.id}" ${cust.assignedToUserId === emp.id ? 'selected' : ''}>${emp.fullName}</option>`;
                    });
                    assigneeSelect = `
                        <div class="col-6 mb-2">
                            <strong class="small text-secondary d-block">المسؤول:</strong>
                            <select class="form-select form-select-sm mt-1" onchange="updateAssignee(${cust.id}, this.value)">
                                ${employeeOptions}
                            </select>
                        </div>
                    `;
                } else {
                    assigneeSelect = `
                        <div class="col-6 mb-2">
                            <strong class="small text-secondary">المسؤول:</strong>
                            <span class="d-block small text-dark mt-1">${assigneeName}</span>
                        </div>
                    `;
                }

                const card = <%- include('partials/customer_card') %>;
                container.insertAdjacentHTML('beforeend', card);
            });
        }

        // Render Pagination buttons
        function renderPagination(page, totalPages, totalCount) {
            const info = document.getElementById('paginationInfo');
            const list = document.getElementById('paginationList');

            info.textContent = `عرض ${(page - 1) * limit + 1} إلى ${Math.min(page * limit, totalCount)} من إجمالي ${totalCount} عميل`;
            list.innerHTML = '';

            // Previous
            const prevDisabled = page === 1 ? 'disabled' : '';
            list.insertAdjacentHTML('beforeend', `
                <li class="page-item ${prevDisabled}">
                    <button class="page-link" onclick="loadData(${page - 1})" aria-label="Previous">&laquo;</button>
                </li>
            `);

            // Page Numbers (Show max 5 pages around current)
            let startPage = Math.max(1, page - 2);
            let endPage = Math.min(totalPages, page + 2);

            for (let i = startPage; i <= endPage; i++) {
                const active = i === page ? 'active' : '';
                list.insertAdjacentHTML('beforeend', `
                    <li class="page-item ${active}">
                        <button class="page-link" onclick="loadData(${i})">${i}</button>
                    </li>
                `);
            }

            // Next
            const nextDisabled = page === totalPages ? 'disabled' : '';
            list.insertAdjacentHTML('beforeend', `
                <li class="page-item ${nextDisabled}">
                    <button class="page-link" onclick="loadData(${page + 1})" aria-label="Next">&raquo;</button>
                </li>
            `);
        }

        // AJAX: Update Status
        function updateStatus(id, newStatus) {


            // Auto-trigger follow-up date modal
            if (newStatus === 'scheduled_follow_up') {
                openFollowUpModal(id, '');
            }

            fetch('/dashboard/customers/update-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id, status: newStatus })
            })
