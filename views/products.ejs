<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تفاصيل الخدمة</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="/style.css?v=<%= Date.now() %>" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<style>
/* ===== Filter Tabs ===== */
.filter-tabs { display: flex; gap: 8px; flex-wrap: wrap; }
.filter-tab {
    padding: 8px 20px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.1);
    color: #8899ac;
    background: rgba(255,255,255,0.03);
    transition: all 0.3s;
}
.filter-tab:hover { background: rgba(54,153,255,0.08); color: #fff; border-color: rgba(54,153,255,0.3); }
.filter-tab.active { background: rgba(54,153,255,0.15); color: #3699ff; border-color: #3699ff; }

/* ===== Product Cards Grid ===== */
.products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 20px;
}
.product-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
    position: relative;
}
.product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(54,153,255,0.18);
    border-color: rgba(54,153,255,0.4);
}
.product-card-img {
    position: relative;
    height: 180px;
    background: #1a1a2e;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}
.product-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
}
.product-card:hover .product-card-img img { transform: scale(1.05); }
.product-img-count {
    position: absolute;
    bottom: 8px;
    left: 10px;
    background: rgba(0,0,0,0.65);
    color: #fff;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 20px;
    backdrop-filter: blur(4px);
}
.product-type-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 3px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 700;
    backdrop-filter: blur(6px);
}
.product-type-badge.type-product { background: rgba(54,153,255,0.8); color: #fff; }
.product-type-badge.type-service { background: rgba(156,39,176,0.8); color: #fff; }
.product-status-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 3px 8px;
    border-radius: 10px;
    font-size: 10px;
    font-weight: 700;
}
.product-status-badge.available { background: rgba(27,197,189,0.25); color: #1bc5bd; }
.product-status-badge.out_of_stock { background: rgba(255,100,100,0.25); color: #ff6464; }
.product-card-body { padding: 14px 16px; }
.product-card-name {
    font-weight: 700;
    font-size: 15px;
    color: #e4e6ef;
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.product-card-desc {
    font-size: 12px;
    color: #8899ac;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 32px;
}
.product-card-price {
    font-weight: 800;
    font-size: 16px;
    color: #1bc5bd;
    margin-top: 6px;
}
.product-card-actions {
    display: flex;
    gap: 6px;
    padding: 10px 16px 14px;
    justify-content: flex-end;
    border-top: 1px solid rgba(255,255,255,0.05);
}
.product-no-img {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.2);
    font-size: 40px;
}
.product-empty {
    text-align: center;
    padding: 60px 20px;
    color: rgba(255,255,255,0.25);
}
.product-empty i { font-size: 5rem; display: block; margin-bottom: 16px; }

/* ===== Upload Zone ===== */
.product-upload-zone {
    border: 2px dashed rgba(54,153,255,0.4);
    border-radius: 14px;
    padding: 28px 20px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s;
    background: rgba(54,153,255,0.03);
}
.product-upload-zone:hover, .product-upload-zone.dragging {
    border-color: #3699ff;
    background: rgba(54,153,255,0.08);
}
.product-upload-icon { font-size: 2rem; color: #3699ff; margin-bottom: 8px; }
.product-upload-text { font-weight: 600; color: #c0c5d0; font-size: 14px; }
.product-upload-sub { font-size: 11px; color: #5a6070; margin-top: 4px; }

/* Image preview grid */
.img-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
    gap: 8px;
    margin-top: 12px;
}
.img-preview-item {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
    aspect-ratio: 1;
}
.img-preview-item img { width: 100%; height: 100%; object-fit: cover; }
.img-preview-remove {
    position: absolute;
    top: 3px;
    left: 3px;
    background: rgba(200,50,50,0.85);
    border: none;
    color: white;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    font-size: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: 0.2s;
}
.img-preview-remove:hover { background: #e30; }
.img-desc-input {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(0,0,0,0.7);
    border: none;
    color: #fff;
    font-size: 10px;
    padding: 3px 6px;
    text-align: center;
    outline: none;
}

/* Type selector */
.type-selector { display: flex; gap: 12px; }
.type-option {
    flex: 1;
    padding: 14px;
    border-radius: 12px;
    border: 2px solid rgba(255,255,255,0.1);
    text-align: center;
    cursor: pointer;
    transition: all 0.3s;
    background: rgba(255,255,255,0.02);
}
.type-option:hover { border-color: rgba(54,153,255,0.3); background: rgba(54,153,255,0.05); }
.type-option.selected-product { border-color: #3699ff; background: rgba(54,153,255,0.12); }
.type-option.selected-service { border-color: #9c27b0; background: rgba(156,39,176,0.12); }
.type-option-icon { font-size: 28px; display: block; margin-bottom: 6px; }
.type-option-label { font-weight: 700; font-size: 14px; color: #e4e6ef; }
.type-option-desc { font-size: 11px; color: #8899ac; margin-top: 2px; }
.inactive-card { opacity: 0.5; }
</style>
</head>
<body>
    <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

    <% if (success) { %>
        <div class="alert alert-success success-msg shadow-lg rounded-pill px-5" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> تم الحفظ بنجاح!
        </div>
        <script>setTimeout(() => { window.location.href = '/dashboard/products'; }, 1500);</script>
    <% } %>

    <div class="container-fluid main-content px-4 px-lg-5">
        <div class="glass-card p-4 p-md-5 animate-fade-in">

            <!-- Header -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
                <div>
                    <h2 class="m-0 fw-bold text-white d-flex align-items-center gap-2">
                        <i class="bi bi-shop text-primary"></i>
                        تفاصيل الخدمة
                    </h2>
                    <p class="text-white-50 small mt-1 mb-0">أضف تفاصيل خدماتك مع الصور والأسعار — البوت يتعلمها ويرد عليها تلقائياً 🤖</p>
                </div>
                <button class="btn btn-primary px-4 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#addProductModal" id="addProductBtn">
                    <i class="bi bi-plus-lg me-1"></i> إضافة خدمة
                </button>
            </div>

            <!-- Filter Tabs -->
            <% if (false) { %>
            <div class="filter-tabs mb-3">
                <a href="/dashboard/products" class="filter-tab <%= activeFilter === 'all' ? 'active' : '' %>">🔥 الكل (<%= products.length %>)</a>
                <a href="/dashboard/products?type=product" class="filter-tab <%= activeFilter === 'product' ? 'active' : '' %>">📦 منتجات</a>
                <a href="/dashboard/products?type=service" class="filter-tab <%= activeFilter === 'service' ? 'active' : '' %>">🛠️ خدمات</a>
            </div>
            <% } %>

            <!-- Products Grid -->
            <% if (products.length === 0) { %>
                <div class="product-empty glass-card" style="background: rgba(255,255,255,0.02);">
                    <i class="bi bi-bag-x"></i>
                    <h5 class="text-white-50">لا يوجد خدمات بعد</h5>
                    <p class="text-white-50 small">ابدأ بإضافة أول خدمة</p>
                    <button class="btn btn-outline-primary rounded-pill px-4 mt-2" data-bs-toggle="modal" data-bs-target="#addProductModal">
                        <i class="bi bi-plus-circle me-1"></i> إضافة الآن
                    </button>
                </div>
            <% } else { %>
                <div class="products-grid">
                    <% products.forEach(product => {
                        const images = product.images || [];
                    %>
                    <div class="product-card <%= !product.isActive ? 'inactive-card' : '' %>">
                        <div class="product-card-img">
                            <% if (images.length > 0) { %>
                                <img src="<%= images[0].url %>" alt="<%= product.name %>" loading="lazy">
                                <% if (images.length > 1) { %>
                                    <span class="product-img-count"><i class="bi bi-images"></i> <%= images.length %> صور</span>
                                <% } %>
                            <% } else { %>
                                <div class="product-no-img">
                                    <i class="bi bi-image-alt"></i>
                                    <span style="font-size:12px; margin-top:6px;">لا توجد صور</span>
                                </div>
                            <% } %>
                            <% if (false) { %>
                            <span class="product-type-badge type-<%= product.type %>">
                                <%= product.type === 'product' ? '📦 منتج' : '🛠️ خدمة' %>
                            </span>
                            <% } %>
                            <% if (product.status === 'out_of_stock') { %>
                                <span class="product-status-badge out_of_stock">نفد</span>
                            <% } else { %>
                                <span class="product-status-badge available">متاح</span>
                            <% } %>
                        </div>
                        <div class="product-card-body">
                            <div class="product-card-name"><%= product.name %></div>
                            <div class="product-card-desc"><%= product.description || 'بدون وصف' %></div>
                            <% if (product.price) { %>
                                 <div class="product-card-price"><%= Math.round(product.price) %> <%= product.currency || 'EGP' %></div>
                             <% } else { %>
                                <div class="product-card-price" style="color: #8899ac; font-size: 13px;">بدون سعر</div>
                            <% } %>
                        </div>
                        <div class="product-card-actions">
                            <form action="/dashboard/products/toggle/<%= product.id %>" method="POST" class="m-0" title="تفعيل/تعطيل">
                                <div class="form-check form-switch m-0 d-flex align-items-center" style="padding-left:0;">
                                    <input class="form-check-input m-0" type="checkbox" onchange="this.form.submit()" <%= product.isActive ? 'checked' : '' %> style="cursor:pointer; width:2em; height:1em;">
                                </div>
                            </form>
                            <button class="btn btn-sm btn-outline-info rounded-pill px-3"
                                onclick="openEditProduct(this)"
                                data-id="<%= product.id %>"
                                data-name="<%= product.name %>"
                                data-type="<%= product.type %>"
                                data-description="<%= product.description || '' %>"
                                data-price="<%= product.price || '' %>"
                                data-currency="<%= product.currency || 'EGP' %>"
                                data-category="<%= product.category || '' %>"
                                data-status="<%= product.status %>"
                                data-images='<%= JSON.stringify(product.images || []) %>'
                                title="تعديل">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <form action="/dashboard/products/delete" method="POST" class="m-0 d-inline"
                                onsubmit="return confirm('حذف <%= product.name %>؟')">
                                <input type="hidden" name="id" value="<%= product.id %>">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="حذف">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>

    <!-- ====== Add Product Modal ====== -->
    <div class="modal fade" id="addProductModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content" style="background: #1e293b; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);">
                <div class="modal-header border-bottom border-secondary border-opacity-25">
                    <h5 class="modal-title text-white fw-bold"><i class="bi bi-plus-circle-fill text-primary me-2"></i>إضافة خدمة</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form action="/dashboard/products/add" method="POST" id="addProductForm">
                    <div class="modal-body p-4" style="overflow-y: auto; max-height: 70vh;">

                        <!-- Type Selector -->
                        <%#
                        <div class="mb-4">
                            <label class="form-label text-white fw-bold fs-6 mb-2">نوع العنصر <span class="badge bg-danger ms-1">مطلوب</span></label>
                            <div class="type-selector" id="addTypeSelector">
                                <div class="type-option selected-product" data-type="product" id="addTypeProduct">
                                    <span class="type-option-icon">📦</span>
                                    <span class="type-option-label">منتج</span>
                                    <span class="type-option-desc">ملابس، أكل، إلكترونيات...</span>
                                </div>
                                <div class="type-option" data-type="service" id="addTypeService">
                                    <span class="type-option-icon">🛠️</span>
                                    <span class="type-option-label">خدمة</span>
                                    <span class="type-option-desc">تصميم، تسويق، صيانة...</span>
                                </div>
                            </div>
                        </div>
                        %>
                        <input type="hidden" name="type" id="addTypeInput" value="service">

                        <!-- Name -->
                        <div class="mb-3">
                            <label class="form-label text-white fw-bold">🏷️ الاسم <span class="badge bg-danger ms-1">مطلوب</span></label>
                            <input type="text" name="name" id="addName"
                                class="form-control form-control-lg"
                                required placeholder="مثال: كورس اللغة الألمانية للمبتدئين A1، كورس المحادثة..." autofocus>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label class="form-label text-white fw-bold">📝 الوصف</label>
                            <textarea name="description" id="addDescription"
                                class="form-control"
                                rows="3" placeholder="وصف تفصيلي لمحتوى الكورس والمستويات والمواعيد... (اختياري)"></textarea>
                        </div>

                        <!-- Price + Currency Row -->
                        <div class="row mb-3">
                            <div class="col-8">
                                <label class="form-label text-white fw-bold">💰 السعر</label>
                                <input type="number" name="price" id="addPrice" step="0.01" min="0"
                                    class="form-control"
                                    placeholder="مثال: 1500">
                            </div>
                            <div class="col-4">
                                <label class="form-label text-white fw-bold">العملة</label>
                                <select name="currency" class="form-select">
                                    <option value="EGP" selected>EGP ج.م</option>
                                    <option value="SAR">SAR ر.س</option>
                                    <option value="AED">AED د.إ</option>
                                    <option value="USD">USD $</option>
                                    <option value="EUR">EUR €</option>
                                </select>
                            </div>
                        </div>

                        <!-- Category -->
                        <div class="mb-3">
                            <label class="form-label text-white fw-bold">📂 التصنيف</label>
                            <input type="text" name="category" id="addCategory"
                                class="form-control"
                                placeholder="مثال: كورسات لغات، كورسات تأهيلية... (اختياري)">
                        </div>

                        <!-- Images Upload -->
                        <div class="mb-3">
                            <label class="form-label text-white fw-bold fs-6">🖼️ الصور</label>
                            <div class="product-upload-zone" id="addDropZone">
                                <div class="product-upload-icon"><i class="bi bi-cloud-upload"></i></div>
                                <div class="product-upload-text">اضغط هنا أو اسحب الصور</div>
                                <div class="product-upload-sub">PNG, JPG, WEBP — ممكن تختار أكتر من صورة</div>
                                <div class="mt-2" style="min-height:18px;">
                                    <span class="spinner-border spinner-border-sm text-primary d-none" id="addSpinner"></span>
                                    <span id="addStatus" class="small text-success fw-bold"></span>
                                </div>
                            </div>
                            <input type="hidden" name="imageUrl" id="addImageUrlInput">
                            <input type="file" id="addFileInput" accept="image/*" multiple class="d-none">
                            <div id="addPreviewGrid" class="img-preview-grid"></div>
                        </div>

                    </div>
                    <div class="modal-footer border-top border-secondary border-opacity-25 justify-content-between">
                        <button type="button" class="btn btn-link text-white-50 text-decoration-none" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary px-5 rounded-pill fw-bold">
                            <i class="bi bi-check-lg me-1"></i> حفظ
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ====== Edit Product Modal ====== -->
    <div class="modal fade" id="editProductModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content" style="background: #1e293b; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);">
                <div class="modal-header border-bottom border-secondary border-opacity-25">
                    <h5 class="modal-title text-white fw-bold"><i class="bi bi-pencil-square text-info me-2"></i>تعديل الخدمة</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form action="/dashboard/products/edit" method="POST" id="editProductForm">
                    <input type="hidden" name="id" id="editId">
                    <div class="modal-body p-4" style="overflow-y: auto; max-height: 70vh;">

                        <!-- Type Selector -->
                        <%#
                        <div class="mb-4">
                            <label class="form-label text-white fw-bold fs-6 mb-2">نوع العنصر</label>
                            <div class="type-selector" id="editTypeSelector">
                                <div class="type-option" data-type="product" id="editTypeProduct">
                                    <span class="type-option-icon">📦</span>
                                    <span class="type-option-label">منتج</span>
                                    <span class="type-option-desc">ملابس، أكل، إلكترونيات...</span>
                                </div>
                                <div class="type-option" data-type="service" id="editTypeService">
                                    <span class="type-option-icon">🛠️</span>
                                    <span class="type-option-label">خدمة</span>
                                    <span class="type-option-desc">تصميم، تسويق، صيانة...</span>
                                </div>
                            </div>
                        </div>
                        %>
                        <input type="hidden" name="type" id="editTypeInput" value="service">

                        <!-- Name -->
                        <div class="mb-3">
                            <label class="form-label text-white fw-bold">🏷️ الاسم</label>
                            <input type="text" name="name" id="editName"
                                class="form-control form-control-lg" required
                                placeholder="مثال: كورس اللغة الألمانية للمبتدئين A1، كورس المحادثة...">
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label class="form-label text-white fw-bold">📝 الوصف</label>
                            <textarea name="description" id="editDescription"
                                class="form-control" rows="3"
                                placeholder="وصف تفصيلي لمحتوى الكورس والمستويات والمواعيد... (اختياري)"></textarea>
                        </div>

                        <!-- Price + Currency -->
                        <div class="row mb-3">
                            <div class="col-8">
                                <label class="form-label text-white fw-bold">💰 السعر</label>
                                <input type="number" name="price" id="editPrice" step="0.01" min="0"
                                    class="form-control"
                                    placeholder="مثال: 1500">
                            </div>
                            <div class="col-4">
                                <label class="form-label text-white fw-bold">العملة</label>
                                <select name="currency" id="editCurrency" class="form-select">
                                    <option value="EGP">EGP ج.م</option>
                                    <option value="SAR">SAR ر.س</option>
                                    <option value="AED">AED د.إ</option>
                                    <option value="USD">USD $</option>
                                    <option value="EUR">EUR €</option>
                                </select>
                            </div>
                        </div>

                        <!-- Category -->
                        <div class="mb-3">
                            <label class="form-label text-white fw-bold">📂 التصنيف</label>
                            <input type="text" name="category" id="editCategory"
                                class="form-control"
                                placeholder="مثال: كورسات لغات، كورسات تأهيلية... (اختياري)">
                        </div>

                        <!-- Status -->
                        <div class="mb-3">
                            <label class="form-label text-white fw-bold">📊 الحالة</label>
                            <select name="status" id="editStatus" class="form-select">
                                <option value="available">✅ متاح</option>
                                <option value="out_of_stock">❌ نفد من المخزون</option>
                            </select>
                        </div>

                        <!-- Images -->
                        <div class="mb-3">
                            <label class="form-label text-white fw-bold fs-6">🖼️ الصور</label>
                            <div class="product-upload-zone" id="editDropZone">
                                <div class="product-upload-icon"><i class="bi bi-cloud-upload"></i></div>
                                <div class="product-upload-text">اسحب صور جديدة أو اضغط للإضافة</div>
                                <div class="product-upload-sub">الصور القديمة هتفضل إلا لو حذفتها</div>
                                <div class="mt-2" style="min-height:18px;">
                                    <span class="spinner-border spinner-border-sm text-primary d-none" id="editSpinner"></span>
                                    <span id="editStatus2" class="small text-success fw-bold"></span>
                                </div>
                            </div>
                            <input type="hidden" name="imageUrl" id="editImageUrlInput">
                            <input type="file" id="editFileInput" accept="image/*" multiple class="d-none">
                            <div id="editPreviewGrid" class="img-preview-grid"></div>
                        </div>

                    </div>
                    <div class="modal-footer border-top border-secondary border-opacity-25 justify-content-between">
                        <button type="button" class="btn btn-link text-white-50 text-decoration-none" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-info px-5 rounded-pill fw-bold text-dark">
                            <i class="bi bi-check-lg me-1"></i> حفظ التعديلات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Loading Overlay -->
    <div id="loadingOverlay" class="d-none position-fixed top-0 start-0 w-100 h-100 d-flex flex-column justify-content-center align-items-center" style="background: rgba(0, 0, 0, 0.85); z-index: 9999; backdrop-filter: blur(5px);">
        <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <h4 class="text-white fw-bold animate-pulse" id="loadingOverlayText">جاري حفظ البيانات...</h4>
        <p class="text-white-50">برجاء الانتظار لحظات ⏳</p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    // ===== Type Selector Logic =====
    function setupTypeSelector(selectorId, inputId) {
        const selector = document.getElementById(selectorId);
        if (!selector) return;
        const input = document.getElementById(inputId);
        const options = selector.querySelectorAll('.type-option');

        options.forEach(opt => {
            opt.addEventListener('click', () => {
                options.forEach(o => { o.classList.remove('selected-product', 'selected-service'); });
                const type = opt.getAttribute('data-type');
                opt.classList.add(type === 'product' ? 'selected-product' : 'selected-service');
                input.value = type;
            });
        });
    }

    setupTypeSelector('addTypeSelector', 'addTypeInput');
    setupTypeSelector('editTypeSelector', 'editTypeInput');

    // ===== Image Upload Manager =====
    function createUploadManager(dropZoneId, fileInputId, previewGridId, hiddenInputId, spinnerId, statusId) {
        const dropZone = document.getElementById(dropZoneId);
        const fileInput = document.getElementById(fileInputId);
        const previewGrid = document.getElementById(previewGridId);
        const hiddenInput = document.getElementById(hiddenInputId);
        const spinner = document.getElementById(spinnerId);
        const statusEl = document.getElementById(statusId);

        let uploadedImages = [];

        const syncHidden = () => { hiddenInput.value = JSON.stringify(uploadedImages); };

        const renderPreviews = () => {
            previewGrid.replaceChildren();
            uploadedImages.forEach((img, idx) => {
                const item = document.createElement('div');
                item.className = 'img-preview-item';

                const imgEl = document.createElement('img');
                imgEl.src = img.url;
                imgEl.alt = img.description || '';
                imgEl.loading = 'lazy';
                item.appendChild(imgEl);

                const removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.className = 'img-preview-remove';
                removeBtn.textContent = '×';
                removeBtn.title = 'حذف';
                removeBtn.addEventListener('click', () => {
                    uploadedImages.splice(idx, 1);
                    syncHidden();
                    renderPreviews();
                });
                item.appendChild(removeBtn);

                const descInput = document.createElement('input');
                descInput.type = 'text';
                descInput.className = 'img-desc-input';
                descInput.value = img.description || '';
                descInput.placeholder = 'وصف الصورة';
                descInput.addEventListener('input', (e) => {
                    uploadedImages[idx].description = e.target.value;
                    syncHidden();
                });
                item.appendChild(descInput);

                previewGrid.appendChild(item);
            });
        };

        const uploadFiles = async (files) => {
            if (!files || files.length === 0) return;
            spinner.classList.remove('d-none');
            statusEl.textContent = '';
            let uploaded = 0;
            for (const file of files) {
                const formData = new FormData();
                formData.append('image', file);
                try {
                    const res = await fetch('/dashboard/instructions/upload-image', { method: 'POST', body: formData });
                    const data = await res.json();
                    if (data.imageUrl) {
                        uploadedImages.push({ url: data.imageUrl, description: file.name.replace(/\.[^.]+$/, '') });
                        uploaded++;
                    }
                } catch (e) {
                    console.error('Upload failed:', e);
                }
            }
            spinner.classList.add('d-none');
            statusEl.textContent = uploaded > 0 ? `✅ تم رفع ${uploaded} صورة` : '❌ فشل الرفع';
            syncHidden();
            renderPreviews();
        };

        dropZone.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', () => uploadFiles(fileInput.files));
        dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('dragging'); });
        dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragging'));
        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('dragging');
            uploadFiles(e.dataTransfer.files);
        });

        return {
            setImages: (imgs) => { uploadedImages = imgs; syncHidden(); renderPreviews(); },
            getImages: () => uploadedImages
        };
    }

    const addManager = createUploadManager('addDropZone', 'addFileInput', 'addPreviewGrid', 'addImageUrlInput', 'addSpinner', 'addStatus');
    const editManager = createUploadManager('editDropZone', 'editFileInput', 'editPreviewGrid', 'editImageUrlInput', 'editSpinner', 'editStatus2');

    // Reset add modal on open
    document.getElementById('addProductModal').addEventListener('show.bs.modal', () => {
        document.getElementById('addName').value = '';
        document.getElementById('addDescription').value = '';
        document.getElementById('addPrice').value = '';
        document.getElementById('addCategory').value = '';
        document.getElementById('addTypeInput').value = 'product';
        // Reset type selector visuals
        document.getElementById('addTypeProduct').classList.add('selected-product');
        document.getElementById('addTypeProduct').classList.remove('selected-service');
        document.getElementById('addTypeService').classList.remove('selected-product', 'selected-service');
        addManager.setImages([]);
    });

    // Open edit modal
    window.openEditProduct = function(btn) {
        document.getElementById('editId').value = btn.getAttribute('data-id');
        document.getElementById('editName').value = btn.getAttribute('data-name');
        document.getElementById('editDescription').value = btn.getAttribute('data-description');
        document.getElementById('editPrice').value = btn.getAttribute('data-price');
        document.getElementById('editCategory').value = btn.getAttribute('data-category');
        document.getElementById('editCurrency').value = btn.getAttribute('data-currency');
        document.getElementById('editStatus').value = btn.getAttribute('data-status');

        const type = btn.getAttribute('data-type');
        document.getElementById('editTypeInput').value = type;
        // Reset type selector visuals
        const editOpts = document.querySelectorAll('#editTypeSelector .type-option');
        editOpts.forEach(o => o.classList.remove('selected-product', 'selected-service'));
        const editTypeProduct = document.getElementById('editTypeProduct');
        const editTypeService = document.getElementById('editTypeService');
        if (type === 'product' && editTypeProduct) {
            editTypeProduct.classList.add('selected-product');
        } else if (type === 'service' && editTypeService) {
            editTypeService.classList.add('selected-service');
        }

        let images = [];
        try { images = JSON.parse(btn.getAttribute('data-images')); } catch(e) {}
        editManager.setImages(images);

        new bootstrap.Modal(document.getElementById('editProductModal')).show();
    };

    // ===== Loading State on Submit =====
    const loadingOverlay = document.getElementById('loadingOverlay');
    const loadingText = document.getElementById('loadingOverlayText');

    document.getElementById('addProductForm').addEventListener('submit', function() {
        const btn = this.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> جاري الحفظ...';
        
        const modal = bootstrap.Modal.getInstance(document.getElementById('addProductModal'));
        if (modal) modal.hide();
        
        loadingText.textContent = 'جاري حفظ العنصر الجديد...';
        loadingOverlay.classList.remove('d-none');
    });

    document.getElementById('editProductForm').addEventListener('submit', function() {
        const btn = this.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> جاري التعديل...';
        
        const modal = bootstrap.Modal.getInstance(document.getElementById('editProductModal'));
        if (modal) modal.hide();
        
        loadingText.textContent = 'جاري حفظ التعديلات...';
        loadingOverlay.classList.remove('d-none');
    });
    </script>
</body>
</html>
