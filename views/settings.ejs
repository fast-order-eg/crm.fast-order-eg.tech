<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إعدادات المتابعة والتوقيتات - Bird-CRM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="/style.css?v=<%= Date.now() %>" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Modern Premium Tabs Styling */
        #settingsTabs {
            background: rgba(0, 0, 0, 0.03);
            padding: 8px;
            border-radius: 16px;
            border: 1px solid rgba(0, 0, 0, 0.05);
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
        }

        #settingsTabs .nav-link {
            color: var(--text-secondary);
            font-weight: 600;
            border-radius: 12px;
            padding: 12px 20px;
            transition: all 0.3s ease;
            border: 1px solid transparent;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        #settingsTabs .nav-link.active {
            background-color: var(--primary-color) !important;
            color: #000 !important;
            box-shadow: 0 4px 12px rgba(212, 175, 55, 0.2);
        }

        #settingsTabs .nav-link:hover:not(.active) {
            background-color: rgba(0, 0, 0, 0.05);
            color: var(--text-color);
        }

        .tab-content {
            margin-top: 24px;
        }

        textarea.form-control {
            background-color: #ffffff;
            border: 1px solid #cbd5e1;
            color: #0f172a;
            resize: vertical;
            min-height: 120px;
        }

        textarea.form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.15);
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-color);
            border-bottom: 2px solid var(--primary-color);
            padding-bottom: 8px;
            margin-bottom: 20px;
            display: inline-block;
        }
    </style>
</head>

<body>
    <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

    <div class="container-fluid main-content px-4 px-lg-5">
        <div class="glass-card p-4 p-md-5 animate-fade-in">
            <h2 class="mb-4 fw-bold d-flex align-items-center gap-2 text-dark">
                <i class="bi bi-gear-wide-connected text-warning"></i>
                إعدادات المتابعة والتوقيتات
            </h2>

            <!-- Success/Error Flash Alerts -->
            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4" role="alert" style="background: rgba(22, 163, 74, 0.1); border-color: rgba(22, 163, 74, 0.2); color: #16a34a;">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <div><%= success_msg %></div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4" role="alert" style="background: rgba(220, 38, 38, 0.1); border-color: rgba(220, 38, 38, 0.2); color: #dc2626;">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div><%= error_msg %></div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- Navigation Pills Tabs -->
            <ul class="nav nav-pills mb-4" id="settingsTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="messages-tab" data-bs-toggle="pill" data-bs-target="#messages-pane" type="button" role="tab" aria-controls="messages-pane" aria-selected="true">
                        <i class="bi bi-chat-left-text"></i>
                        رسائل المتابعة
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="timers-tab" data-bs-toggle="pill" data-bs-target="#timers-pane" type="button" role="tab" aria-controls="timers-pane" aria-selected="false">
                        <i class="bi bi-hourglass-split"></i>
                        التوقيتات والمدد
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="reminders-tab" data-bs-toggle="pill" data-bs-target="#reminders-pane" type="button" role="tab" aria-controls="reminders-pane" aria-selected="false">
                        <i class="bi bi-bell-fill text-warning"></i>
                        التذكيرات
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="ads-reports-tab" data-bs-toggle="pill" data-bs-target="#ads-reports-pane" type="button" role="tab" aria-controls="ads-reports-pane" aria-selected="false">
                        <i class="bi bi-graph-up-arrow text-primary"></i>
                        تقارير الإعلانات
                    </button>
                </li>
            </ul>

            <!-- Unified Form for all settings -->
            <form action="/dashboard/settings/update" method="POST">
                <!-- Tabs Content -->
                <div class="tab-content" id="settingsTabsContent">
                    
                    <!-- 1. Follow-up Messages Tab -->
                    <div class="tab-pane fade show active" id="messages-pane" role="tabpanel" aria-labelledby="messages-tab">
                        <h5 class="section-title">رسائل المتابعة التلقائية للعملاء</h5>
                        
                        <div class="row g-4">
                            <!-- First Follow-up Section -->
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm p-4 rounded-4 bg-light mb-3">
                                    <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-chat-dots text-primary me-1"></i> المتابعة الأولى</h6>
                                    
                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-secondary small">نوع المتابعة الأولى</label>
                                        <select name="first_followup_type" id="first_followup_type" class="form-select border-0 shadow-sm py-2.5 rounded-3 fw-medium">
                                            <option value="static" <%= settings.first_followup_type === 'static' ? 'selected' : '' %>>ثابتة (إرسال الرسالة النموذجية كما هي)</option>
                                            <option value="dynamic" <%= settings.first_followup_type === 'dynamic' ? 'selected' : '' %>>متغيرة بالذكاء الاصطناعي (ذكية بناءً على سياق الدردشة)</option>
                                            <option value="meta_template" <%= settings.first_followup_type === 'meta_template' ? 'selected' : '' %>>قالب معتمد عبر WhatsApp Business Meta API الرسمية 🟢</option>
                                        </select>
                                        <div class="form-text text-muted small mt-1">التبديل الذكي (Smart Fallback): إذا كان العميل خارج نافذة الـ 24 ساعة، سيتولى النظام تحويل المتابعة تلقائياً إلى قالب ميتا المعتمد لتفادي الفشل.</div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-secondary small"><i class="bi bi-patch-check-fill text-primary me-1"></i> اسم قالب ميتا للمتابعة الأولى (Meta Template Name)</label>
                                        <input type="text" name="first_followup_template_name" class="form-control rounded-3 border-primary-subtle" placeholder="مثال: followup_3days" value="<%= settings.first_followup_template_name || 'followup_3days' %>">
                                        <div class="form-text text-muted small mt-1">اسم القالب كما هو مقبول ومسجل داخل حساب ميتا الخاص بك (يُستخدم مباشرة أو كبديل آمن عند انتهاء الـ 24 ساعة).</div>
                                    </div>

                                    <div class="mb-0">
                                        <label class="form-label fw-bold text-secondary small">نص الرسالة النموذجية (أو السياق الأساسي للمتابعة)</label>
                                        <textarea name="first_followup_message" class="form-control rounded-3" rows="4"><%= settings.first_followup_message %></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Final Follow-up Section -->
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm p-4 rounded-4 bg-light mb-3">
                                    <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-chat-heart text-danger me-1"></i> المتابعة النهائية</h6>
                                    
                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-secondary small">نوع المتابعة النهائية</label>
                                        <select name="final_followup_type" id="final_followup_type" class="form-select border-0 shadow-sm py-2.5 rounded-3 fw-medium">
                                            <option value="static" <%= settings.final_followup_type === 'static' ? 'selected' : '' %>>ثابتة (إرسال الرسالة النموذجية كما هي)</option>
                                            <option value="dynamic" <%= settings.final_followup_type === 'dynamic' ? 'selected' : '' %>>متغيرة بالذكاء الاصطناعي (ذكية بناءً على سياق الدردشة)</option>
                                            <option value="meta_template" <%= settings.final_followup_type === 'meta_template' ? 'selected' : '' %>>قالب معتمد عبر WhatsApp Business Meta API الرسمية 🟢</option>
                                        </select>
                                        <div class="form-text text-muted small mt-1">إذا انقضت 24 ساعة على العميل، سيقوم النظام تلقائياً بإرسال القالب بدلاً من النص العادي المرفوض.</div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-secondary small"><i class="bi bi-patch-check-fill text-danger me-1"></i> اسم قالب ميتا للمتابعة النهائية (Meta Template Name)</label>
                                        <input type="text" name="final_followup_template_name" class="form-control rounded-3 border-danger-subtle" placeholder="مثال: followup_3days" value="<%= settings.final_followup_template_name || 'followup_3days' %>">
                                        <div class="form-text text-muted small mt-1">اسم القالب كما هو مقبول ومسجل داخل حساب ميتا الخاص بك.</div>
                                    </div>

                                    <div class="mb-0">
                                        <label class="form-label fw-bold text-secondary small">نص الرسالة النموذجية أو السياق الأساسي للمتابعة</label>
                                        <textarea name="final_followup_message" class="form-control rounded-3" rows="4"><%= settings.final_followup_message %></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Timings Tab -->
                    <div class="tab-pane fade" id="timers-pane" role="tabpanel" aria-labelledby="timers-tab">
                        <h5 class="section-title">⏱️ مدد الانتظار وجدولة المتابعات</h5>
                        
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm p-4 rounded-4 bg-light h-100">
                                    <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-clock text-warning me-1"></i> تأخير المتابعات</h6>
                                    
                                    <div class="mb-4">
                                        <label class="form-label fw-bold text-secondary small">تأخير المتابعة الأولى</label>
                                        <div class="input-group shadow-sm rounded-3 overflow-hidden">
                                            <input type="number" name="first_followup_delay" class="form-control border-0 bg-white py-2.5 px-3" value="<%= settings.first_followup_delay %>" required min="1">
                                            <select name="first_followup_delay_unit" class="form-select border-0 bg-white text-center fw-medium py-2.5" style="max-width: 120px; border-inline-start: 1px solid #cbd5e1 !important;">
                                                <option value="hours" <%= settings.first_followup_delay_unit === 'hours' ? 'selected' : '' %>>ساعة</option>
                                                <option value="minutes" <%= settings.first_followup_delay_unit === 'minutes' ? 'selected' : '' %>>دقيقة</option>
                                            </select>
                                        </div>
                                        <div class="alert alert-info border-0 shadow-sm mt-3 mb-0 py-2.5 px-3 rounded-3 small">
                                            <i class="bi bi-info-circle-fill me-1 text-info"></i>
                                            <span>بمجرد تغيير حالة العميل إلى "المتابعة الأولى" (يدوياً بواسطة السيلز أو تلقائياً بواسطة البوت عند سكون العميل)، سيتم الانتظار لمدة </span>
                                            <strong id="first_followup_explain_val" class="text-dark"><%= settings.first_followup_delay %> <%= settings.first_followup_delay_unit === 'hours' ? 'ساعة' : 'دقيقة' %></strong>
                                            <span> ثم إرسال رسالة المتابعة الأولى تلقائياً.</span>
                                        </div>
                                    </div>



                                    <div class="mb-0">
                                        <label class="form-label fw-bold text-secondary small">تأخير المتابعة النهائية</label>
                                        <div class="input-group shadow-sm rounded-3 overflow-hidden">
                                            <input type="number" name="final_followup_delay" class="form-control border-0 bg-white py-2.5 px-3" value="<%= settings.final_followup_delay %>" required min="1">
                                            <select name="final_followup_delay_unit" class="form-select border-0 bg-white text-center fw-medium py-2.5" style="max-width: 120px; border-inline-start: 1px solid #cbd5e1 !important;">
                                                <option value="hours" <%= settings.final_followup_delay_unit === 'hours' ? 'selected' : '' %>>ساعة</option>
                                                <option value="minutes" <%= settings.final_followup_delay_unit === 'minutes' ? 'selected' : '' %>>دقيقة</option>
                                            </select>
                                        </div>
                                        <div class="alert alert-info border-0 shadow-sm mt-3 mb-0 py-2.5 px-3 rounded-3 small">
                                            <i class="bi bi-info-circle-fill me-1 text-info"></i>
                                            <span>بعد إرسال رسالة المتابعة الأولى بنجاح، سيتم الانتظار لمدة </span>
                                            <strong id="final_followup_explain_val" class="text-dark"><%= settings.final_followup_delay %> <%= settings.final_followup_delay_unit === 'hours' ? 'ساعة' : 'دقيقة' %></strong>
                                            <span> ثم إرسال رسالة المتابعة النهائية (العرض) تلقائياً للعميل.</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm p-4 rounded-4 bg-light h-100">
                                    <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-gear text-secondary me-1"></i> إعدادات وخصائص إضافية</h6>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-secondary small">تحويل العميل للمبيعات تلقائياً (بالدقائق)</label>
                                        <input type="number" name="no_action_timeout" class="form-control rounded-3" value="<%= settings.no_action_timeout %>" required min="1">
                                        <div class="form-text text-muted">المدة بالدقائق التي ينتظرها البوت دون تفاعل من العميل قبل تحويل المحادثة لمندوب المبيعات تلقائياً.</div>
                                    </div>

                                    <div class="form-check form-switch d-flex align-items-center justify-content-between p-3 border rounded-3 bg-white shadow-sm mb-3" style="direction: rtl;">
                                        <div>
                                            <label class="form-check-label fw-bold text-dark small mb-1" for="enable_whatsapp_notifications" style="cursor: pointer;">تفعيل إرسال الإشعارات والملخصات على الواتساب</label>
                                            <div class="form-text text-muted small">عند تفعيله، يتم إرسال إشعارات التحويل وملخصات الـ 15 دقيقة عبر بوت الإشعارات إلى الواتساب للأدمن وللموظفين.</div>
                                        </div>
                                        <input class="form-check-input ms-0" type="checkbox" role="switch" id="enable_whatsapp_notifications" name="enable_whatsapp_notifications" value="true" <%= settings.enable_whatsapp_notifications ? 'checked' : '' %> style="cursor: pointer; width: 2.8em; height: 1.4em;">
                                    </div>

                                    <div class="form-check form-switch d-flex align-items-center justify-content-between p-3 border rounded-3 bg-white shadow-sm mb-0" style="direction: rtl;">
                                        <div>
                                            <label class="form-check-label fw-bold text-dark small mb-1" for="sales_view_own_chats_only" style="cursor: pointer;">كل موظف يرى محادثاته فقط</label>
                                            <div class="form-text text-muted small">عند تفعيله، سيتمكن موظفو المبيعات (Sales) من رؤية المحادثات المخصصة لهم فقط. عند تعطيله، يرى الجميع كافة المحادثات.</div>
                                        </div>
                                        <input class="form-check-input ms-0" type="checkbox" role="switch" id="sales_view_own_chats_only" name="sales_view_own_chats_only" value="true" <%= settings.sales_view_own_chats_only ? 'checked' : '' %> style="cursor: pointer; width: 2.8em; height: 1.4em;">
                                    </div>

                                    <div class="mb-0 mt-4 p-4 border rounded-4 bg-white shadow-sm position-relative">
                                        <div class="d-flex align-items-center mb-3">
                                            <div class="bg-success bg-opacity-10 p-2 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                <i class="bi bi-whatsapp text-success fs-5"></i>
                                            </div>
                                            <h6 class="fw-bold mb-0 text-dark">مجموعة تحويل الاستفسارات</h6>
                                        </div>
                                        <p class="text-muted small mb-3 lh-lg">
                                            يتم تحويل استفسارات العملاء التي تتطلب تدخل بشري إلى جروب واتساب مخصص. يجب إنشاء جروب بهذا الاسم الدقيق:
                                        </p>
                                        <div class="d-flex align-items-center justify-content-between bg-light rounded-3 p-3 mb-4 border">
                                            <strong class="text-dark fs-5 font-monospace" style="letter-spacing: 1px;">Bird CRM</strong>
                                            <button type="button" class="btn btn-light border shadow-sm py-1 px-2 transition-all hover-scale" onclick="copyGroupName(this)" title="نسخ اسم الجروب">
                                                <i class="far fa-copy text-secondary"></i>
                                            </button>
                                        </div>
                                        
                                        <button type="button" id="checkGroupBtn" class="btn btn-primary w-100 fw-bold rounded-3 py-2 shadow-sm transition-all">
                                            <i class="bi bi-search me-1"></i> فحص حالة الجروب
                                        </button>
                                        <div id="checkGroupResult" class="mt-3 small rounded-3" style="display: none;"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Working Hours & Daily Schedule Section -->
                            <div class="col-12 mt-2">
                                <div class="card border-0 shadow-sm p-4 rounded-4 bg-light">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                                        <div>
                                            <h6 class="fw-bold mb-1 text-dark">
                                                <i class="bi bi-calendar-week text-success me-1"></i>
                                                مواعيد وساعات العمل الرسمية والشفتات اليومية
                                            </h6>
                                            <div class="text-muted small">
                                                عند التفعيل، سيعمل البوت والذكاء الاصطناعي 24 ساعة للرد على العملاء، ولن يتم تحويل العميل للمبيعات تلقائياً أثناء الليل أو في أيام العطلات (مثل الجمعة).
                                            </div>
                                        </div>
                                        <div class="form-check form-switch m-0" style="direction: rtl;">
                                            <input class="form-check-input ms-0" type="checkbox" role="switch" id="working_hours_enabled" name="working_hours_enabled" value="true" <%= settings.working_hours_enabled ? 'checked' : '' %> style="cursor: pointer; width: 2.8em; height: 1.4em;" onchange="toggleWorkingHoursTable(this.checked)">
                                        </div>
                                    </div>

                                    <div id="workingHoursContainer" style="<%= settings.working_hours_enabled ? '' : 'opacity: 0.5; pointer-events: none;' %>">
                                        <div class="table-responsive bg-white rounded-3 border shadow-sm p-3 mb-3">
                                            <table class="table table-borderless align-middle mb-0">
                                                <thead>
                                                    <tr class="border-bottom text-secondary small">
                                                        <th style="width: 140px;">اليوم</th>
                                                        <th style="width: 180px;">حالة اليوم</th>
                                                        <th>بداية العمل (صباحاً)</th>
                                                        <th>نهاية العمل (مساءً)</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% 
                                                    const defaultSchedule = {
                                                        "السبت": { enabled: true, start: "10:00", end: "23:00" },
                                                        "الأحد": { enabled: true, start: "10:00", end: "23:00" },
                                                        "الإثنين": { enabled: true, start: "10:00", end: "23:00" },
                                                        "الثلاثاء": { enabled: true, start: "10:00", end: "23:00" },
                                                        "الأربعاء": { enabled: true, start: "10:00", end: "23:00" },
                                                        "الخميس": { enabled: true, start: "10:00", end: "23:00" },
                                                        "الجمعة": { enabled: false, start: "10:00", end: "23:00" }
                                                    };
                                                    const currentSchedule = (typeof settings.working_hours_schedule === 'object' && settings.working_hours_schedule) ? settings.working_hours_schedule : defaultSchedule;
                                                    const daysOfWeek = ['السبت', 'الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة'];
                                                    daysOfWeek.forEach(day => {
                                                        const dayData = currentSchedule[day] || defaultSchedule[day] || { enabled: true, start: '10:00', end: '23:00' };
                                                        const isDayEnabled = dayData.enabled === true || dayData.enabled === 'true';
                                                    %>
                                                    <tr class="border-bottom">
                                                        <td><strong class="text-dark"><%= day %></strong></td>
                                                        <td>
                                                            <div class="form-check form-switch m-0">
                                                                <input class="form-check-input" type="checkbox" name="working_hours_schedule[<%= day %>][enabled]" value="true" <%= isDayEnabled ? 'checked' : '' %> id="day_<%= day %>">
                                                                <label class="form-check-label small fw-medium <%= isDayEnabled ? 'text-success' : 'text-muted' %>" for="day_<%= day %>">
                                                                    <%= isDayEnabled ? 'يوم عمل' : 'عطلة (البوت فقط)' %>
                                                                </label>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <input type="time" name="working_hours_schedule[<%= day %>][start]" class="form-control form-control-sm rounded-2 text-center" value="<%= dayData.start || '10:00' %>" style="max-width: 140px;">
                                                        </td>
                                                        <td>
