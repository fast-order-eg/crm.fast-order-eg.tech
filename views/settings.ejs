                                <div class="d-flex align-items-center">
                                    <i class="bi bi-whatsapp text-success me-1.5 fs-6"></i>
                                    <span class="font-monospace fw-bold text-dark fs-7">${staff.phone}</span>
                                </div>
                            </td>
                            <td class="text-center">${actionHtml}</td>
                        </tr>
                    `;
                }).join('');
            }

            const addNewTargetingStaffBtn = document.getElementById('addNewTargetingStaffBtn');
            if (addNewTargetingStaffBtn) {
                addNewTargetingStaffBtn.addEventListener('click', async () => {
                    const nameInput = document.getElementById('newTargetingName');
                    const phoneInput = document.getElementById('newTargetingPhone');
                    const alertDiv = document.getElementById('targetingStaffAlert');

                    const name = nameInput ? nameInput.value.trim() : '';
                    const phone = phoneInput ? phoneInput.value.trim() : '';

                    if (!phone) {
                        if (alertDiv) {
                            alertDiv.className = 'mt-2 small text-danger';
                            alertDiv.innerHTML = '⚠️ يرجى إدخال رقم الواتساب.';
                            alertDiv.style.display = 'block';
                        }
                        return;
                    }

                    addNewTargetingStaffBtn.disabled = true;
                    addNewTargetingStaffBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> جاري...';

                    try {
                        const res = await fetch('/dashboard/settings/targeting-staff/add', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ name, phone, role: 'مسؤول استهداف وميديا باير' })
                        });
                        const data = await res.json();

                        if (alertDiv) {
                            alertDiv.style.display = 'block';
                            if (data.success) {
                                alertDiv.className = 'mt-2 small text-success';
                                alertDiv.innerHTML = data.message || '✅ تم إضافة الرقم بنجاح.';
                                if (nameInput) nameInput.value = '';
                                if (phoneInput) phoneInput.value = '';
                                if (data.staff) updateTargetingStaffUI(data.staff);
                            } else {
                                alertDiv.className = 'mt-2 small text-danger';
                                alertDiv.innerHTML = data.error || 'حدث خطأ أثناء الإضافة.';
                            }
                        }
                    } catch (err) {
                        if (alertDiv) {
                            alertDiv.className = 'mt-2 small text-danger';
                            alertDiv.innerHTML = 'حدث خطأ بالاتصال بالخادم: ' + err.message;
                            alertDiv.style.display = 'block';
                        }
                    } finally {
                        addNewTargetingStaffBtn.disabled = false;
                        addNewTargetingStaffBtn.innerHTML = '<i class="bi bi-plus-lg me-1"></i> إضافة';
                    }
                });
            }

            window.deleteTargetingStaff = async function(phone, name) {
                if (!confirm(`هل أنت متأكد من إزالة صلاحية "${name}" (${phone}) من خدمة الاستهدافات؟`)) {
                    return;
                }

                try {
                    const res = await fetch('/dashboard/settings/targeting-staff/delete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ phone })
                    });
                    const data = await res.json();
                    if (data.success) {
                        if (data.staff) {
                            updateTargetingStaffUI(data.staff);
                        } else {
                            const row = document.getElementById(`targeting-row-${phone}`);
                            if (row) row.remove();
                        }
                    } else {
                        alert(data.error || 'تعذر حذف الرقم');
                    }
                } catch (e) {
                    alert('حدث خطأ أثناء الحذف: ' + e.message);
                }
            };

            window.copyTargetingCmd = function(cmd, btn) {
                navigator.clipboard.writeText(cmd).then(() => {
                    const origHtml = btn.innerHTML;
                    btn.innerHTML = '<i class="bi bi-check2 text-success me-1"></i>تم النسخ';
                    setTimeout(() => { btn.innerHTML = origHtml; }, 2000);
                }).catch(() => {
                    prompt('انسخ الأمر التالي:', cmd);
                });
            };

            // جلب وفحص جروب التحكم في الحملات الإعلانية
            const refreshCampaignControlGroupsBtn = document.getElementById('refreshCampaignControlGroupsBtn');
            const campaignControlGroupSelect = document.getElementById('campaignControlGroupSelect');
            const campaignControlGroupName = document.getElementById('campaignControlGroupName');
            const checkCampaignControlGroupBtn = document.getElementById('checkCampaignControlGroupBtn');
            const checkCampaignControlGroupResult = document.getElementById('checkCampaignControlGroupResult');

            if (refreshCampaignControlGroupsBtn && campaignControlGroupSelect) {
                refreshCampaignControlGroupsBtn.addEventListener('click', async () => {
                    refreshCampaignControlGroupsBtn.disabled = true;
                    refreshCampaignControlGroupsBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> جاري الجلب...';

                    try {
                        const res = await fetch('/dashboard/settings/whatsapp-groups');
                        const data = await res.json();
                        if (data.success && data.groups) {
                            const currentVal = campaignControlGroupSelect.value;
                            campaignControlGroupSelect.innerHTML = '<option value="">⚡ التعرف التلقائي على أي جروب اسمه (التحكم في الإعلانات / تحكم / Control)</option>';
                            data.groups.forEach(g => {
                                const opt = document.createElement('option');
                                opt.value = g.id;
                                opt.textContent = `👥 ${g.subject}`;
                                if (g.id === currentVal) opt.selected = true;
                                campaignControlGroupSelect.appendChild(opt);
                            });
                            if (currentVal && !data.groups.some(g => g.id === currentVal)) {
                                const opt = document.createElement('option');
                                opt.value = currentVal;
                                opt.textContent = `📌 الجروب المحفوظ (${campaignControlGroupName ? campaignControlGroupName.value : currentVal})`;
                                opt.selected = true;
                                campaignControlGroupSelect.appendChild(opt);
                            }
                        } else {
                            alert(data.error || 'فشل جلب الجروبات. تأكد من اتصال البوت بالواتساب.');
                        }
                    } catch (e) {
                        alert('حدث خطأ أثناء جلب الجروبات: ' + e.message);
                    } finally {
                        refreshCampaignControlGroupsBtn.disabled = false;
                        refreshCampaignControlGroupsBtn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> جلب الجروبات';
                    }
                });

                campaignControlGroupSelect.addEventListener('change', () => {
                    const selectedOpt = campaignControlGroupSelect.options[campaignControlGroupSelect.selectedIndex];
                    if (campaignControlGroupName && selectedOpt) {
                        campaignControlGroupName.value = selectedOpt.textContent.replace('👥 ', '').replace('⚡ ', '').trim();
                    }
                });

                const campaignControlTabBtn = document.getElementById('campaign-control-tab');
                if (campaignControlTabBtn) {
                    campaignControlTabBtn.addEventListener('shown.bs.tab', () => {
                        if (campaignControlGroupSelect.options.length <= 2 && !refreshCampaignControlGroupsBtn.disabled) {
                            refreshCampaignControlGroupsBtn.click();
                        }
                    });
                }
            }

            if (checkCampaignControlGroupBtn && checkCampaignControlGroupResult) {
                checkCampaignControlGroupBtn.addEventListener('click', async () => {
                    checkCampaignControlGroupBtn.disabled = true;
                    checkCampaignControlGroupBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> جاري الفحص...';
                    checkCampaignControlGroupResult.style.display = 'none';

                    try {
                        const res = await fetch('/dashboard/settings/check-campaign-control-group');
                        const data = await res.json();
                        checkCampaignControlGroupResult.style.display = 'block';

                        if (data.status === 'found') {
                            checkCampaignControlGroupResult.className = 'mt-3 small p-3 rounded-3 bg-success bg-opacity-10 text-success border border-success';
                            checkCampaignControlGroupResult.innerHTML = `<div class="d-flex align-items-center fw-bold"><i class="bi bi-check-circle-fill fs-5 me-2"></i> ${data.message}</div>`;
                        } else if (data.status === 'disconnected') {
                            checkCampaignControlGroupResult.className = 'mt-3 small p-3 rounded-3 bg-danger text-white';
                            checkCampaignControlGroupResult.innerHTML = `<i class="bi bi-x-circle me-1"></i> ${data.message}`;
                        } else {
                            checkCampaignControlGroupResult.className = 'mt-3 small p-3 rounded-3 bg-warning text-dark border border-warning';
                            checkCampaignControlGroupResult.innerHTML = `<i class="bi bi-exclamation-triangle me-1"></i> ${data.message}`;
                        }
                    } catch (e) {
                        checkCampaignControlGroupResult.style.display = 'block';
                        checkCampaignControlGroupResult.className = 'mt-3 small p-3 rounded-3 bg-danger text-white';
                        checkCampaignControlGroupResult.innerHTML = 'حدث خطأ أثناء الفحص: ' + e.message;
                    } finally {
                        checkCampaignControlGroupBtn.disabled = false;
                        checkCampaignControlGroupBtn.innerHTML = '<i class="bi bi-search me-1"></i> فحص حالة جروب التحكم في الإعلانات';
                    }
                });
            }

            // Copy command buttons
            document.querySelectorAll('.copy-cmd-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const cmd = btn.getAttribute('data-cmd');
                    if (cmd) {
                        navigator.clipboard.writeText(cmd).then(() => {
                            const originalHtml = btn.innerHTML;
                            btn.innerHTML = '<i class="bi bi-check2 text-success me-1"></i> تم النسخ!';
                            setTimeout(() => {
                                btn.innerHTML = originalHtml;
                            }, 2000);
                        }).catch(() => {
                            prompt('انسخ الأمر التالي:', cmd);
                        });
                    }
                });
            });
        });
    </script>
</body>

</html>