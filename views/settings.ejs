            const checkAdsReportGroupBtn = document.getElementById('checkAdsReportGroupBtn');
            const checkAdsReportGroupResult = document.getElementById('checkAdsReportGroupResult');

            if (refreshAdsReportGroupsBtn && adsReportGroupSelect) {
                refreshAdsReportGroupsBtn.addEventListener('click', async () => {
                    refreshAdsReportGroupsBtn.disabled = true;
                    refreshAdsReportGroupsBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> جاري الجلب...';
                    try {
