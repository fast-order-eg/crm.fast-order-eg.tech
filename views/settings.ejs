                    } catch (e) {
                        alert('حدث خطأ أثناء جلب الجروبات: ' + e.message);
                    } finally {
                        refreshGroupsBtn.disabled = false;
                        refreshGroupsBtn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> جلب الجروبات';
