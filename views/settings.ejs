                                                                    <%= isDayEnabled ? 'يوم عمل' : 'عطلة (البوت فقط)' %>
                                                                </label>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <input type="time" name="working_hours_schedule[<%= day %>][start]" class="form-control form-control-sm rounded-2 text-center" value="<%= dayData.start || '10:00' %>" style="max-width: 140px;">
