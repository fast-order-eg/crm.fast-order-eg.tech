    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Persistence of active Bootstrap tab across reloads/redirects -->
    <script>
        function toggleTemplateInputs() {
            const firstType = document.getElementById('first_followup_type')?.value;
            const finalType = document.getElementById('final_followup_type')?.value;
            const firstDiv = document.getElementById('first_followup_template_div');
            const finalDiv = document.getElementById('final_followup_template_div');

            if (firstDiv) {
                firstDiv.style.display = (firstType === 'meta_template') ? 'block' : 'none';
            }
            if (finalDiv) {
                finalDiv.style.display = (finalType === 'meta_template') ? 'block' : 'none';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            toggleTemplateInputs();
            // Restore active tab
            const activeTabId = localStorage.getItem('activeSettingsTab');
            if (activeTabId) {
                const tabEl = document.querySelector(`#settingsTabs button[id="${activeTabId}"]`);
                if (tabEl) {
                    const tabTrigger = new bootstrap.Tab(tabEl);
                    tabTrigger.show();
                }
            }

            // Save active tab on click
            const tabButtons = document.querySelectorAll('#settingsTabs button[data-bs-toggle="pill"]');
            tabButtons.forEach(btn => {
                btn.addEventListener('shown.bs.tab', (e) => {
                    localStorage.setItem('activeSettingsTab', e.target.id);
                });
            });

            // --- تفاعل التوقيت والوحدات ديناميكياً ---
            const firstDelayInput = document.querySelector('input[name="first_followup_delay"]');
            const firstUnitSelect = document.querySelector('select[name="first_followup_delay_unit"]');
            const firstExplainVal = document.getElementById('first_followup_explain_val');

            const finalDelayInput = document.querySelector('input[name="final_followup_delay"]');
            const finalUnitSelect = document.querySelector('select[name="final_followup_delay_unit"]');
            const finalExplainVal = document.getElementById('final_followup_explain_val');

            if (firstUnitSelect) firstUnitSelect.dataset.prev = firstUnitSelect.value;
            if (finalUnitSelect) finalUnitSelect.dataset.prev = finalUnitSelect.value;

            function updateFirstExplain() {
                if (!firstDelayInput || !firstUnitSelect || !firstExplainVal) return;
                const val = firstDelayInput.value || 0;
                const unitText = firstUnitSelect.value === 'hours' ? 'ساعة' : 'دقيقة';
                firstExplainVal.textContent = `${val} ${unitText}`;
            }

            function updateFinalExplain() {
                if (!finalDelayInput || !finalUnitSelect || !finalExplainVal) return;
                const val = finalDelayInput.value || 0;
                const unitText = finalUnitSelect.value === 'hours' ? 'ساعة' : 'دقيقة';
                finalExplainVal.textContent = `${val} ${unitText}`;
            }

            if (firstDelayInput) {
                firstDelayInput.addEventListener('input', updateFirstExplain);
            }
            if (firstUnitSelect) {
                firstUnitSelect.addEventListener('change', (e) => {
                    const currentUnit = e.target.value;
                    const prevUnit = e.target.dataset.prev;
                    let val = parseFloat(firstDelayInput.value) || 0;

                    if (currentUnit !== prevUnit) {
                        if (currentUnit === 'minutes' && prevUnit === 'hours') {
                            firstDelayInput.value = Math.round(val * 60);
                        } else if (currentUnit === 'hours' && prevUnit === 'minutes') {
                            firstDelayInput.value = Math.max(1, Math.round(val / 60));
                        }
                        e.target.dataset.prev = currentUnit;
                        updateFirstExplain();
                    }
                });
            }

            if (finalDelayInput) {
                finalDelayInput.addEventListener('input', updateFinalExplain);
            }
            if (finalUnitSelect) {
                finalUnitSelect.addEventListener('change', (e) => {
                    const currentUnit = e.target.value;
                    const prevUnit = e.target.dataset.prev;
                    let val = parseFloat(finalDelayInput.value) || 0;

                    if (currentUnit !== prevUnit) {
                        if (currentUnit === 'minutes' && prevUnit === 'hours') {
                            finalDelayInput.value = Math.round(val * 60);
                        } else if (currentUnit === 'hours' && prevUnit === 'minutes') {
                            finalDelayInput.value = Math.max(1, Math.round(val / 60));
                        }
                        e.target.dataset.prev = currentUnit;
                        updateFinalExplain();
                    }
                });
            }

            // --- فحص الجروب ---
            const checkGroupBtn = document.getElementById('checkGroupBtn');
            const checkGroupResult = document.getElementById('checkGroupResult');
            if (checkGroupBtn) {
                checkGroupBtn.addEventListener('click', async () => {
                    checkGroupBtn.disabled = true;
                    checkGroupBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> جاري الفحص...';
                    checkGroupResult.style.display = 'none';
                    checkGroupResult.className = 'mt-2 small p-2 rounded';
                    
                    try {
                        const response = await fetch('/dashboard/settings/check-group');
                        const data = await response.json();
                        
                        checkGroupResult.style.display = 'block';
                        if (data.status === 'disconnected') {
                            checkGroupResult.classList.add('bg-danger', 'text-white', 'p-3');
                            checkGroupResult.innerHTML = '<i class="bi bi-x-circle me-1"></i> بوت واتساب الإشعارات الثانوي (Baileys) غير متصل، يرجى مسح كود الـ QR وتوصيله أولاً من الرئيسية.';
                        } else if (data.status === 'not_found') {
                            checkGroupResult.classList.add('bg-warning', 'text-dark', 'p-3');
                            checkGroupResult.innerHTML = `
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-exclamation-triangle fs-5 me-2"></i> 
                                    <strong>الجروب غير موجود!</strong>
                                </div>
                                <div class="mb-2">برجاء إنشاء الجروب بالاسم: <strong class="mx-1">Bird CRM</strong> 
                                <button type="button" class="btn btn-sm btn-light border py-0 px-1 mx-1" onclick="copyGroupName(this)" title="نسخ"><i class="far fa-copy"></i></button></div>
                                <small class="text-muted d-block mt-2 border-top border-warning pt-2"><i class="bi bi-info-circle me-1"></i> تأكد من إضافة رقم بوت الإشعارات الثانوي كمسؤول (Admin) داخل الجروب.</small>
                            `;
                        } else if (data.status === 'found') {
                            checkGroupResult.classList.add('bg-success', 'bg-opacity-10', 'text-success', 'border', 'border-success', 'p-3');
                            checkGroupResult.innerHTML = '<div class="d-flex align-items-center fw-bold"><i class="bi bi-check-circle-fill fs-5 me-2"></i> تم فحص الجروب بنجاح (بوت الإشعارات متصل بجروب Bird CRM بنجاح).</div>';
                        }
                    } catch (error) {
                        checkGroupResult.style.display = 'block';
                        checkGroupResult.classList.add('bg-danger', 'text-white');
                        checkGroupResult.innerHTML = 'حدث خطأ أثناء الفحص.';
                    } finally {
                        checkGroupBtn.disabled = false;
                        checkGroupBtn.innerHTML = '<i class="bi bi-search me-1"></i> فحص الجروب';
                    }
                });
            }
        });

        // Copy Group Name function
        function copyGroupName(btn) {
            navigator.clipboard.writeText('Bird CRM').then(() => {
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-check text-success"></i>';
                
                // Show floating notification
                const toast = document.createElement('div');
                toast.className = 'position-fixed bottom-0 start-50 translate-middle-x p-3';
                toast.style.zIndex = '1050';
                toast.innerHTML = `
                    <div class="toast align-items-center text-white bg-success border-0 show shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="d-flex">
                            <div class="toast-body fw-bold">
                                <i class="bi bi-check-circle me-2"></i> تم نسخ اسم الجروب
                            </div>
                        </div>
                    </div>
                `;
                document.body.appendChild(toast);
                
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    toast.classList.add('fade');
                    setTimeout(() => document.body.removeChild(toast), 300);
                }, 2000);
            });
        }

        function toggleWorkingHoursTable(enabled) {
            const container = document.getElementById('workingHoursContainer');
            if (container) {
                if (enabled) {
                    container.style.opacity = '1';
                    container.style.pointerEvents = 'auto';
                } else {
                    container.style.opacity = '0.5';
                    container.style.pointerEvents = 'none';
                }
            }
        }

        // Update day switch labels on toggle
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('input[id^="day_"]').forEach(sw => {
                sw.addEventListener('change', function() {
                    const label = this.nextElementSibling;
                    if (label) {
                        if (this.checked) {
                            label.textContent = 'يوم عمل';
                            label.classList.remove('text-muted');
                            label.classList.add('text-success');
                        } else {
                            label.textContent = 'عطلة (البوت فقط)';
                            label.classList.remove('text-success');
                            label.classList.add('text-muted');
                        }
                    }
                });
            });
        });

        // --- فحص وجلب جروبات التذكيرات ---
        document.addEventListener('DOMContentLoaded', function() {
            const refreshGroupsBtn = document.getElementById('refreshGroupsBtn');
            const reminderGroupSelect = document.getElementById('reminderGroupSelect');
            const reminderGroupName = document.getElementById('reminderGroupName');
            const checkReminderGroupBtn = document.getElementById('checkReminderGroupBtn');
            const checkReminderGroupResult = document.getElementById('checkReminderGroupResult');

            if (refreshGroupsBtn && reminderGroupSelect) {
                refreshGroupsBtn.addEventListener('click', async () => {
                    refreshGroupsBtn.disabled = true;
                    refreshGroupsBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> جاري الجلب...';
                    try {
                        const res = await fetch('/dashboard/settings/whatsapp-groups');
                        const data = await res.json();
                        if (data.success && data.groups) {
                            const currentVal = reminderGroupSelect.value;
                            reminderGroupSelect.innerHTML = '<option value="">⚡ التعرف التلقائي على أي جروب اسمه (تذكيرات)</option>';
                            data.groups.forEach(g => {
                                const opt = document.createElement('option');
                                opt.value = g.id;
                                opt.textContent = `👥 ${g.subject}`;
                                if (g.id === currentVal) opt.selected = true;
                                reminderGroupSelect.appendChild(opt);
                            });
                        } else {
                            alert(data.error || 'تعذر جلب الجروبات. تأكد من اتصال بوت الواتساب.');
                        }
                    } catch (e) {
                        alert('حدث خطأ أثناء جلب الجروبات: ' + e.message);
                    } finally {
                        refreshGroupsBtn.disabled = false;
                        refreshGroupsBtn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> جلب الجروبات';
                    }
                });

                reminderGroupSelect.addEventListener('change', () => {
                    const selectedOpt = reminderGroupSelect.options[reminderGroupSelect.selectedIndex];
                    if (reminderGroupName && selectedOpt) {
                        reminderGroupName.value = selectedOpt.textContent.replace('👥 ', '').replace('⚡ ', '').trim();
                    }
                });

                // جلب الجروبات تلقائياً عند الدخول على تاب التذكيرات لأول مرة
                const remindersTabBtn = document.getElementById('reminders-tab');
                if (remindersTabBtn) {
                    remindersTabBtn.addEventListener('shown.bs.tab', () => {
                        if (reminderGroupSelect.options.length <= 2 && !refreshGroupsBtn.disabled) {
                            refreshGroupsBtn.click();
                        }
                    });
                }
            }

            if (checkReminderGroupBtn && checkReminderGroupResult) {
                checkReminderGroupBtn.addEventListener('click', async () => {
                    checkReminderGroupBtn.disabled = true;
                    checkReminderGroupBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> جاري الفحص...';
                    checkReminderGroupResult.style.display = 'none';

                    try {
                        const res = await fetch('/dashboard/settings/check-reminder-group');
                        const data = await res.json();
                        checkReminderGroupResult.style.display = 'block';

                        if (data.status === 'found') {
                            checkReminderGroupResult.className = 'mt-3 small p-3 rounded-3 bg-success bg-opacity-10 text-success border border-success';
                            checkReminderGroupResult.innerHTML = `<div class="d-flex align-items-center fw-bold"><i class="bi bi-check-circle-fill fs-5 me-2"></i> ${data.message}</div>`;
                        } else if (data.status === 'disconnected') {
                            checkReminderGroupResult.className = 'mt-3 small p-3 rounded-3 bg-danger text-white';
                            checkReminderGroupResult.innerHTML = `<i class="bi bi-x-circle me-1"></i> ${data.message}`;
                        } else {
                            checkReminderGroupResult.className = 'mt-3 small p-3 rounded-3 bg-warning text-dark border border-warning';
                            checkReminderGroupResult.innerHTML = `<i class="bi bi-exclamation-triangle me-1"></i> ${data.message}`;
                        }
                    } catch (e) {
                        checkReminderGroupResult.style.display = 'block';
                        checkReminderGroupResult.className = 'mt-3 small p-3 rounded-3 bg-danger text-white';
                        checkReminderGroupResult.innerHTML = 'حدث خطأ أثناء الفحص: ' + e.message;
                    } finally {
                        checkReminderGroupBtn.disabled = false;
                        checkReminderGroupBtn.innerHTML = '<i class="bi bi-search me-1"></i> فحص حالة جروب التذكيرات';
                    }
                });
            }

            // --- فحص وجلب جروبات تقارير الإعلانات ---
            const refreshAdsReportGroupsBtn = document.getElementById('refreshAdsReportGroupsBtn');
            const adsReportGroupSelect = document.getElementById('adsReportGroupSelect');
            const adsReportGroupName = document.getElementById('adsReportGroupName');
            const checkAdsReportGroupBtn = document.getElementById('checkAdsReportGroupBtn');
            const checkAdsReportGroupResult = document.getElementById('checkAdsReportGroupResult');

            if (refreshAdsReportGroupsBtn && adsReportGroupSelect) {
                refreshAdsReportGroupsBtn.addEventListener('click', async () => {
                    refreshAdsReportGroupsBtn.disabled = true;
                    refreshAdsReportGroupsBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> جاري الجلب...';
                    try {
                        const res = await fetch('/dashboard/settings/whatsapp-groups');
                        const data = await res.json();
                        if (data.success && data.groups) {
                            const currentVal = adsReportGroupSelect.value;
                            adsReportGroupSelect.innerHTML = '<option value="">⚡ التعرف التلقائي على أي جروب اسمه (إعلانات / تقارير الإعلانات)</option>';
                            data.groups.forEach(g => {
                                const opt = document.createElement('option');
                                opt.value = g.id;
                                opt.textContent = `👥 ${g.subject}`;
                                if (g.id === currentVal) opt.selected = true;
                                adsReportGroupSelect.appendChild(opt);
                            });
                        } else {
                            alert(data.error || 'تعذر جلب الجروبات. تأكد من اتصال بوت الواتساب.');
                        }
                    } catch (e) {
                        alert('حدث خطأ أثناء جلب الجروبات: ' + e.message);
                    } finally {
                        refreshAdsReportGroupsBtn.disabled = false;
                        refreshAdsReportGroupsBtn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i> جلب الجروبات';
                    }
                });

                adsReportGroupSelect.addEventListener('change', () => {
                    const selectedOpt = adsReportGroupSelect.options[adsReportGroupSelect.selectedIndex];
                    if (adsReportGroupName && selectedOpt) {
                        adsReportGroupName.value = selectedOpt.textContent.replace('👥 ', '').replace('⚡ ', '').trim();
                    }
                });

                // جلب الجروبات تلقائياً عند الدخول على تاب تقارير الإعلانات لأول مرة
                const adsReportsTabBtn = document.getElementById('ads-reports-tab');
                if (adsReportsTabBtn) {
                    adsReportsTabBtn.addEventListener('shown.bs.tab', () => {
                        if (adsReportGroupSelect.options.length <= 2 && !refreshAdsReportGroupsBtn.disabled) {
                            refreshAdsReportGroupsBtn.click();
                        }
                    });
                }
            }

            if (checkAdsReportGroupBtn && checkAdsReportGroupResult) {
                checkAdsReportGroupBtn.addEventListener('click', async () => {
                    checkAdsReportGroupBtn.disabled = true;
                    checkAdsReportGroupBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> جاري الفحص...';
                    checkAdsReportGroupResult.style.display = 'none';

                    try {
                        const res = await fetch('/dashboard/settings/check-ads-report-group');
                        const data = await res.json();
                        checkAdsReportGroupResult.style.display = 'block';

                        if (data.status === 'found') {
                            checkAdsReportGroupResult.className = 'mt-3 small p-3 rounded-3 bg-success bg-opacity-10 text-success border border-success';
                            checkAdsReportGroupResult.innerHTML = `<div class="d-flex align-items-center fw-bold"><i class="bi bi-check-circle-fill fs-5 me-2"></i> ${data.message}</div>`;
                        } else if (data.status === 'disconnected') {
                            checkAdsReportGroupResult.className = 'mt-3 small p-3 rounded-3 bg-danger text-white';
                            checkAdsReportGroupResult.innerHTML = `<i class="bi bi-x-circle me-1"></i> ${data.message}`;
                        } else {
                            checkAdsReportGroupResult.className = 'mt-3 small p-3 rounded-3 bg-warning text-dark border border-warning';
                            checkAdsReportGroupResult.innerHTML = `<i class="bi bi-exclamation-triangle me-1"></i> ${data.message}`;
                        }
                    } catch (e) {
                        checkAdsReportGroupResult.style.display = 'block';
                        checkAdsReportGroupResult.className = 'mt-3 small p-3 rounded-3 bg-danger text-white';
                        checkAdsReportGroupResult.innerHTML = 'حدث خطأ أثناء الفحص: ' + e.message;
                    } finally {
                        checkAdsReportGroupBtn.disabled = false;
                        checkAdsReportGroupBtn.innerHTML = '<i class="bi bi-search me-1"></i> فحص حالة جروب تقارير الإعلانات';
                    }
                });
            }

            // إدارة المشرفين المصرح لهم بالتذكيرات
            const addNewAdminBtn = document.getElementById('addNewAdminBtn');
            const newAdminNameInput = document.getElementById('newAdminNameInput');
            const newAdminPhoneInput = document.getElementById('newAdminPhoneInput');
            const newAdminAlert = document.getElementById('newAdminAlert');
            const reminderAdminsTableBody = document.getElementById('reminderAdminsTableBody');
            const adminsCountBadge = document.getElementById('adminsCountBadge');
            const reminderAuthorizedPhonesInput = document.getElementById('reminderAuthorizedPhonesInput');

            function updateAdminListUI(admins) {
                if (!reminderAdminsTableBody || !Array.isArray(admins)) return;
                
                if (adminsCountBadge) {
                    adminsCountBadge.textContent = `${admins.length} مشرفين`;
                }

                if (reminderAuthorizedPhonesInput) {
                    reminderAuthorizedPhonesInput.value = admins.map(a => a.phone).join(',');
                }

                reminderAdminsTableBody.innerHTML = '';
                admins.forEach(admin => {
                    const tr = document.createElement('tr');
                    tr.id = `admin-row-${admin.phone}`;
                    
                    const nameCol = admin.isPrimary 
                        ? `<span class="d-inline-flex align-items-center text-primary"><i class="bi bi-star-fill text-warning me-1"></i> ${admin.name}</span>`
                        : `<span class="d-inline-flex align-items-center text-dark"><i class="bi bi-person-fill text-secondary me-1"></i> ${admin.name}</span>`;
                        
                    const badgeCol = admin.isPrimary
                        ? `<span class="badge bg-warning bg-opacity-25 text-dark border border-warning px-2.5 py-1">👑 الأدمن الرئيسي</span>`
                        : `<span class="badge bg-info bg-opacity-10 text-info border border-info px-2.5 py-1">مشرف معتمد</span>`;

                    const actionCol = admin.isPrimary
                        ? `<span class="text-muted small" title="لا يمكن حذف الأدمن الرئيسي"><i class="bi bi-lock-fill text-secondary"></i> أساسي</span>`
                        : `<button type="button" class="btn btn-sm btn-outline-danger px-2.5 py-1 rounded-2" onclick="deleteReminderAdmin('${admin.phone}', '${admin.name}')" title="حذف المشرف"><i class="bi bi-trash3"></i></button>`;

                    tr.innerHTML = `
                        <td class="ps-3 fw-bold">${nameCol}</td>
                        <td><code class="fw-bold text-dark px-2 py-1 bg-light rounded font-monospace">${admin.phone}</code></td>
                        <td>${badgeCol}</td>
                        <td class="text-center pe-3">${actionCol}</td>
                    `;
                    reminderAdminsTableBody.appendChild(tr);
                });
            }

            if (addNewAdminBtn) {
                addNewAdminBtn.addEventListener('click', async () => {
                    const name = (newAdminNameInput.value || '').trim();
                    const phone = (newAdminPhoneInput.value || '').trim();

                    if (!phone) {
                        newAdminAlert.style.display = 'block';
                        newAdminAlert.className = 'mt-2 small text-danger fw-bold';
                        newAdminAlert.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i> يرجى إدخال رقم الهاتف أولاً.';
                        return;
                    }

                    addNewAdminBtn.disabled = true;
                    addNewAdminBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> جاري الإضافة...';
                    newAdminAlert.style.display = 'none';

                    try {
                        const res = await fetch('/dashboard/settings/reminder-admins/add', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ name, phone })
                        });
                        const data = await res.json();

                        if (data.success) {
                            newAdminAlert.style.display = 'block';
                            newAdminAlert.className = 'mt-2 small text-success fw-bold';
                            newAdminAlert.innerHTML = `<i class="bi bi-check-circle me-1"></i> ${data.message}`;
                            newAdminNameInput.value = '';
                            newAdminPhoneInput.value = '';
                            if (data.admins) updateAdminListUI(data.admins);
                            setTimeout(() => { newAdminAlert.style.display = 'none'; }, 4000);
                        } else {
                            newAdminAlert.style.display = 'block';
                            newAdminAlert.className = 'mt-2 small text-danger fw-bold';
                            newAdminAlert.innerHTML = `<i class="bi bi-exclamation-circle me-1"></i> ${data.error || 'تعذر إضافة المشرف'}`;
                        }
                    } catch (e) {
                        newAdminAlert.style.display = 'block';
                        newAdminAlert.className = 'mt-2 small text-danger fw-bold';
                        newAdminAlert.innerHTML = 'حدث خطأ: ' + e.message;
                    } finally {
                        addNewAdminBtn.disabled = false;
                        addNewAdminBtn.innerHTML = '<i class="bi bi-plus-lg me-1"></i> إضافة';
                    }
                });
            }

            window.deleteReminderAdmin = async function(phone, name) {
                if (!confirm(`هل أنت متأكد من حذف المشرف "${name}" (${phone}) من قائمة المشرفين المصرح لهم؟`)) {
                    return;
                }

                try {
                    const res = await fetch('/dashboard/settings/reminder-admins/delete', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ phone })
                    });
                    const data = await res.json();
                    if (data.success) {
                        if (data.admins) {
                            updateAdminListUI(data.admins);
                        } else {
                            const row = document.getElementById(`admin-row-${phone}`);
                            if (row) row.remove();
                        }
                    } else {
                        alert(data.error || 'تعذر حذف المشرف');
                    }
                } catch (e) {
                    alert('حدث خطأ أثناء الحذف: ' + e.message);
                }
            };
        });
    </script>
</body>

</html>