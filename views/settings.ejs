                                                        "الجمعة": { enabled: false, start: "10:00", end: "23:00" }
                                                    };
                                                    const currentSchedule = (typeof settings.working_hours_schedule === 'object' && settings.working_hours_schedule) ? settings.working_hours_schedule : defaultSchedule;
                                                    const daysOfWeek = ['السبت', 'الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة'];
                                                    daysOfWeek.forEach(day => {
                                                        const dayData = currentSchedule[day] || defaultSchedule[day] || { enabled: true, start: '10:00', end: '23:00' };
                                                        const isDayEnabled = dayData.enabled === true || dayData.enabled === 'true';
                                                    %>
                                                    <tr class="border-bottom">
                                                        <td><strong class="text-dark"><%= day %></strong></td>
                                                        <td>
                                                            <div class="form-check form-switch m-0">
