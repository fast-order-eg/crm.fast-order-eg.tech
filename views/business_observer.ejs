            };

            try {
                const res = await fetch('/dashboard/business-observer/groups', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });
                const data = await res.json();
                if (data.success) {
                    const modalEl = document.getElementById('addGroupModal');
                    const modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) modalInstance.hide();
                    fetchGroups(1, false);
                } else {
                    alert(data.message || 'حدث خطأ');
                }
            } catch (_) { alert('خطأ في الاتصال'); }
        });

        document.getElementById('btnRefreshFeed').addEventListener('click', loadMessagesFeed);
        document.getElementById('feedSearch').addEventListener('input', () => {
            clearTimeout(window.searchTimeout);
            window.searchTimeout = setTimeout(loadMessagesFeed, 400);
        });
        document.getElementById('feedTypeFilter').addEventListener('change', loadMessagesFeed);

        // تحميل مبدئي
        loadMessagesFeed();
    </script>
</body>
</html>
