                phoneCompact.innerText = '';
                desc.innerText = 'جاري مزامنة وربط جلسة المراقب الصامت...';
                btnDisconnect.classList.add('d-none');
                btnQuickDisconnect.classList.add('d-none');
            } else {
                dot.className = 'd-flex align-items-center justify-content-center rounded-circle bg-secondary text-white';
                dotIcon.className = 'bi bi-power';
                titleCompact.innerText = 'المراقب غير متصل ⚪';
                phoneCompact.innerText = '';
                desc.innerText = 'قم بربط رقم المراقبة بكود الربط (Pairing Code) أو بمسح الـ QR للبدء في الرصد التلقائي.';
