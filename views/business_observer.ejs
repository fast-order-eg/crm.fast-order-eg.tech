                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">لم يتم إضافة موظفين بعد. اضغط على "إضافة موظف جديد".</td>
                                    </tr>
                                <% } else { %>
                                    <% 
                                    const avatarPalette = ['#4f46e5', '#0891b2', '#059669', '#d97706', '#dc2626', '#7c3aed'];
                                    employees.forEach((emp, idx) => { 
                                        let badgeCls = 'rating-badge-high';
                                        if (emp.rating) {
                                            if (emp.rating.includes('10/10') || emp.rating.includes('9.')) badgeCls = 'rating-badge-top';
                                            else if (emp.rating.includes('8.')) badgeCls = 'rating-badge-high';
                                            else if (emp.rating.includes('قيد')) badgeCls = 'rating-badge-wait';
                                            else badgeCls = 'rating-badge-mid';
                                        }
                                    %>
                                        <tr id="emp-row-<%= emp.id %>">
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="emp-avatar" style="background-color: <%= avatarPalette[idx % avatarPalette.length] %>;">
                                                        <%= emp.name ? emp.name.trim().charAt(0) : 'م' %>
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold text-dark"><%= emp.name %></div>
                                                        <div class="font-monospace text-primary small" dir="ltr"><%= emp.phone %></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="tag-role fw-bold d-inline-block mb-1"><%= emp.role || 'موظف' %></span>
                                                <% if (emp.notes) { %>
                                                    <div class="text-muted small" style="font-size: 0.77rem; line-height: 1.45;"><%= emp.notes %></div>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (emp.rating) { %>
                                                    <span class="rating-badge <%= badgeCls %>">
                                                        <%= emp.rating %>
                                                    </span>
                                                <% } else { %>
                                                    <span class="badge bg-light text-muted border">قيد التقييم</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (emp.evaluation) { %>
                                                    <div class="eval-text-card">
                                                        <i class="bi bi-chat-left-quote-fill text-primary me-1"></i>
                                                        <%= emp.evaluation %>
                                                    </div>
                                                <% } else { %>
                                                    <span class="text-muted small fst-italic">قيد التحليل والرصد...</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (emp.evidence) { %>
                                                    <div class="evidence-text-card">
                                                        <i class="bi bi-shield-check text-success me-1"></i>
                                                        <%= emp.evidence %>
                                                    </div>
                                                <% } else { %>
                                                    <span class="text-muted small fst-italic">لا توجد شواهد مسجلة بعد</span>
                                                <% } %>
                                            </td>
                                            <td class="text-end">
                                                <div class="d-flex align-items-center justify-content-end gap-1">
                                                    <button class="btn btn-sm btn-outline-primary rounded-3" title="تعديل التقييم والبيانات" onclick="openEditEmployeeModal(<%= JSON.stringify(emp).replace(/"/g, '&quot;') %>)">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger rounded-3" title="حذف الموظف" onclick="deleteEmployee(<%= emp.id %>)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- 4. Daily Evaluations & Monthly Average Pane -->
            <div class="tab-pane fade" id="daily-eval-pane" role="tabpanel">
                <div class="glass-card p-3 p-md-4">
                    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                        <div>
                            <h5 class="fw-bold mb-1"><i class="bi bi-calendar2-check-fill text-primary me-2"></i>تقييمات الموظفين اليومية</h5>
                            <p class="text-muted small mb-0" style="font-size: 0.78rem;">جدولة آلية يومية الساعة 02:00 بعد منتصف الليل بنهاية الشفتات، مع توثيق الأدلة والشواهد الحقيقية.</p>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" id="btnTriggerEval" onclick="triggerEvaluationNow()">
                                <i class="bi bi-arrow-repeat me-1"></i> تحديث تقييم اليوم الآن
                            </button>
                        </div>
                    </div>

                    <% 
                    const evals = (typeof dailyEvaluations !== 'undefined') ? dailyEvaluations : [];
                    
                    // Group evaluations by Date
                    const evalsByDate = {};
                    evals.forEach(ev => {
                        const d = ev.evaluationDate || 'غير محدد';
                        if (!evalsByDate[d]) evalsByDate[d] = [];
                        evalsByDate[d].push(ev);
                    });
                    const sortedDates = Object.keys(evalsByDate).sort().reverse();

                    // Arabic Day Name Formatter
                    function formatArabicDay(dateStr) {
                        try {
                            const d = new Date(dateStr + 'T12:00:00Z');
                            const dayNames = ['الأحد', 'الاثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'];
                            const months = ['يناير', 'فبراير', 'مارس', 'أبريل', 'مايو', 'يونيو', 'يوليو', 'أغسطس', 'سبتمبر', 'أكتوبر', 'نوفمبر', 'ديسمبر'];
                            return dayNames[d.getUTCDay()] + ' ' + d.getUTCDate() + ' ' + months[d.getUTCMonth()] + ' ' + d.getUTCFullYear();
                        } catch(_) {
                            return dateStr;
                        }
                    }
                    %>

                    <% if (sortedDates.length === 0) { %>
                        <div class="p-4 text-center text-muted border rounded-3 bg-light">
                            <i class="bi bi-calendar-x fs-2 d-block mb-2 text-secondary"></i>
                            لا توجد تقييمات مسجلة بعد. يتم إصدار التقييم تلقائياً يومياً الساعة 2:00 بعد منتصف الليل.
                        </div>
                    <% } else { %>
                        <div class="accordion d-flex flex-column gap-3" id="evalAccordion">
                            <% sortedDates.forEach((dateKey, idx) => { 
                                const dayList = evalsByDate[dateKey];
                                const dayAvg = (dayList.reduce((acc, c) => acc + parseFloat(c.ratingScore || 0), 0) / dayList.length).toFixed(1);
                                const isFirst = (idx === 0);
                            %>
                                <div class="accordion-item border rounded-3 overflow-hidden shadow-sm">
                                    <h2 class="accordion-header" id="heading-<%= dateKey %>">
                                        <button class="accordion-button <%= isFirst ? '' : 'collapsed' %> py-2.5 px-3 bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-<%= dateKey %>" aria-expanded="<%= isFirst ? 'true' : 'false' %>">
                                            <div class="d-flex align-items-center justify-content-between w-100 me-2 flex-wrap gap-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi bi-calendar-check text-primary"></i>
                                                    <span class="fw-bold text-dark fs-6"><%= formatArabicDay(dateKey) %></span>
                                                    <span class="badge bg-white text-secondary border font-monospace" style="font-size: 0.72rem;"><%= dateKey %></span>
                                                </div>
                                                <div class="d-flex align-items-center gap-2 ms-auto">
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1">
                                                        متوسط اليوم: ⭐ <%= dayAvg %> / 10
                                                    </span>
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1" style="font-size: 0.72rem;">
                                                        <%= dayList.length %> موظفين
                                                    </span>
                                                </div>
                                            </div>
                                        </button>
                                    </h2>
                                    <div id="collapse-<%= dateKey %>" class="accordion-collapse collapse <%= isFirst ? 'show' : '' %>" data-bs-parent="#evalAccordion">
                                        <div class="accordion-body p-0">
                                            <div class="table-responsive">
                                                <table class="table table-hover align-middle mb-0">
                                                    <thead class="table-light small">
                                                        <tr>
                                                            <th style="min-width: 140px;">الموظف والتقييم</th>
                                                            <th style="min-width: 260px;">الميزات ونقاط القوة (بالتوقيت)</th>
                                                            <th style="min-width: 240px;">العيوب ونقاط التحسين (بالتوقيت)</th>
                                                            <th style="min-width: 270px;">الشواهد الميدانية والأدلة الحية</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% dayList.forEach(ev => { %>
                                                            <tr>
                                                                <td style="vertical-align: top;">
                                                                    <div class="fw-bold text-dark fs-6"><%= ev.employeeName %></div>
                                                                    <div class="small text-muted font-monospace mt-1" style="font-size: 0.75rem;">
                                                                        <i class="bi bi-chat-dots text-secondary me-1"></i><%= ev.totalMessages %> رسائل
                                                                    </div>
                                                                    <div class="mt-1.5">
                                                                        <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace px-2 py-1" style="font-size: 0.78rem;">
                                                                            ⭐ <%= ev.ratingScore %> / 10
                                                                        </span>
                                                                    </div>
                                                                    <div class="small text-secondary mt-1 fw-semibold" style="font-size: 0.72rem; line-height: 1.3;">
                                                                        <%= ev.ratingLabel %>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="eval-text-card" style="border-right-color: #10b981; background: #f0fdf4;">
                                                                        <i class="bi bi-hand-thumbs-up-fill text-success me-1"></i>
                                                                        <span style="white-space: pre-line;"><%= ev.pros || '—' %></span>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="eval-text-card" style="border-right-color: #f59e0b; background: #fffbeb;">
                                                                        <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
                                                                        <span style="white-space: pre-line;"><%= ev.cons || 'لا توجد ملاحظات سلبية' %></span>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="evidence-text-card">
                                                                        <i class="bi bi-shield-check text-primary me-1"></i>
                                                                        <span style="white-space: pre-line;"><%= ev.evidence || '—' %></span>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        <% }); %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

