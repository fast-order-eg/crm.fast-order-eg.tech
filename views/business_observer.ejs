        function updateStatusUI(data) {
            const dot = document.getElementById('statusBadgeDot');
            const dotIcon = document.getElementById('statusDotIcon');
            const titleCompact = document.getElementById('statusTitleCompact');
            const phoneCompact = document.getElementById('statusPhoneCompact');
            const desc = document.getElementById('statusDesc');
            const btnDisconnect = document.getElementById('btnDisconnect');
            const btnQuickDisconnect = document.getElementById('btnQuickDisconnect');
            const qrContainer = document.getElementById('qrBoxContainer');

            if (data.status === 'connected') {
                dot.className = 'd-flex align-items-center justify-content-center rounded-circle bg-success text-white';
                dotIcon.className = 'bi bi-whatsapp';
                titleCompact.innerText = 'المراقب متصل ونشط 🟢';
                phoneCompact.innerText = `(+${data.phone} ${data.name ? '- ' + data.name : ''})`;
                desc.innerHTML = `جلسة المراقب متصلة برقم <strong>+${data.phone}</strong> (${data.name || ''}). يرصد الرسائل تلقائياً في الخلفية.`;
                btnDisconnect.classList.remove('d-none');
                btnQuickDisconnect.classList.remove('d-none');
                qrContainer.classList.add('d-none');
            } else if (data.status === 'connecting') {
                dot.className = 'd-flex align-items-center justify-content-center rounded-circle bg-warning text-dark';
                dotIcon.className = 'bi bi-arrow-repeat';
