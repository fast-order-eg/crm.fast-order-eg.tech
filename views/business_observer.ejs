            if (data && data.qr) {
                const qrContainer = document.getElementById('qrBoxContainer');
                const canvas = document.getElementById('qrCanvas');
                qrContainer.classList.remove('d-none');
                QRCode.toCanvas(canvas, data.qr, { width: 220, margin: 2 });
            }
        });

        socket.on('observer_pairing_code', (data) => {
            if (data && data.code) {
                const resultBox = document.getElementById('pairingResultBox');
                const codeText = document.getElementById('pairingCodeText');
                resultBox.classList.remove('d-none');
                codeText.innerText = data.code;
            }
        });

        socket.on('observer_new_message', (msg) => {
            prependMessageToFeed(msg);
            incrementStat('statTotal');
            incrementStat('statToday');
            if (msg.messageType === 'audio') incrementStat('statVoice');
        });

        // تحديث لحظي للتفاعلات والإيموجي
        socket.on('observer_message_reaction', (data) => {
            const rxBox = document.getElementById('reactions-' + data.messageId) || document.getElementById('reactions-' + data.id);
            if (rxBox && Array.isArray(data.reactions)) {
                if (data.reactions.length === 0) {
                    rxBox.innerHTML = '';
                } else {
                    rxBox.innerHTML = `<div class="msg-reactions mt-2 d-flex flex-wrap gap-1">` +
                        data.reactions.map(r => `
                            <span class="badge bg-light border text-dark rounded-pill px-2 py-1 shadow-xs" title="${r.senderName || r.senderPhone}">
                                <span class="fs-6 me-1">${r.emoji}</span>
                                <span class="text-secondary small" style="font-size: 0.72rem;">${r.senderName || r.senderPhone || ''}</span>
                            </span>
                        `).join('') +
                    `</div>`;
                }
            }
        });

        function incrementStat(id) {
            const el = document.getElementById(id);
            if (el) {
                const cur = parseInt(el.innerText || '0', 10);
                el.innerText = cur + 1;
            }
