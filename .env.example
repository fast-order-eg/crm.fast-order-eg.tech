# Server Configuration
PORT=3000

# Database Configuration
# Set DB_DIALECT to 'sqlite' for local SQLite, or 'mysql' for MySQL (XAMPP/Production)
DB_DIALECT=sqlite
DB_STORAGE=database.sqlite

# MySQL Database Configuration (Used only if DB_DIALECT=mysql)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=lina_whatsapp_db

# Secret for session encryption (change this in production)
SESSION_SECRET=super_secret_session_key_change_me

# Facebook OAuth
FB_APP_ID=your_fb_app_id
FB_APP_SECRET=your_fb_app_secret
FB_REDIRECT_URI=http://localhost:3000/auth/facebook/messenger/callback

# Google Vertex AI
GOOGLE_APPLICATION_CREDENTIALS="trim-bot-486500-h8-4b614b18f7c0.json"
VERTEX_USER_KEY="your_vertex_user_key"
VERTEX_PROJECT_ID="your_vertex_project_id"
INTERNAL_API_KEY="lina_secret_api_key_2026"

# Follow-up Settings (defaults, can be overridden in SystemSettings)
NO_ACTION_TIMEOUT_MINUTES=10
FIRST_FOLLOWUP_DELAY_HOURS=24
FINAL_FOLLOWUP_DELAY_DAYS=3
